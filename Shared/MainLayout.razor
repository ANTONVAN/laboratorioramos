@inherits LayoutComponentBase
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoExpediente
@using LaboratorioRamos.Data.DtoExpediente.DtoRequestExpedientes
@using LaboratorioRamos.Data.DtoMedico.DtoRequestMedicoPacientes
@using LaboratorioRamos.Data.DtoMedico.DtoResponseMedicoPaciente

@using LaboratorioRamos.Helper
@inject LoginReturnUrlStore LoginReturnStore
@inject AuthenticationStateProvider _authStateProvider;
@inject IHttpContextAccessor httpContextAccessor;
@inject Cryp Cryp;
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <SessionTimeoutWatcher />
    <MudAppBar Elevation="3" Fixed="true" Style="z-index: 1300;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="@((e) => ToggleDrawer())"
                       Style="color: rgba(255,255,255,0.9);" />
        
        <div style="margin-left: 15px; cursor: pointer;" 
             @onclick="@(() => NavigationManager.NavigateTo("/"))"
             class="d-none d-sm-block">
            <MudImage Src="images/labramos.png" 
                      Alt="Laboratorio Ramos" 
                      Width="180" 
                      Height="60" />
        </div>
        
        <div style="margin-left: 8px; cursor: pointer;" 
             @onclick="@(() => NavigationManager.NavigateTo("/"))"
             class="d-block d-sm-none">
            <MudImage Src="images/labramos.png" 
                      Alt="Laboratorio Ramos" 
                      Width="120" 
                      Height="40" />
        </div>
        
        <MudSpacer />
        
        <!-- Encuestas de Satisfacción - Desktop -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="d-none d-md-flex" Style="margin-right: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.RateReview" 
                     Size="Size.Medium" 
                     Style="color: rgba(255,255,255,0.95);" />
            <MudStack Spacing="0" Style="min-width: 200px;">
                <MudText Typo="Typo.caption" 
                         Style="color: rgb(13 55 168); font-size: 0.7rem; line-height: 1.2; margin-bottom: 2px; white-space: nowrap;">
                    Encuestas de Satisfacción
                </MudText>
                <MudSelect @bind-Value="selectedSurvey" 
                           @bind-Value:after="HandleSurveyChangeAfter"
                           Variant="Variant.Outlined" 
                           Dense="true" 
                           Style="min-width: 180px; max-width: 200px; background-color: rgba(255,255,255,0.98);"
                           Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomCenter"
                           TransformOrigin="Origin.TopCenter">
                    <MudSelectItem Value="@SurveyOption.None">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                            <MudText Typo="Typo.body2">Seleccionar...</MudText>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value="@SurveyOption.Monterrey">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Monterrey</MudText>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value="@SurveyOption.Sonora">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">Sonora</MudText>
                        </MudStack>
                    </MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudStack>
        
        <!-- Encuestas de Satisfacción - Mobile/Tablet -->
        <MudMenu @bind-Open="@surveyMenuOpen" 
                 AnchorOrigin="Origin.BottomRight" 
                 TransformOrigin="Origin.TopRight" 
                 Class="d-flex d-md-none"
                 Style="margin-right: 8px;">
            <ActivatorContent>
                <MudIconButton Icon="@Icons.Material.Filled.RateReview" 
                               Color="Color.Inherit" 
                               Size="Size.Medium"
                               Variant="Variant.Text"
                               Edge="Edge.End"
                               Style="color: rgba(255,255,255,0.9);" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => HandleSurveyMenuItem(SurveyOption.Monterrey))">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">Monterrey</MudText>
                    </MudStack>
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => HandleSurveyMenuItem(SurveyOption.Sonora))">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">Sonora</MudText>
                    </MudStack>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
        
        <MudSpacer />
        
        <!-- Nombre de Usuario -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="d-none d-sm-flex" Style="margin-right: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.Person" 
                     Size="Size.Small" 
                     Style="color: rgba(255,255,255,0.9);" />
            <MudText Typo="Typo.body1" 
                     Style="white-space: nowrap; font-weight: 500; color: rgb(13 55 168);">
                Hola, @NombreUsuario
            </MudText>
        </MudStack>
        
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="d-flex d-sm-none" Style="margin-right: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.Person" 
                     Size="Size.Small" 
                     Style="color: rgba(255,255,255,0.9);" />
            <MudText Typo="Typo.body2" 
                     Style="white-space: nowrap; font-weight: 500; color: rgb(13 55 168); max-width: 100px; overflow: hidden; text-overflow: ellipsis;">
                @NombreUsuario
            </MudText>
        </MudStack>
    </MudAppBar>

    <MudDrawerContainer Class="mud-height-full" Style="padding-top: var(--mud-appbar-height, 64px); min-height: calc(100vh - var(--mud-appbar-height, 64px));">
        <MudDrawer @bind-Open="@_open" 
                   Fixed="true" 
                   Elevation="3" 
                   Variant="DrawerVariant.Mini" 
                   OpenMiniOnHover="true" 
                   Breakpoint="Breakpoint.Md" 
                   PreserveOpenState="true"
                   ClipMode="DrawerClipMode.Always"
                   Style="background: #707070; color: white;">
            <MudNavMenu Dense="true" Rounded="true">
                @switch (TypeUser)
                {
                    case 1:
                        <MudNavLink Href="ConsultaResultadosPaciente/1/0" 
                                   Match="NavLinkMatch.All" 
                                   Icon="@Icons.Material.Filled.Badge" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Consulta de Resultados
                        </MudNavLink>
                        <MudNavLink Href="ConsultaGraficaPaciente/1/0" 
                                   Match="NavLinkMatch.All" 
                                   Icon="@Icons.Material.Filled.StackedBarChart" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Gráficas..
                        </MudNavLink>
                        break;
                    case 2:
                        <MudNavLink Href="ConsultaExpedientesMedico/" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.PersonSearch" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Expedientes
                        </MudNavLink>
                        <MudNavLink Href="ConsultaSolicitudes/2" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.PersonSearch" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Solicitudes
                        </MudNavLink>
                        <MudNavLink Href="CreaOrden/2" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.NoteAdd" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Crear Orden
                        </MudNavLink>
                        break;
                    case 3:
                        <MudNavLink Href="ConsultaExpedientesEmpresa" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.PersonSearch" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Pacientes
                        </MudNavLink>
                        <MudNavLink Href="ConsultaSolicitudes/3" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.PersonSearch" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Solicitudes
                        </MudNavLink>
                        <MudNavLink Href="CreaOrden/3" 
                                   Match="NavLinkMatch.Prefix" 
                                   Icon="@Icons.Material.Filled.NoteAdd" 
                                   IconColor="Color.Inherit"
                                   OnClick="@HandleNavLinkClick">
                            Crear Orden
                        </MudNavLink>
                        break;
                }

                <MudNavLink OnClick="@(() => NavigateToExit())" 
                           Match="NavLinkMatch.Prefix" 
                           Icon="@Icons.Material.Filled.Logout" 
                           IconColor="Color.Inherit">
                    Salir
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent Style="padding: 0; min-height: calc(100vh - var(--mud-appbar-height, 64px));">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mud-height-full" Style="padding: 16px; padding-top: 16px; width: 100%;">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudDrawerContainer>
    
    @* <MudDrawer Open="_drawerOpen" 
               MiniVariant="_drawerMiniMode" 
               ClipMode="DrawerClipMode.Always" 
               Elevation="2" 
               Style="background: #707070;color: white;" 
               Overlay="false" 
               Variant="@DrawerVariant.Persistent">
        <MudDrawerHeader>
            <div style="padding: 10px; text-align: center;">
                <!-- Header vacío en modo expandido -->
            </div>
        </MudDrawerHeader>
        <NavMenu MiniMode="_drawerMiniMode" />
    </MudDrawer> *@
    
    @* <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent> *@
</MudLayout>

@code {
    #region Declaración de variables   

    private bool _open = true;

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private void HandleNavLinkClick()
    {
        // Cerrar el drawer en dispositivos móviles después de hacer clic en un enlace
        // MudBlazor maneja esto automáticamente con Breakpoint.Md, pero esto asegura el cierre
        // En pantallas pequeñas (< md), el drawer se cierra automáticamente
        // Este método proporciona un cierre adicional para mejor UX
        StateHasChanged();
    }
    
    private int TypeUser = 0;
    private string NombreUsuario = "";

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
    };

    // Encuestas de Satisfacción
    private SurveyOption selectedSurvey = SurveyOption.None;
    private bool surveyMenuOpen = false;

    private enum SurveyOption
    {
        None,
        Monterrey,
        Sonora
    }

    private readonly Dictionary<SurveyOption, string> surveyUrls = new()
    {
        { SurveyOption.Monterrey, "https://docs.google.com/forms/d/e/1FAIpQLSdCYId5cr0g85C_f9zDxxErNJwjO4yDGOU6FQ5xE8O6EEUaxg/viewform" },
        { SurveyOption.Sonora, "https://docs.google.com/SeZoFyRuQOhxzcdOjzZnbxhvaV0cJxqKgGVWRmrnbkv911rpg/viewform" }
    };
    #endregion

    private async Task HandleSurveyChangeAfter()
    {
        if (selectedSurvey != SurveyOption.None && surveyUrls.ContainsKey(selectedSurvey))
        {
            var url = surveyUrls[selectedSurvey];
            // Abrir en nueva pestaña usando JavaScript
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            // Resetear el select después de abrir el link
            await Task.Delay(100);
            selectedSurvey = SurveyOption.None;
            StateHasChanged();
        }
    }

    private async Task HandleSurveyMenuItem(SurveyOption option)
    {
        surveyMenuOpen = false;
        selectedSurvey = option;
        if (surveyUrls.ContainsKey(option))
        {
            var url = surveyUrls[option];
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            await LoginReturnStore.SavePendingReturnFromFullUriAsync(NavigationManager.Uri);
            NavigationManager.NavigateTo(LoginRedirectHelper.GetLoginPathFromFullUri(NavigationManager.Uri), forceLoad: true);
            return;
        }

        var idenUser = authState.User.Claims.ToList();
        if (idenUser.Count < 3)
        {
            await LoginReturnStore.SavePendingReturnFromFullUriAsync(NavigationManager.Uri);
            NavigationManager.NavigateTo(LoginRedirectHelper.GetLoginPathFromFullUri(NavigationManager.Uri), forceLoad: true);
            return;
        }

        TypeUser = int.Parse(idenUser[2].Value);
        var resDecrip = Cryp.Desencripta(idenUser[0].Value.ToString());
        if (TypeUser == 1) //Paciente
        {
            List<DtoPaciente> dtoPaciente = JsonConvert.DeserializeObject<List<DtoPaciente>>(resDecrip);
            NombreUsuario = dtoPaciente[0].NombrePaciente;
        }
        else if (TypeUser == 2)//Medico
        {
            DtoResponseMedicoPaciente dtoMedicoPaciente = JsonConvert.DeserializeObject<DtoResponseMedicoPaciente>(resDecrip);
            NombreUsuario = dtoMedicoPaciente.Nombre;
        }
        else if (TypeUser == 3)//Compañia
        {
            DtoResponseMedicoPaciente dtoMedicoPaciente = JsonConvert.DeserializeObject<DtoResponseMedicoPaciente>(resDecrip);
            NombreUsuario = dtoMedicoPaciente.Nombre;
        }
        StateHasChanged();
    }

    private async void NavigateToExit()
    {
        var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
        await cusAuthStateProvider.UpdAuthenticationState(null);
        NavigationManager.NavigateTo("/");
    }
}