@inject AuthenticationStateProvider _authStateProvider;
@inject NavigationManager NavigationManager


<MudNavMenu Dense="true">
    @switch (TypeUser)
    {
        case 1:
            <MudNavLink Href="ConsultaResultadosPaciente/1/0" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">Consulta de Resultados</MudNavLink>
            <MudNavLink Href="ConsultaGraficaPaciente/1/0" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.StackedBarChart">Gráficas</MudNavLink>
            break;
        case 2:
            <MudNavLink Href="ConsultaExpedientesMedico/" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">Consulta de Expedientes</MudNavLink>
            <MudNavLink Href="ConsultaSolicitudes/2" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">Consulta de Solicitudes</MudNavLink>
            <MudNavLink Href="CreaOrden/2" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAdd">Crear Orden</MudNavLink>
            
            break;
        case 3:
            <MudNavLink Href="ConsultaExpedientesEmpresa" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">Pacientes</MudNavLink>
            <MudNavLink Href="ConsultaSolicitudes/3" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">Consulta de Solicitudes</MudNavLink>
            <MudNavLink Href="CreaOrden/3" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAdd">Crear Orden</MudNavLink>
            @* <MudNavLink Href="ConsultaResultadosPacientesEmpresa" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">Consulta de Resultados</MudNavLink> *@
            break;
    }
    
    <MudNavLink OnClick="@(()=> NavigateToExit())" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout" >Salir</MudNavLink>
    
</MudNavMenu>


@code {

    #region Declaración de variables
    private int TypeUser = 0;

    #endregion

    #region Fusiones Página

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var idenUser = authState.User.Claims.ToList();
        TypeUser = int.Parse(idenUser[2].Value);

    }

    private async void NavigateToExit()
    {
        var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
        await cusAuthStateProvider.UpdAuthenticationState(null);
        NavigationManager.NavigateTo("/");
    }
    #endregion



}