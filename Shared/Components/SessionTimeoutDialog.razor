@using MudBlazor
@using Microsoft.AspNetCore.Components

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color" 
                   Variant="Variant.Filled" 
                   OnClick="OnContinue" 
                   StartIcon="@Icons.Material.Filled.Timer">
            @ButtonText
        </MudButton>
        <MudButton Color="Color.Secondary" 
                   Variant="Variant.Outlined" 
                   OnClick="OnCancel" 
                   StartIcon="@Icons.Material.Filled.ExitToApp">
            Cerrar sesión
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IDialogReference? MudDialog { get; set; }

    [Parameter] public string ContentText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Continuar sesión";
    [Parameter] public Color Color { get; set; } = Color.Warning;

    private void OnContinue()
    {
        try
        {
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            // Log error if needed
            Console.WriteLine($"Error closing dialog: {ex.Message}");
        }
    }

    private void OnCancel()
    {
        try
        {
            MudDialog?.Close(DialogResult.Cancel());
        }
        catch (Exception ex)
        {
            // Log error if needed
            Console.WriteLine($"Error canceling dialog: {ex.Message}");
        }
    }
}

