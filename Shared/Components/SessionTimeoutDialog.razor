@using MudBlazor
@using Microsoft.AspNetCore.Components

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="OnContinue" StartIcon="@Icons.Material.Filled.Timer">@ButtonText</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="OnCancel" StartIcon="@Icons.Material.Filled.ExitToApp">Cerrar sesión</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IDialogReference MudDialog { get; set; } = null!;
    
    [Parameter] public string ContentText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Continuar sesión";
    [Parameter] public Color Color { get; set; } = Color.Warning;

    private void OnContinue()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void OnCancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
}

