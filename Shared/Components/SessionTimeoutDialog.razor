@using MudBlazor
@using Microsoft.AspNetCore.Components

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color" 
                   Variant="Variant.Filled" 
                   OnClick="OnContinue" 
                   StartIcon="@Icons.Material.Filled.Timer">
            @ButtonText
        </MudButton>
        <MudButton Color="Color.Secondary" 
                   Variant="Variant.Outlined" 
                   OnClick="OnCancel" 
                   StartIcon="@Icons.Material.Filled.ExitToApp">
            Cerrar sesión
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Alternativa con eventos
    [Parameter] public EventCallback<bool> OnDialogResult { get; set; }

    [Parameter] public string ContentText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Continuar sesión";
    [Parameter] public Color Color { get; set; } = Color.Warning;

    private async Task OnContinue()
    {
        await OnDialogResult.InvokeAsync(true);
    }

    private async Task OnCancel()
    {
        await OnDialogResult.InvokeAsync(false);
    }
    
    

