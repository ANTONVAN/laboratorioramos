@using MudBlazor
@using MudBlazor.Components
@using Microsoft.AspNetCore.Components

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color" 
                   Variant="Variant.Filled" 
                   OnClick="OnContinue" 
                   StartIcon="@Icons.Material.Filled.Timer">
            @ButtonText
        </MudButton>
        <MudButton Color="Color.Secondary" 
                   Variant="Variant.Outlined" 
                   OnClick="OnCancel" 
                   StartIcon="@Icons.Material.Filled.ExitToApp">
            Cerrar sesión
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // MudBlazor provides the dialog instance via cascading parameters when shown with IDialogService.Show<T>()
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string ContentText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Continuar sesión";
    [Parameter] public Color Color { get; set; } = Color.Warning;

    private void OnContinue()
    {
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private void OnCancel()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }
}

