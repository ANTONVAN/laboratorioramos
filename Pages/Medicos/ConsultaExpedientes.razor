    private bool FilterFuncExpedientes(DtoResponseMedicoPaciente element) => FilterFunc(element, dtoFiltro.ExpedienteNombre);
    private bool FilterFunc(DtoResponseMedicoPaciente element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Nombre != null && element.Nombre.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Expediente != null && element.Expediente.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{element.EnvioCorreo} {element.Sucursal} {element.Sexo}".Contains(searchString))
            return true;
        return false;
    }

