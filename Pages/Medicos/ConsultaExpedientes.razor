@page "/ConsultaExpedientesMedico"
@using LaboratorioRamos.Data.DtoExpediente
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoFiltro
@using LaboratorioRamos.Data.DtoMedico.DtoRequestMedicoPacientes
@using LaboratorioRamos.Data.DtoMedico.DtoResponseMedicoPaciente
@using LaboratorioRamos.Data.DtoStateProvider
@inject HttpClient Http;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler

<PageTitle>Consulta de Expedientes</PageTitle>

<MudBreadcrumbs Items="_items" Class="mb-2"></MudBreadcrumbs>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <MudPaper Elevation="2" Class="pa-4 search-container mb-4">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: #0d37a8; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" Style="vertical-align: middle;" />
            Búsqueda de Expedientes
        </MudText>
        
        <EditForm Model="@dtoFiltro" OnValidSubmit="BuscaFecha">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="5">
                    <MudTextField 
                        @bind-Value="dtoFiltro.ExpedienteNombre" 
                        Disabled="@ValidateData" 
                        Label="Expediente o Nombre del paciente" 
                        Variant="Variant.Outlined"
                        Clearable="true" 
                        HelperText="Ingrese la clave de expediente o nombre del paciente" 
                        For="@(() => dtoFiltro.ExpedienteNombre)" 
                        UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" } })"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Person"
                        Class="search-field">
                    </MudTextField>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker 
                        Clearable="true" 
                        Label="Fecha Inicio" 
                        Disabled="@ValidateData" 
                        Mask="@(new DateMask("dd/MM/yyyy"))" 
                        DateFormat="dd/MM/yyyy" 
                        @bind-Date="dtoFiltro.DateInicial" 
                        PickerVariant="PickerVariant.Dialog" 
                        Color="Color.Primary" 
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense" 
                        DisableToolbar="true" 
                        AutoClose="true" 
                        Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                        Class="date-field">
                    </MudDatePicker>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker 
                        Clearable="true" 
                        Label="Fecha Final" 
                        Disabled="@ValidateData" 
                        DateFormat="dd/MM/yyyy" 
                        @bind-Date="dtoFiltro.DateFinal" 
                        PickerVariant="PickerVariant.Dialog" 
                        Color="Color.Primary" 
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense" 
                        DisableToolbar="true" 
                        AutoClose="true" 
                        Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                        Class="date-field">
                    </MudDatePicker>
                </MudItem>
                
                <MudItem xs="12" sm="12" md="1" Class="d-flex align-center" Style="padding-bottom:24px;">
                    @if (ValidateData)
                    {
                        <MudButton 
                            Disabled 
                            ButtonType="ButtonType.Button" 
                            Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            FullWidth="true"
                            Class="search-button"
                            Style="min-height: 56px;">
                            <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                        </MudButton>
                    }
                    else
                    {
                        <MudButton 
                            ButtonType="ButtonType.Submit" 
                            StartIcon="@Icons.Material.Filled.Search" 
                            Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            FullWidth="true"
                            aria-label="Buscar expedientes"
                            Class="search-button"
                            Style="min-height: 56px;">
                            Buscar
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>

    <MudPaper Elevation="2" Class="results-container">
        <MudTable 
            @ref="_table" 
            Items="@dtoMedicoPaciente" 
            Breakpoint="Breakpoint.Sm" 
            Filter="new Func<DtoResponseMedicoPaciente,bool>(FilterFuncExpedientes)" 
            Dense="false" 
            Hover="true" 
            Striped="true" 
            Elevation="0" 
            Loading="@ValidateData"
            FixedHeader="true" 
            FixedFooter="false"
            Class="expedientes-table">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" Style="vertical-align: middle;" />
                    Resultados de Búsqueda
                </MudText>
                <MudSpacer />
                @if (!ValidateData && dtoMedicoPaciente != null && dtoMedicoPaciente.Any())
                {
                    <MudChip T="string"
                        Color="Color.Info" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                        @dtoMedicoPaciente.Count @(dtoMedicoPaciente.Count == 1 ? "expediente encontrado" : "expedientes encontrados")
                    </MudChip>
                }
            </ToolBarContent>
            <ColGroup>
                <col style="width: 15%;" />
                <col style="width: 45%;" />
                <col style="width: 10%;" />
                <col style="width: 20%;" />
                <col style="width: 10%;" />
            </ColGroup>
            
            <HeaderContent>
                <MudTh Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-1" Size="Size.Small" />
                    Expediente
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" Size="Size.Small" />
                    Nombre del Paciente
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Cake" Class="mr-1" Size="Size.Small" />
                    Edad
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Phone" Class="mr-1" Size="Size.Small" />
                    Teléfono
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 600; text-align: center;">
                    <MudIcon Icon="@Icons.Material.Filled.Handyman" Class="mr-1" Size="Size.Small" />
                    Acciones
                </MudTh>
            </HeaderContent>
            
            <RowTemplate>
                <MudTd DataLabel="Expediente">
                    <MudChip T="string"
                        Color="Color.Primary" 
                        Variant="Variant.Text"
                        Size="Size.Small"
                        Style="font-weight: 600;">
                        @context.Expediente
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Nombre" Style="font-weight: 500;">
                    @context.Nombre
                </MudTd>
                <MudTd DataLabel="Edad">
                    <MudText Typo="Typo.body2">@context.Edad años</MudText>
                </MudTd>
                <MudTd DataLabel="Teléfono">
                    <MudText Typo="Typo.body2">@context.Telefono</MudText>
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: center;">
                    <MudTooltip Text="@($"Ver detalles del expediente {context.Expediente}")">
                        <MudIconButton 
                            Icon="@Icons.Material.Filled.Visibility"
                            Size="Size.Medium"
                            Color="Color.Primary"
                            Variant="Variant.Text"
                            OnClick="@(() => NavigateToDetallePaciente(context))"
                            Class="action-button"
                            aria-label="@($"Ver detalles del expediente {context.Expediente}")" />
                    </MudTooltip>
                    &nbsp;
                    <MudTooltip Text="@($"Ver gráficas del paciente {context.Nombre}")">
                        <MudIconButton Icon="@Icons.Material.Filled.BarChart"
                                       Size="Size.Medium"
                                       Color="Color.Info"
                                       Variant="Variant.Text"
                                       OnClick="@(() => NavigateToGraphPaciente(context))"
                                       aria-label="@($"Ver gráficas del paciente {context.Nombre}")" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            
            <LoadingContent>
                <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 300px; padding: 3rem;">
                    <MudProgressCircular 
                        Indeterminate="true" 
                        Size="Size.Large" 
                        Color="Color.Primary"
                        Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
                        Cargando expedientes...
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #64748b;">
                        Por favor espere mientras se obtienen los resultados
                    </MudText>
                </MudContainer>
            </LoadingContent>
            
            <NoRecordsContent>
                <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 300px; padding: 3rem;">
                    <MudIcon 
                        Icon="@Icons.Material.Filled.SearchOff" 
                        Size="Size.Large" 
                        Class="mb-4" 
                        Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                    <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                        No se encontraron expedientes
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4" Align="Align.Center">
                        @if (String.IsNullOrWhiteSpace(dtoFiltro.ExpedienteNombre) && !dtoFiltro.DateInicial.HasValue && !dtoFiltro.DateFinal.HasValue)
                        {
                            <span>Utilice el formulario de búsqueda para encontrar expedientes. Puede buscar por nombre, expediente o rango de fechas.</span>
                        }
                        else
                        {
                            <span>No se encontraron resultados con los criterios de búsqueda ingresados. Intente con otros parámetros.</span>
                        }
                    </MudText>
                    @if (!String.IsNullOrWhiteSpace(dtoFiltro.ExpedienteNombre) || dtoFiltro.DateInicial.HasValue || dtoFiltro.DateFinal.HasValue)
                    {
                        <MudButton 
                            Variant="Variant.Outlined" 
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Clear"
                            OnClick="LimpiarFiltros">
                            Limpiar filtros
                        </MudButton>
                    }
                </MudContainer>
            </NoRecordsContent>
            
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>
<style>
    /* Ajustes generales de inputs */
    .mud-input-input-control {
        align-items: normal;
    }

    /* Contenedor de búsqueda */
    .search-container {
        border-radius: 8px;
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border: 1px solid #e0e0e0;
    }

    .search-field .mud-input-control,
    .date-field .mud-input-control {
        transition: all 0.3s ease;
    }

    .search-field .mud-input-control:focus-within,
    .date-field .mud-input-control:focus-within {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 55, 168, 0.15);
    }

    .search-button {
        transition: all 0.3s ease;
        border-radius: 4px;
    }

    .search-button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 55, 168, 0.3);
    }

    /* Contenedor de resultados */
    .results-container {
        border-radius: 8px;
        overflow: hidden;
    }

    /* Tabla de expedientes */
    .expedientes-table {
        border-radius: 8px;
    }

    .expedientes-table .mud-table-head {
        background-color: #f5f7fa;
    }

    .expedientes-table .mud-table-head .mud-table-cell {
        padding: 16px;
        font-weight: 600;
        border-bottom: 2px solid #e0e0e0;
    }

    .expedientes-table .mud-table-body .mud-table-row {
        transition: all 0.2s ease;
    }

    .expedientes-table .mud-table-body .mud-table-row:hover {
        background-color: #f0f4ff !important;
        transform: scale(1.01);
        box-shadow: 0 2px 8px rgba(13, 55, 168, 0.1);
    }

    .expedientes-table .mud-table-body .mud-table-cell {
        padding: 16px;
        vertical-align: middle;
    }

    /* Botones de acción */
    .action-button {
        transition: all 0.2s ease;
    }

    .action-button:hover:not(:disabled) {
        transform: scale(1.15);
        background-color: rgba(13, 55, 168, 0.1) !important;
    }

    /* Toolbar de la tabla */
    .mud-toolbar {
        padding: 16px;
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
    }

    /* Responsive mejoras */
    @@media (max-width: 960px) {
        .search-container {
            padding: 16px !important;
        }

        .expedientes-table .mud-table-body .mud-table-cell {
            padding: 12px 8px;
        }
    }

    /* Animaciones suaves */
    .mud-paper {
        transition: box-shadow 0.3s ease;
    }

    .mud-paper:hover {
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
    }

    /* Mejoras de accesibilidad */
    .action-button:focus {
        outline: 2px solid #0d37a8;
        outline-offset: 2px;
    }

    /* Estado de carga mejorado */
    .mud-table-loading {
        opacity: 0.6;
    }
</style>

