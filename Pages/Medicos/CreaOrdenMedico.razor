    private async Task CreatePdfOrder(DtoGeneralesCotizacion _dtoGeneralesCotizacion, DtoPaciente _dtoPaciente, HashSet<DtoEstudioResponsePrice> _dtoEstudioResponsePrices, DtoCotizacion _cotizacionDraft)
    {

        MemoryStream archivopdf = await _PdfGenerator.CreatePDFOrder(_dtoGeneralesCotizacion, _dtoPaciente, _dtoEstudioResponsePrices, _cotizacionDraft);
        _PdfGenerator.ViewPDFOrder(IJSRuntime, "iFrameId", new());
        try
        {

            await Task.Delay(2000);
            _PdfGenerator.ViewPDFOrder(IJSRuntime, "iFrameId", archivopdf);
        }
        catch (Exception ex)
        {
            await _PdfGenerator.ViewPDFOrder(IJSRuntime, "iFrameId", archivopdf);            
        }

        StateHasChanged();
        if (llamado==0)
        {
            llamado++;
            CreatePdfOrder(_dtoGeneralesCotizacion, _dtoPaciente, _dtoEstudioResponsePrices, _cotizacionDraft);
        }else{
            llamado = 0;
        }
        
    }

