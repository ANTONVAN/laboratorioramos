    private async Task<IEnumerable<string>> SearchCiudad(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _oSucursalByCity.Select(x=>x.Ciudad).ToList();

        return _oSucursalByCity.Select(x=>x.Ciudad).Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

