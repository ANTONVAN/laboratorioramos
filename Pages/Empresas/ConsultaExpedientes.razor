    void ShowSnack(string message, int sev)
    {
        switch (sev)
        {
            case 0:
                Snackbar.Add($"Atención: {message}", Severity.Normal);
                break;
            case 1:
                Snackbar.Add($"Atención: {message}", Severity.Info);
                break;
            case 2:
                Snackbar.Add($"Atención: {message}", Severity.Success);
                break;
            case 3:
                Snackbar.Add($"Atención: {message}", Severity.Warning);
                break;
            case 4:
                Snackbar.Add($"Atención: {message}", Severity.Error);
                break;

        }

    }

    void OnDateChange(DateTime? newDate)
    {
        if (newDate < dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!",1);
        }
        dateFinal = newDate;

    }

    #endregion

    #region Funsiones GRID
    private bool FilterFuncExpedientes(DtoResponseMedicoPaciente element) => FilterFunc(element, dtoFiltro.ExpedienteNombre);
    private bool FilterFunc(DtoResponseMedicoPaciente element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Nombre.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Expediente.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{element.EnvioCorreo} {element.Sucursal} {element.Sexo}".Contains(searchString))
            return true;
        return false;
    }

    private async Task NavigateToDetallePaciente(DtoResponseMedicoPaciente item)
    {
        var nopag = _table.CurrentPage;
        var obFilters = filorig.LstFiltro.FirstOrDefault(op => op.OriginPage.Trim().Equals("ConsultaExpedientesEmpresa"));
        if (obFilters != null)
        {
            obFilters.PageNo = nopag.ToString();
            obFilters.ExpedienteNombreSol = dtoFiltro.ExpedienteNombre.Trim();
            obFilters.DateInicial = dtoFiltro.DateInicial;
            obFilters.DateFinal = dtoFiltro.DateFinal;
            obFilters.ExistReg = true;
        }
        else
        {
            DtoFiltroLst newFilter = new()
            {
                    OriginPage = "ConsultaExpedientesEmpresa",
                PageNo = nopag.ToString(),
                    ExpedienteNombreSol = dtoFiltro.ExpedienteNombre==null? "":dtoFiltro.ExpedienteNombre.Trim(),
                    DateInicial = dtoFiltro.DateInicial,
                DateFinal = dtoFiltro.DateFinal,
                ExistReg = true
            };
            filorig.LstFiltro.Add(newFilter);
        }

        string json = JsonConvert.SerializeObject(dtoEmpresa);
        string filtro = JsonConvert.SerializeObject(filorig);
        var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
        await cusAuthStateProvider.UpdAuthenticationState(new DtoUserProvider
            {
                filtros = Cryp.Encripta(filtro),
                testsuncretr = Cryp.Encripta(json),
                Type = 3,
            });

        string json1 = JsonConvert.SerializeObject(item);
        NavigationManager.NavigateTo($"/ConsultaResultadosPaciente/3/{Cryp.Encripta(json1)}");
    }
    private void NavigateToGraphPaciente(DtoResponseMedicoPaciente item)
