        string json = JsonConvert.SerializeObject(item);
        NavigationManager.NavigateTo($"/ConsultaGraficaPaciente/3/{Cryp.Encripta(json)}");
    }

    async Task BuscaFecha()
    {
        //dataLoaded = true;
        ValidateData = true;
        if (dateFinal < dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!",1);
        }
        else if (!String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre))
        {
            ShowSnack("¡Por favor Ingresa Fecha Final!", 4);
        }
        else if (String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && !String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre))
        {
            ShowSnack("¡Por favor Ingresa Fecha Inicial", 4);
        }
        else
        {
            DtoRequestMedicoPacientes parametrobusqueda = new();
            if (String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre))
            {
                parametrobusqueda = new()
                    {
                        MedicoId = new(),
                        CompañiaId = new() { dtoEmpresa.Id },
                        Buscar = String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre) ? null : dtoFiltro.ExpedienteNombre.ToString(),
                        TipoFecha = 1,
                        Fecha = new()
                    };
            }
            else
            {
                parametrobusqueda = new()
                    {
                        MedicoId = new(),
                        CompañiaId = new() { dtoEmpresa.Id },
                        Buscar = String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre) ? null : dtoFiltro.ExpedienteNombre.ToString(),
                        TipoFecha = 1,
                        Fecha = String.IsNullOrEmpty(dtoFiltro.ExpedienteNombre) ? new() { DateTime.Parse(dtoFiltro.DateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dtoFiltro.DateFinal.ToString()).ToString("yyyy-MM-dd") } : new()
                    };
            }
            dtoMedicoPaciente.Clear();
            var sesPacientes = await Http.PostAsJsonAsync<DtoRequestMedicoPacientes>(UrlMedicoPaciente, parametrobusqueda);
            dtoMedicoPacienteDump = await sesPacientes.Content.ReadFromJsonAsync<List<DtoResponseMedicoPaciente>>();
            foreach (var item in dtoMedicoPacienteDump)
            {
                List<string> refExpe = new();
                refExpe.Add(item.ExpedienteId.ToString());
                string json = JsonConvert.SerializeObject(refExpe);
                var sesResponseExpediente = await Http.PostAsJsonAsync<List<string>>(UrlMedicoPacienteExpediente, refExpe);
                var sesExpediente = await sesResponseExpediente.Content.ReadFromJsonAsync<List<DtoResponseMedicoPacienteExpediente>>();
                item.Expediente = sesExpediente[0].Expediente;
            }

            foreach (var itemExp in dtoMedicoPacienteDump)
            {
                var rowexiste = dtoMedicoPaciente.FirstOrDefault(op => op.Expediente.Equals(itemExp.Expediente));
                if (rowexiste==null)
                {
                    dtoMedicoPaciente.Add(itemExp);
                }
            }

        }

        //dataLoaded = false;
        ValidateData = false;

        StateHasChanged();

    }

