                            {
                                MedicoId = new(),
                                CompañiaId = new() { dtoEmpresa.Id },
                                Buscar = null,
                                TipoFecha = 1,
                                Fecha = new() { DateTime.Now.ToString("yyyy-MM-dd"), DateTime.Now.ToString("yyyy-MM-dd") }
                            };
                        }
