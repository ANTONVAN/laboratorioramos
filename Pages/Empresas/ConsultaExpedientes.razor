                </MudItem>
                <MudItem xs="12" sm="8" md="3">
                    <MudText Align="Align.Center" Typo="Typo.subtitle1" Style="color: #0d37a8;">RFC: @dtoEmpresaInfo.Rfc</MudText>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    @{
                        var direcci = $"{@dtoEmpresaInfo.Calle} {@dtoEmpresaInfo.Numero} {@dtoEmpresaInfo.Colonia} {@dtoEmpresaInfo.Ciudad} {@dtoEmpresaInfo.Estado} {@dtoEmpresaInfo.CodigoPostal}";
                    }
                    <MudText Align="Align.Left" Typo="Typo.subtitle1" Style="color: #0d37a8;">Dirección: @direcci </MudText>
                </MudItem>
                <MudItem xs="12" sm="8" md="6">
                    <MudText Align="Align.Center" Typo="Typo.subtitle1" Style="color: #0d37a8;">Razon Social: @dtoEmpresaInfo.RazonSocial</MudText>
                </MudItem>
                <MudItem xs="12" sm="8" md="6">
                    <MudText Align="Align.Center" Typo="Typo.subtitle1" Style="color: #0d37a8;">Regimen Fiscal: @dtoEmpresaInfo.RegimenFiscal</MudText>
                </MudItem>
                
                </MudGrid>
        </MudPaper>
        <br /> *@

        <MudPaper Class="pa-4 mt-4" Elevation="4" Style="width:100%">
            <MudGrid>
                <MudItem xs="12" sm="12" md="12">
                    <MudGrid>
                        <MudItem xs="12" sm="12" md="1">
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        </MudItem>
                        <MudItem xs="12" sm="12" md="4">
                            <MudTextField @bind-Value="searchString1" Label="Número de solicitud:" Clearable="true" Class="mt-0" HelperText="Sólo Números (12 dígitos)"></MudTextField>
                            @* <MudNumericField HideSpinButtons="true" @bind-Value="searchString1" Label="Número de solicitud:" Variant="Variant.Outlined" Min="0" Max="999999999999" HelperText="Sólo Números (12 dígitos)" /> *@
