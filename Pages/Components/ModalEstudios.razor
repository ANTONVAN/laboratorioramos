@code {
    private readonly DialogOptions DiaOptions = new() 
    { 
        BackgroundClass = "modal-estudios-dialog-backdrop", 
        BackdropClick = true, 
        MaxWidth = MaxWidth.Large, 
        FullWidth = true, 
        CloseButton = true 
    };
    private MudTextField<string> searchRef;
    [Inject] IDialogService DialogService { get; set; }

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string EstudioSearch { get; set; }
    [Parameter] public EventCallback<string> EstudioSearchChanged { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public List<DtoEstudioResponsePrice> Items { get; set; }
    [Parameter] public HashSet<DtoEstudioResponsePrice> Selected { get; set; }
    [Parameter] public EventCallback<HashSet<DtoEstudioResponsePrice>> SelectedChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyUp { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TableRowClickEventArgs<DtoEstudioResponsePrice>> OnRowClickEstudio { get; set; }

    private void ToggleDetails(string clave)
    {
        var item = Items?.FirstOrDefault(f => f.Clave.Equals(clave));
        if (item != null) item.ShowDetails = !item.ShowDetails;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && searchRef != null)
        {
            try { await searchRef.FocusAsync(); } catch {}
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            if (Selected != null && Selected.Count > 0)
            {
                if (OnAccept.HasDelegate) await OnAccept.InvokeAsync();
            }
            else
            {
                if (OnSearch.HasDelegate) await OnSearch.InvokeAsync();
            }
        }
        else if (args.Key == "Escape")
        {
            await CancelInternal();
        }
    }

    private async Task CancelInternal()
    {
        if (Selected != null && Selected.Count > 0 && DialogService != null)
        {
            bool? confirm = await DialogService.ShowMessageBox(
                "Atención",
                "Tiene estudios seleccionados. ¿Desea cancelar y descartar la selección?",
                yesText: "Sí",
                cancelText: "No");
            if (confirm != true) return;
        }
        if (OnCancel.HasDelegate) await OnCancel.InvokeAsync();
    }
}


