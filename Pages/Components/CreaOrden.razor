    void SelectedItemsChanged(HashSet<DtoSucursal> items)
    {
        if (items.Count==0)
        {
            priAct=0;
            SucursalID = "";
        }
        else
        {
            var rowActual = priAct == 0 ? items.ToList().Last():items.ToList().First();
            foreach (var item in items)
            {
                mudTable.SelectedItems.Remove(item);
            }
            mudTable.SelectedItems.Add(rowActual);
            SucursalID = rowActual.IdSucursal;
            priAct=1;
        }

    }

    private string SelectedRowPaciente(DtoPaciente element, int rowNumber)
    {
        if (selectedRowNumberPaciente == rowNumber)
        {
            selectedRowNumberPaciente = -1;
            dtoPacienteSelected = new();
            return string.Empty;
        }
        else if (mudTablePaciente.SelectedItem != null && mudTablePaciente.SelectedItem.Equals(element))
        {
            selectedRowNumberPaciente = rowNumber;
            dtoPacienteSelected = element;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }


