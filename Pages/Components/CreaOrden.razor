@page "/CreaOrden/{PostRequiere}"
@using LaboratorioRamos.Data.DtoEstudio
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoCotizacion
@using LaboratorioRamos.Data.DtoSucursal
@using LaboratorioRamos.Data.DtoPaciente.DtoRequestPaciente
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoEmpresa
@using LaboratorioRamos.PDF;


@inject HttpClient Http;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject IJSRuntime IJSRuntime

<PageTitle>Creación de Órden Médica</PageTitle>

@if (dataLoaded)
{
    <Loading></Loading>
}
else
{
    <MudBreadcrumbs Items="_items" Style="padding: 0px;"></MudBreadcrumbs>

    <MudPaper Class="pa-4 mt-4" Elevation="4" Style="width:100%">
        <MudGrid>
            <MudItem xs="12" sm="12" md="12" >
                <MudGrid>
                    <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center">
                        <MudText Typo="Typo.h4" style="color: #0d37a8;">Creación y Consulta de Órdenes Médicas</MudText>
                    </MudItem>
                </MudGrid>
            </MudItem>
            @if (ShowOrdenes)
            {
                if (!NewCotizacion)
                {
                    <MudItem xs="12" sm="12" md="12">
                        <EditForm Model="_busquedaCotizacion" OnValidSubmit="@BuscarOrdenes" style="width: 100%;">
                            <MudGrid>
                                <MudItem xs="12" sm="12" md="1">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </MudItem>
                                <MudItem xs="12" sm="12" md="4">
                                    <MudTextField @bind-Value="_busquedaCotizacion.searchString1" Label="Número de Orden:" Clearable="true" Class="mt-0" HelperText="Sólo Números (12 dígitos)"></MudTextField>
                                </MudItem>
                                <MudItem xs="12" sm="12" md="3">
                                    <MudDatePicker Label="Fecha Inicio(dd/MM/yyyy)" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" @bind-Date="_busquedaCotizacion.dateInicial" />
                                </MudItem>
                                <MudItem xs="12" sm="12" md="3">
                                    <MudDatePicker Label="Fecha Final(dd/MM/yyyy)" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" @bind-Date="_busquedaCotizacion.dateFinal" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="12" md="1">
                                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Outlined.Search" Color="Color.Primary" Size="Size.Large" aria-label="Buscar"></MudIconButton>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudItem>
                    <MudItem xs="12" sm="12" md="12" Class="d-flex justify-start">
                        <MudButton Variant="Variant.Outlined" OnClick="@NewItem" Color="@Color.Info" Class="add-item-btn">Crear Nueva Orden</MudButton>
                    </MudItem>

                    <MudItem xs="12" sm="12" md="12">
                        <MudDataGrid Items="@_oCotizaciones" Dense="true" Hover="true" Striped="true" Elevation="4" Style="width:100%;" FixedHeader="true" Filterable="false">
                            <ToolBarContent>
                                <MudSpacer />
                                <MudText Typo="Typo.h6" style="color: #0d37a8;">Historial de Ordenes</MudText>
                                <MudSpacer />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn HeaderStyle="color:#921313" Property="x => x.Clave" Title="Clave" />
                                <PropertyColumn HeaderStyle="color:#921313" Property="x => x.Expediente"/>
                                <PropertyColumn HeaderStyle="color:#921313" Property="x => x.Paciente" />
                                <PropertyColumn HeaderStyle="color:#921313" Property="x => x.Correo"  />
                                <PropertyColumn HeaderStyle="color:#921313" Property="x => x.Fecha" Title="Fecha de Creación"/>
                                <TemplateColumn HeaderStyle="color:#921313" Title="Activo">
                                    <CellTemplate>
                                        @{
                                            var actilbl = context.Item.Activo == true ? "SI" : "NO";
                                        }
                                        @actilbl
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn HeaderStyle="color:#921313" Title="Estudios">
                                    <CellTemplate>
                                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Info" OnClick="@(()=>OpenDialog(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn HeaderStyle="color:#921313" Title="Acciones">
                                    <CellTemplate>
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(()=>EditOrden(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="DtoCotizacionResponse" />
                            </PagerContent>
                        </MudDataGrid>


                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="12" md="12" >
                        <MudGrid>
                            <MudItem xs="12" sm="12" md="12" Class="d-flex justify-end">
                                <b><Label>Registro: @DateTime.Now.ToLongDateString().ToUpper()</Label></b>
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    @if (!ContinuarCotizacion)
                    {
                        <MudItem xs="12" sm="12" md="12">
                            <MudPaper Class="pa-4" Elevation="2" Style="width:100%">
                                <EditForm Model="dtoGeneralesCotizacion" OnValidSubmit="@ContnueProcess" style="width: 100%;">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6" md="6">
                                            <MudAutocomplete T="string" @bind-Value="dtoGeneralesCotizacion.Ciudad"
                                                             SearchFunc="SearchCiudad"
                                                             Label="Ciudad"
                                                             Clearable="true"/>

                                            @if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                                            {
                                                SelectedCiudad(dtoGeneralesCotizacion.Ciudad);
                                            }
                                           @*  <MudSelect T="string" Label="Ciudad *" Clearable="true" ValueChanged="SelectedCiudad">
                                                @foreach (var ocity in _oSucursalByCity)
                                                {
                                                    <MudSelectItem Value="@ocity.Ciudad">@ocity.Ciudad</MudSelectItem>
                                                }
                                            </MudSelect> *@
                                        </MudItem>
                                        <MudItem xs="12" sm="12" md="12">
                                            @if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                                            {
                                                <MudTable T="DtoSucursal" Items="@_oSucursalForCity" Hover="true" Breakpoint="Breakpoint.Sm" @ref="mudTable"
                                                          RowClass="cursor-pointer" RowClassFunc="@SelectedRowSucursal" OnRowClick="RowClickEvent" Context="sucur" Dense="true" Striped="true" Bordered="true" FixedHeader="true">
                                                    @* <ToolBarContent style=" flex-flow: column;padding-top: 20px;"> *@
                                                    <ToolBarContent>
                                                        <MudText Typo="Typo.h6" Align="Align.Center" style="color: #0d37a8;">Sucursales</MudText> <br />
                                                        <MudText Typo="Typo.body1" Align="Align.Center" style="color: #0d37a8;">&nbsp;&nbsp;&nbsp;(Opcional)</MudText> <br />
                                                        @* <MudSpacer /> *@
                                                    </ToolBarContent>
                                                    <HeaderContent>
                                                        @* <MudTh>Código</MudTh> *@
                                                        <MudTh Style="color:#921313">Clave</MudTh>
                                                        <MudTh Style="color:#921313">Nombre</MudTh>
                                                        <MudTh Style="color:#921313">Ubicacion</MudTh>
                                                        <MudTh Style="color:#921313">Telefono</MudTh>
                                                        <MudTh Style="color:#921313">Correo</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        @* <MudTd DataLabel="Codigo">@sucur.Codigo</MudTd> *@
                                                        <MudTd DataLabel="Clave">@sucur.Clave</MudTd>
                                                        <MudTd DataLabel="Nombre">@sucur.Nombre</MudTd>
                                                        <MudTd DataLabel="Ubicacion">@sucur.Ubicacion</MudTd>
                                                        <MudTd DataLabel="Telefono">@sucur.Telefono</MudTd>
                                                        <MudTd DataLabel="Correo">@sucur.Correo</MudTd>
                                                    </RowTemplate>
                                                    <NoRecordsContent>
                                                        <MudText>Sin Registros para mostrar</MudText>
                                                    </NoRecordsContent>
                                                    <PagerContent>
                                                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                                    </PagerContent>
                                                </MudTable>

                                            }

                                        </MudItem>
                                        <MudItem xs="12" sm="12" md="6" Class="d-flex justify-center">
                                            <MudButton OnClick="@CancelItem" StartIcon="@Icons.Material.Filled.Cancel" Color="@Color.Error" Class="add-item-btn">Cancelar</MudButton>
                                        </MudItem>
                                        <MudItem xs="12" sm="12" md="6" Class="d-flex justify-center">
                                            <MudButton ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.DoubleArrow" Color="@Color.Info" Class="add-item-btn">Continuar</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </EditForm>
                            </MudPaper>

                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="12" md="12">
                            <MudText Class="p-2" Style="background-color: #0d37a8;color: white;" Align="Align.Center">Órden No.: <b>@CotizacionDraft.clave &nbsp; &nbsp;&nbsp;&nbsp;</b></MudText>
                            
                            <MudStepper NonLinear ShowResetButton OnPreviewInteraction="OnPreviewInteraction" @bind-ActiveIndex="_index">
                                <ConnectorTemplate Context="step">
                                    <div class="mud-stepper-nav-connector">
                                        @{
                                            int value = step.Completed ? 100 : 0;
                                            <MudProgressLinear Indeterminate="@(step.IsActive)" Striped Value="value" Min="0" Max="100" Color="Color.Success" Style="height: 2px; background-color: #d4ddeb; border-radius: 2px;" />
                                        }
                                    </div>
                                </ConnectorTemplate>
                                @* <LabelTemplate>
                                    @if (context.IsActive && _index==3 && CreandoPDF ==true) {
                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                    }
                                    
                                </LabelTemplate> *@
                                <ChildContent>
                                    <MudStep Title="Generales Paciente" SecondaryText="(Opcional)">
                                        <MudDivider />
                                        <MudGrid Class="mt-2">
                                            <MudItem xs="12" sm="12" md="12">
                                                <MudText Typo="Typo.h6" Align="Align.Center" style="color: #0d37a8;">Ciudad: <b>@dtoGeneralesCotizacion.Ciudad</b></MudText>
                                            </MudItem>
                                            @if (!String.IsNullOrEmpty(SucursalName))
                                            {
                                                <MudItem xs="12" sm="12" md="12">
                                                    <MudText Typo="Typo.h6" Align="Align.Start" style="color: #0d37a8;">Sucursal: <b>@SucursalName</b></MudText>
                                                </MudItem>
                                            }

                                            <MudItem xs="12" sm="12" md="12">
                                                <MudTextField @bind-Value="dtoGeneralesCotizacion.Observaciones" T="string" Label="Observaciones" Lines="3" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="6">
                                                @* <MudTextField T="string" Label="Paciente" @bind-Value="dtoGeneralesCotizacion.Paciente" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnKeyUp="ValidaEnterPaciente" OnAdornmentClick="@(() => BuscarPaciente())" /> *@
                                                <MudTextField T="string" Label="Paciente" @bind-Value="dtoGeneralesCotizacion.Paciente"/>
                                            </MudItem>
                                            @if (visibleInfoPaciente)
                                            {
                                                <MudItem xs="12" sm="12" md="12">
                                                    <MudTable T="DtoPaciente" Items="@dtoPaciente" Hover="true" Breakpoint="Breakpoint.Sm" @ref="mudTablePaciente"
                                                              RowClass="cursor-pointer" RowClassFunc="@SelectedRowPaciente" OnRowClick="RowClickEventPaciente" Context="Pacient" Dense="true" Striped="true" Bordered="true" FixedHeader="true">
                                                        <ToolBarContent>
                                                            <MudText Typo="Typo.h6" Align="Align.Center" style="color: #0d37a8;">Pacientes</MudText> <br />
                                                            <MudText Typo="Typo.body1" Align="Align.Center" style="color: #0d37a8;">&nbsp;&nbsp;&nbsp;(Opcional)</MudText> <br />
                                                            @* <MudSpacer /> *@
                                                        </ToolBarContent>
                                                        <HeaderContent>
                                                            <MudTh Style="color:#921313">Expediente</MudTh>
                                                            <MudTh Style="color:#921313">Nombre</MudTh>
                                                            <MudTh Style="color:#921313">Sexo</MudTh>
                                                            <MudTh Style="color:#921313">Edad</MudTh>
                                                            <MudTh Style="color:#921313">FechaNacimiento</MudTh>
                                                        </HeaderContent>
                                                        <RowTemplate>
                                                            @* <MudTd DataLabel="Codigo">@sucur.Codigo</MudTd> *@
                                                            <MudTd DataLabel="Expediente">@Pacient.Expediente</MudTd>
                                                            <MudTd DataLabel="Nombre">@Pacient.NombrePaciente</MudTd>
                                                            <MudTd DataLabel="Sexo">@Pacient.Genero</MudTd>
                                                            <MudTd DataLabel="Edad">@Pacient.Edad</MudTd>
                                                            <MudTd DataLabel="FechaNacimiento">@Pacient.FechaNacimiento</MudTd>
                                                        </RowTemplate>
                                                        <NoRecordsContent>
                                                            <MudText>Sin Registros para mostrar</MudText>
                                                        </NoRecordsContent>
                                                        <PagerContent>
                                                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                                        </PagerContent>
                                                    </MudTable>
                                                </MudItem>
                                            }

                                        </MudGrid>
                                    </MudStep>
                                    <MudStep Title="Estudios" SecondaryText="Agregar Estudios" HasError="@(selectedEstudios.Count()==0)">
                                        <MudDivider />
                                        <MudGrid Class="mt-2">
                                            <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center">
                                                <MudButton Variant="Variant.Outlined" OnClick="@AbrirModalEstudios" StartIcon="@Icons.Material.Filled.Add" Color="@Color.Info" Class="add-item-btn">Agregar Estudios</MudButton>
                                            </MudItem>                                            
                                            @if (visibleInfoEstudio)
                                            {
                                                <MudItem xs="12" sm="12" md="12">
                                                    <MudForm Spacing="2">
                                                        <MudDataGrid T="DtoEstudioResponsePrice" Items="@selectedEstudios" Filterable="false" Elevation="3" Hover="true" Dense="true" Striped="true" Bordered="true" FixedHeader="true" StartedEditingItem="@StartedEditingItem">
                                                            <ToolBarContent>
                                                                <MudSpacer />
                                                                <MudText Typo="Typo.h6" style="color: #0d37a8;">Estudios Seleccionados</MudText>
                                                                <MudSpacer />
                                                                
                                                            </ToolBarContent>
                                                            <Columns>
                                                                <TemplateColumn>
                                                                    <CellTemplate>
                                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(()=> StartedEditingItem(context.Item))" />
                                                                    </CellTemplate>
                                                                </TemplateColumn>
                                                                <PropertyColumn Property="x => x.Clave" Editable="false" />
                                                                <PropertyColumn Property="x => x.Nombre" />
                                                                <PropertyColumn Property="x => x.Dias" />
                                                                @* <FooterTemplate>
                                            Total:
                                            </FooterTemplate>
                                            </PropertyColumn> *@
                                                                @* <PropertyColumn Property="x => x.PrecioFinal" Format="C" >
                                            <FooterTemplate>
                                            @{
                                            string totalgral = selectedEstudios.Sum((e) => e.PrecioFinal).ToString("$ ###,###,##0.00");
                                            }
                                            @totalgral
                                            </FooterTemplate>
                                            </PropertyColumn> *@
                                                            </Columns>
                                                            <PagerContent>
                                                                <MudDataGridPager T="DtoEstudioResponsePrice" />
                                                            </PagerContent>
                                                        </MudDataGrid>
                                                        @* <MudTable T="DtoEstudioResponsePrice" Items="@selectedEstudios" Hover="true" Breakpoint="Breakpoint.Sm"
                                    RowClass="cursor-pointer" Context="GridEstudioSel" CustomFooter="true" Dense="true" Striped="true" Bordered="true" FixedHeader="true">
                                    <ToolBarContent>
                                    <MudText Typo="Typo.h6" Align="Align.Center" style="color: #0d37a8;">Estudios</MudText> <br />
                                    </ToolBarContent>
                                    <HeaderContent>
                                    <MudTh>Clave</MudTh>
                                    <MudTh>Nombre</MudTh>
                                    <MudTh>Precio Final</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                    <MudTd DataLabel="Clave">@GridEstudioSel.Clave</MudTd>
                                    <MudTd DataLabel="Nombre" Style="width:150px;">@GridEstudioSel.Nombre</MudTd>
                                    <MudTd DataLabel="Precio Final" Style="text-align: right !important;width:170px;">@GridEstudioSel.PrecioFinal.ToString("$ ###,###,##0.00")</MudTd>
                                    </RowTemplate>
                                    <FooterContent>
                                    <MudTFootRow Checkable="false">
                                    <MudTd colspan="2" Style="text-align: right;"><b>Total:</b></MudTd>
                                    <MudTd colspan="1" Style="text-align: right;width:170px;"><b>@selectedEstudios.Sum((e) => e.PrecioFinal).ToString("$ ###,###,##0.00")</b></MudTd>
                                    </MudTFootRow></FooterContent>

                                    <NoRecordsContent>
                                    <MudText>Sin estudios seleccionados</MudText>
                                    </NoRecordsContent>
                                    <PagerContent>
                                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                    </PagerContent>
                                    </MudTable> *@
                                                    </MudForm>
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudStep>
                                    <MudStep Title="Indicaciones" SecondaryText="Atención" >
                                        <MudDivider />
                                        <MudGrid Class="mt-2">
                                            @{
                                                List<string> listindicaciones = new();
                                                foreach (var item in selectedEstudios)
                                                {
                                                    foreach (var itemIndi in item.Indicaciones)
                                                    {
                                                        var indiexiste = listindicaciones.FirstOrDefault(e=>e.Equals(itemIndi.Descripcion));
                                                        if (indiexiste==null)
                                                        {
                                                            listindicaciones.Add(itemIndi.Descripcion);
                                                            <MudItem xs="12" sm="12" md="12" Class="justify-start">@itemIndi.Descripcion</MudItem>
                                                        }
                                                        
                                                    }
                                                }
                                            }
                                            <MudItem xs="12" sm="12" md="12" Class="justify-start"></MudItem>
                                        </MudGrid>
                                    </MudStep>
                                    <MudStep Title="Recibo" SecondaryText="">
                                        <MudGrid>
                                            <MudItem xs="12" sm="7" md="12">
                                                <MudText Align="Align.Center" Typo="Typo.h3" style="color: #0d37a8;">Recibo</MudText><MudSpacer />
                                            </MudItem>
                                            <MudItem xs="12" sm="7" md="12" id="iFrameId" Style="height: 35.5rem;">
                                                <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center">
                                                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                                                </MudItem>
                                            </MudItem>
                                        </MudGrid>
                                    </MudStep>
                                </ChildContent>
                                <ActionContent Context="stepper">                                    
                                    <MudIconButton OnClick="@(() => stepper.PreviousStepAsync())" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Disabled="@(_index <= 0)" />
                                    <MudSpacer />
                                    @* @if (stepper.Steps[_index].Skippable == true)
                                    {
                                        <MudIconButton OnClick="@(() => stepper.SkipCurrentStepAsync())" Icon="@stepper.SkipButtonIcon" Color="Color.Primary" />
                                    } *@
                                    <MudIconButton OnClick="@(() => stepper.NextStepAsync())" Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" />
                                    
                                </ActionContent>
                            </MudStepper>

                            <MudForm Spacing="2">
                                <MudGrid>
                                    <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center">
                                        <MudButton OnClick="@CancelItem" StartIcon="@Icons.Material.Filled.Cancel" Color="@Color.Error" Class="add-item-btn">Cancelar</MudButton>
                                    </MudItem>
                                    @* <MudItem xs="12" sm="12" md="6" Class="d-flex justify-center">
                                        <MudButton OnClick="@AddItem" StartIcon="@Icons.Material.Filled.Save" Color="@Color.Info" Class="add-item-btn">Crear órden</MudButton>
                                    </MudItem> *@
                                </MudGrid>
                            </MudForm>
                            
                        </MudItem>
                        @* <MudItem xs="12" sm="12" md="4">
                            <MudCard>
                                <MudCardContent>
                                    <MudText Class="p-2" Style="background-color: #0d37a8;color: white;" Align="Align.Center">Cotizacion No.: <b>@CotizacionDraft.clave &nbsp; &nbsp;&nbsp;&nbsp; <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Print" title="Imprimir" Color="Color.Inherit" Size="Size.Medium" aria-label="Imprimir"></MudIconButton></b></MudText>
                                    <MudForm Spacing="2">
                                        <MudDataGrid T="DtoEstudioResponsePrice" Items="@selectedEstudios" Filterable="false" Elevation="3" Hover="true" Dense="true" Striped="true" Bordered="true" FixedHeader="true" StartedEditingItem="@StartedEditingItem">
                                            <Columns>
                                                <TemplateColumn >
                                                    <CellTemplate>
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(()=> StartedEditingItem(context.Item))" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <PropertyColumn Property="x => x.Clave" Editable="false"/>
                                                <PropertyColumn Property="x => x.Nombre" />
                                                   
                                            </Columns>
                                        </MudDataGrid>
                                       
                                        <MudForm Spacing="2">
                                            <MudGrid>
                                                <MudItem xs="12" sm="12" md="6" Class="d-flex justify-end">
                                                    <MudButton OnClick="@CancelItem" StartIcon="@Icons.Material.Filled.Cancel" Color="@Color.Error" Class="add-item-btn">Cancelar</MudButton>
                                                </MudItem>
                                                <MudItem xs="12" sm="12" md="6" Class="d-flex justify-end">
                                                    <MudButton OnClick="@AddItem" StartIcon="@Icons.Material.Filled.Save" Color="@Color.Info" Class="add-item-btn">Crear órden</MudButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudForm>
                                    </MudForm>
                                </MudCardContent>
                                <MudCardActions>

                                </MudCardActions>
                            </MudCard>
                        </MudItem> *@
                    }
                }
            }
        </MudGrid>
    </MudPaper>
}

<MudDialog @bind-Visible="visibleInfoCotizacion" Options="diaOptions" >
    <TitleContent>
        <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center">
            <MudIcon Icon="@Icons.Material.Filled.MedicalInformation" Color="Color.Success" Class="mr-3" Size="Size.Large" />Estudios Cotizados
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            
            <MudItem xs="12" sm="12" md="12">
                <MudDataGrid Items="@_oCotizacionEstudios" Hover="true" Dense="true" Striped="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" CellClass="justify-center" />
                        @* <PropertyColumn Property="x => x.EstudioId" CellClass="justify-center" /> *@
                        <PropertyColumn Property="x => x.Clave" CellClass="justify-center" />
                        <PropertyColumn Property="x => x.Nombre" CellClass="justify-center" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="DtoCotizacionEstudios" />
                    </PagerContent>
