    void ShowSnack(string message, int sev)
    {
        switch (sev)
        {
            case 0:
                Snackbar.Add($"Atención: {message}", Severity.Normal);
                break;
            case 1:
                Snackbar.Add($"Atención: {message}", Severity.Info);
                break;
            case 2:
                Snackbar.Add($"Atención: {message}", Severity.Success);
                break;
            case 3:
                Snackbar.Add($"Atención: {message}", Severity.Warning);
                break;
            case 4:
                Snackbar.Add($"Atención: {message}", Severity.Error);
                break;

        }

    }

    async Task BuscarOrdenes()
    {
        if (_busquedaCotizacion.dateFinal < _busquedaCotizacion.dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!", 4);
        }
        else if (String.IsNullOrEmpty(_busquedaCotizacion.dateInicial.ToString()) && String.IsNullOrEmpty(_busquedaCotizacion.dateFinal.ToString()) && String.IsNullOrEmpty(_busquedaCotizacion.searchString1))
        {
            ShowSnack("¡Por favor Ingresa Fecha Inicial, Fecha Final o Número de orden!", 4);
        }
        else
        {
            //dataLoaded = true;
            ValidateData = true;
            ShowOrdenes = false;
            _oCotizaciones.Clear();
            DtoCotizacionRequest parametrobusqueda = new()
            {
                SucursalId = new(),
                // {
                //     dtoMedico.Sucursal.ToString()
                // },
                MedicoId = PostRequiere == "2" ? new() { dtoMedico.IdMedico } : new(),
                Expediente = (String.IsNullOrEmpty(_busquedaCotizacion.searchString1) ? null : _busquedaCotizacion.searchString1),
                CompañiaId = PostRequiere == "2" ? new() : new() { dtoEmpresa.Id },
                Fecha = String.IsNullOrEmpty(_busquedaCotizacion.searchString1) ? new() { DateTime.Parse(_busquedaCotizacion.dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(_busquedaCotizacion.dateFinal.ToString()).ToString("yyyy-MM-dd") }:new()
            };

            string json1 = JsonConvert.SerializeObject(parametrobusqueda);
            var sesOrdenes = await Http.PostAsJsonAsync<DtoCotizacionRequest>(UrlOrdenes, parametrobusqueda);
            switch (sesOrdenes.StatusCode)
            {
                case System.Net.HttpStatusCode.OK:
                    try
                    {

                        _oCotizaciones = await sesOrdenes.Content.ReadFromJsonAsync<List<DtoCotizacionResponse>>();
                        ShowOrdenes = true;
                    }
                    catch (Exception ex)
                    {
                        //ValidateData = false;
                    }


                    break;
                case System.Net.HttpStatusCode.InternalServerError:
                    //ShowSnack("¡Error en el Servicio,Por favor contacte con su laboratorio!");
                    break;
            }
        }



        //dataLoaded = false;
        ValidateData=false;

        StateHasChanged();

    }

