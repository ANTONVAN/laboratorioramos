    async Task ContnueProcess()
    {
        dataLoaded = true;
        if (String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
        {
            ShowSnack("¡Por favor selecciona una \"CIUDAD\"!", 4);
            ContinuarCotizacion = false;
        }
        else
        {
            SucursalID = String.IsNullOrEmpty(SucursalID) ? _oSucursalForCity.FirstOrDefault().IdSucursal: SucursalID;
            DtoDraftCotizacion drafCotiza = new()
                {
                    SucursalId = SucursalID,
                    EstatusId = 1
                };
            string json1 = JsonConvert.SerializeObject(drafCotiza);
            var responseDraft = await Http.PostAsJsonAsync<DtoDraftCotizacion>(UrlOrdenesDraft, drafCotiza);
            if (responseDraft.IsSuccessStatusCode)
            {
                IDCotizacionDraft = await responseDraft.Content.ReadAsStringAsync() ?? "";
                CotizacionDraft = await Http.GetFromJsonAsync<DtoCotizacion>($"{UrlOrdenesDraftNo}{IDCotizacionDraft}");
            }
            else
            {
                ShowSnack("¡No se puede crear la Cotización,Por favor contacte con su laboratorio!", 3);
                //ShowSnack("¡Error en el Servicio,Por favor contacte con su laboratorio!", 4);
            }

            ContinuarCotizacion = true;
        }
        dataLoaded = false;
    }


    private void SelectedCiudad( string value)
    {
        //if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
        if (!String.IsNullOrEmpty(value))
        {
            //dtoGeneralesCotizacion.Ciudad = value;
            _oSucursalForCity = _oSucursalByCity.FirstOrDefault(e => e.Ciudad.Equals(value)).Sucursales.ToList();
        }
        else
        {
            //dtoGeneralesCotizacion.Ciudad = null;
            _oSucursalForCity = new();
            SucursalID = "";
            SucursalName = "";
        }
    }

    private async Task<IEnumerable<string>> SearchCiudad(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _oSucursalByCity.Select(x=>x.Ciudad).ToList();

        return _oSucursalByCity.Select(x=>x.Ciudad).Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private string SelectedRowSucursal(DtoSucursal element, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
