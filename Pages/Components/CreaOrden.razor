    </DialogContent>
    <DialogActions>
        <MudButton 
            Variant="Variant.Filled" 
            OnClick="@CancelEdit" 
            Color="@Color.Error" 
            Class="dialog-action-button dialog-button-cancel" 
            Disabled="@ValidateDataMod"
