                                                    <MudTh Style="color:#921313">Nombre</MudTh>
                                                    <MudTh Style="color:#921313">Sexo</MudTh>
                                                    <MudTh Style="color:#921313">Edad</MudTh>
                                                    <MudTh Style="color:#921313">FechaNacimiento</MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    @* <MudTd DataLabel="Codigo">@sucur.Codigo</MudTd> *@
                                                    <MudTd DataLabel="Expediente">@Pacient.Expediente</MudTd>
                                                    <MudTd DataLabel="Nombre">@Pacient.NombrePaciente</MudTd>
                                                    <MudTd DataLabel="Sexo">@Pacient.Genero</MudTd>
                                                    <MudTd DataLabel="Edad">@Pacient.Edad</MudTd>
                                                    <MudTd DataLabel="FechaNacimiento">@Pacient.FechaNacimiento</MudTd>
                                                </RowTemplate>
                                                <NoRecordsContent>
                                                    <MudText>Sin Registros para mostrar</MudText>
                                                </NoRecordsContent>
                                                <PagerContent>
                                                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                                </PagerContent>
                                            </MudTable>
                                        </MudItem>
                                    }

                                </MudGrid>
                            </MudStep>
                            <MudStep Title="Estudios" SecondaryText="Agregar Estudios" HasError="@(selectedEstudios.Count()==0)">
                                <MudDivider />
                                <MudGrid Class="mt-2">
                                    <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center">
                                        <MudButton Variant="Variant.Outlined" OnClick="@AbrirModalEstudios" StartIcon="@Icons.Material.Filled.Add" Color="@Color.Info" Class="add-item-btn">Agregar Estudios</MudButton>
                                    </MudItem>                                            
                                    @if (visibleInfoEstudio)
                                    {
                                        <MudItem xs="12" sm="12" md="12">
                                            <MudForm Spacing="2">
                                                @* <MudDataGrid T="DtoEstudioResponsePrice" Items="@selectedEstudios" Filterable="false" Elevation="3" Hover="true" Dense="true" Striped="true" Bordered="true" FixedHeader="true" StartedEditingItem="@DeleteOrderItem">
                                                    <ToolBarContent>
                                                        <MudSpacer />
                                                        <MudText Typo="Typo.h6" style="color: #0d37a8;">Estudios Seleccionados</MudText>
                                                        <MudSpacer />
                                                                
                                                    </ToolBarContent>
                                                    <Columns>
                                                        <TemplateColumn>
                                                            <CellTemplate>
                                                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(()=> DeleteOrderItem(context.Item))" />
                                                            </CellTemplate>
                                                        </TemplateColumn>
                                                        <PropertyColumn Property="x => x.Clave" Editable="false" />
                                                        <PropertyColumn Property="x => x.Nombre" />
                                                        <PropertyColumn Property="x => x.Dias" />
                                                                
                                                    </Columns>
                                                    <PagerContent>
                                                        <MudDataGridPager T="DtoEstudioResponsePrice" />
                                                    </PagerContent>
                                                </MudDataGrid>
*@
                                                <MudTable T="DtoEstudioResponsePrice" Items="@selectedEstudios" Elevation="3" Hover="true" Dense="true" Striped="true" Bordered="true" FixedHeader="true" Breakpoint="Breakpoint.Sm"
                                                            RowClass="cursor-pointer" OnRowClick="@OnRowClickEstudio" SelectOnRowClick="true" Context="GridEstudioSele">
                                                    <ColGroup>
                                                        <col style="width:10px;" />
                                                        <col style="width:10px;" />
                                                        <col />
                                                        <col />
                                                        <col />
                                                    </ColGroup>
                                                    <HeaderContent>
                                                        <MudTh></MudTh>
                                                        <MudTh></MudTh>
                                                        <MudTh>Clave</MudTh>
                                                        <MudTh>Nombre</MudTh>
                                                        <MudTh>Días</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        <MudTd>
                                                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(()=> DeleteOrderItem(GridEstudioSele))" />
                                                        </MudTd>
                                                        <MudTd>
                                                            @if (GridEstudioSele.Estudios != null)
                                                            {
                                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ShowBtnPressEstudioSelect(GridEstudioSele.Clave))"><MudText Typo="Typo.body1" Align="Align.Center"><strong> @((GridEstudioSele.ShowDetails == true) ? "-" : "+")</strong></MudText></MudButton>
                                                            }

                                                        </MudTd>
                                                        <MudTd DataLabel="Clave">@GridEstudioSele.Clave</MudTd>
                                                        <MudTd DataLabel="Nombre">@GridEstudioSele.Nombre</MudTd>
                                                        <MudTd DataLabel="Días">@GridEstudioSele.Dias</MudTd>
                                                    </RowTemplate>

                                                    <ChildRowContent>
                                                        @if (GridEstudioSele.ShowDetails)
                                                        {
                                                            <MudTr>
                                                                <td colspan="1">
                                                                    &nbsp;
                                                                </td>
                                                                <td colspan="3">
                                                                    <MudCard Elevation="0">
                                                                        @*<MudCardHeader>
                                                                                <CardHeaderContent>
                                                                                <MudText Typo="Typo.body1" Align="Align.Center"><strong>Estudios</strong></MudText>
                                                                            </CardHeaderContent>
                                                                        </MudCardHeader>*@
                                                                        <MudCardContent Class="pa-0">
                                                                            <MudTable Items="@GridEstudioSele.Estudios" Context="StudiContext" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                                                                <HeaderContent>
                                                                                    <MudTh>Clave</MudTh>
                                                                                    <MudTh>Nombre</MudTh>
                                                                                    <MudTh>Días</MudTh>
                                                                                </HeaderContent>
                                                                                <RowTemplate>
                                                                                    <MudTd DataLabel="Clave">@StudiContext.Clave</MudTd>
                                                                                    <MudTd DataLabel="Nombre">@StudiContext.Nombre</MudTd>
                                                                                    <MudTd DataLabel="Días">@StudiContext.Dias</MudTd>
                                                                                </RowTemplate>
                                                                            </MudTable>
                                                                        </MudCardContent>
                                                                    </MudCard>
                                                                </td>
                                                            </MudTr>
                                                        }
                                                    </ChildRowContent>
                                                    <NoRecordsContent>
                                                        <MudText>Sin Registros para mostrar</MudText>
                                                    </NoRecordsContent>
                                                    <PagerContent>
                                                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                                    </PagerContent>
                                                </MudTable>

                                            </MudForm>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudStep>
