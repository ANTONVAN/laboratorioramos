@page "/CreaOrden/{PostRequiere}"
@using System.Collections.Generic
@using LaboratorioRamos.Data.DtoEstudio
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoCotizacion
@using LaboratorioRamos.Data.DtoSucursal
@using LaboratorioRamos.Data.DtoPaciente.DtoRequestPaciente
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoEmpresa
@using LaboratorioRamos.Data.DtoEstudiosGral
@using LaboratorioRamos.PDF;


@inject HttpClient Http;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject IJSRuntime IJSRuntime
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler

<PageTitle>Creación de Órden Médica.</PageTitle>

@if (dataLoaded)
{
    <Loading></Loading>
}
else
{
    <MudBreadcrumbs Items="_items" Class="mb-2"></MudBreadcrumbs>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        @if (!NewCotizacion)
        {
            <MudPaper Elevation="2" Class="pa-4 search-container mb-4">
                <MudText Typo="Typo.h6" Class="mb-4" Style="color: #0d37a8; font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" Style="vertical-align: middle;" />
                    Búsqueda de Órdenes
                </MudText>
                <EditForm Model="_busquedaCotizacion" OnValidSubmit="@BuscarOrdenes" style="width: 100%;">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField 
                                @bind-Value="_busquedaCotizacion.searchString1" 
                                Disabled="@ValidateData" 
                                Label="Número de orden o Nombre del Paciente" 
                                Clearable="true" 
                                HelperText="Ingrese el número de orden (12 dígitos)" 
                                UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" } })"
                                Variant="Variant.Outlined"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Assignment"
                                Class="search-field" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker 
                                Clearable="true" 
                                Label="Fecha Inicio" 
                                Disabled="@ValidateData" 
                                Mask="@(new DateMask("dd/MM/yyyy"))" 
                                DateFormat="dd/MM/yyyy" 
                                @bind-Date="_busquedaCotizacion.dateInicial" 
                                PickerVariant="PickerVariant.Dialog" 
                                Color="Color.Primary" 
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense" 
                                DisableToolbar="true" 
                                AutoClose="true" 
                                Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                                Class="date-field" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker 
                                Clearable="true" 
                                Label="Fecha Final" 
                                Disabled="@ValidateData" 
                                DateFormat="dd/MM/yyyy" 
                                @bind-Date="_busquedaCotizacion.dateFinal" 
                                PickerVariant="PickerVariant.Dialog" 
                                Color="Color.Primary" 
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense" 
                                DisableToolbar="true" 
                                AutoClose="true" 
                                Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                                Class="date-field" />
                        </MudItem>
                        <MudItem xs="12" sm="12" md="1" Class="d-flex align-center" Style="padding-bottom:24px;">
                            @if (ValidateData)
                            {
                                <MudButton 
                                    Disabled 
                                    ButtonType="ButtonType.Button" 
                                    Variant="Variant.Filled" 
                                    Color="Color.Primary" 
                                    FullWidth="true"
                                    Class="search-button"
                                    Style="min-height: 56px;">
                                    <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                                </MudButton>
                            }
                            else
                            {
                                <MudButton 
                                    ButtonType="ButtonType.Submit" 
                                    StartIcon="@Icons.Material.Filled.Search" 
                                    Variant="Variant.Filled" 
                                    Color="Color.Primary" 
                                    FullWidth="true"
                                    aria-label="Buscar órdenes"
                                    Class="search-button"
                                    Style="min-height: 56px;">
                                    Buscar
                                </MudButton>
                            }
                        </MudItem>
                        <MudItem xs="12" sm="12" md="1" Class="d-flex align-center" Style="padding-bottom:24px;">
                            @if (ValidateData)
                            {
                                <MudButton 
                                    Disabled 
                                    ButtonType="ButtonType.Button" 
                                    Variant="Variant.Filled" 
                                    Color="Color.Info" 
                                    FullWidth="true"
                                    Style="min-height: 56px;">
                                    <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                                </MudButton>
                            }
                            else
                            {
                                <MudButton 
                                    Variant="Variant.Filled" 
                                    StartIcon="@Icons.Material.Filled.Add" 
                                    OnClick="@NewItem" 
                                    aria-label="Crear nueva orden" 
                                    Color="@Color.Info" 
                                    FullWidth="true"
                                    Class="create-button"
                                    Style="min-height: 56px;">
                                    Crear Orden
                                </MudButton>
                            }
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudPaper>
            <MudPaper Elevation="2" Class="results-container">
                <HistorialOrdenes Items="@_oCotizaciones" Loading="@ValidateData" OnVerEstudios="OpenDialog" OnEditar="EditOrden" />
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="2" Class="pa-4 order-header mb-4">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="12" md="3" >
                        <MudText Typo="Typo.h6" Align="Align.Left" Class="order-number">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge" Color="Color.Inherit" Size="Size.Medium" Class="animated-icon mr-1" />
                            Órden No.: <b class="order-key">@CotizacionDraft.clave</b>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="12" md="7" Class="d-flex justify-end">
                        <MudText Typo="Typo.body1" Class="order-date">
                            <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Color="Color.Inherit" Size="Size.Small" Class="mr-1" />
                            <b>Registro: @DateTime.Now.ToLongDateString().ToUpper()</b>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="12" md="2" Class="d-flex justify-center">
                        <MudTooltip Text="Salir sin guardar" Placement="Placement.Top">
                            <MudButton OnClick="@CancelItem" 
                                StartIcon="@Icons.Material.Filled.Cancel" 
                                aria-label="Salir de creación de orden" 
                                Color="@Color.Error" 
                                Variant="Variant.Filled" 
                                Class="add-item-btn rounded-0 animated-button exit-btn">
                                Salir
                            </MudButton>
                        </MudTooltip>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (!ContinuarCotizacion)
            {
                <MudPaper Elevation="2" Class="pa-4 city-selection-paper mb-4">
                    <MudText Typo="Typo.h6" Class="mb-4" Style="color: #0d37a8; font-weight: 600;">
                        <MudIcon Icon="@Icons.Material.Outlined.LocationCity" Class="mr-2" Style="vertical-align: middle;" />
                        Selecciona la Ciudad
                    </MudText>
                    <EditForm Model="dtoGeneralesCotizacion" OnValidSubmit="@ContnueProcess" style="width: 100%;">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6" md="6">
                                <MudAutocomplete T="string" 
                                    @bind-Value="dtoGeneralesCotizacion.Ciudad"
                                    SearchFunc="SearchCiudad"
                                    Label="Ciudad"
                                    Clearable="true"
                                    Variant="Variant.Outlined"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Outlined.LocationCity"
                                    Class="city-autocomplete"/>

                                @if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                                {
                                    SelectedCiudad(dtoGeneralesCotizacion.Ciudad);
                                }
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="2" Class="pa-4 stepper-container mb-4" Style="min-height:75vh;">
                    <MudStepper NonLinear ShowResetButton OnPreviewInteraction="OnPreviewInteraction" @bind-ActiveIndex="_index" >
                    <ConnectorTemplate Context="step">
                        <div class="mud-stepper-nav-connector">
                            @{
                                int value = step.Completed ? 100 : 0;
                                <MudProgressLinear Indeterminate="@(step.IsActive)" Striped Value="value" Min="0" Max="100" Color="Color.Success" Style="height: 2px; background-color: #d4ddeb; border-radius: 2px;" />
                            }
                        </div>
                    </ConnectorTemplate>
                    <LabelTemplate>
                        @{
                            if (context.IsActive && _index==4 && CreandoPDF ==true) {
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="stepper-progress" />
                            }
                            @if (context.IsActive)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ArrowRight" 
                                    Color="Color.Primary" 
                                    Size="Size.Large" 
                                    Class="animated-icon stepper-active-icon pulse-animation">
                                </MudIcon>
                            }
                            else if (context.Completed)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                                    Color="Color.Success" 
                                    Size="Size.Medium" 
                                    Class="animated-icon stepper-completed-icon">
                                </MudIcon>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Adjust" 
                                    Color="Color.Default" 
                                    Size="Size.Medium" 
                                    Class="animated-icon stepper-pending-icon">
                                </MudIcon>
                            }
                        } 

                    </LabelTemplate>
                    <ChildContent>
                        <MudStep>
                            <MudDivider />
                            <MudGrid class="pt-4">
                                <MudItem xs="12" sm="6" md="6">
                                    <MudText Typo="Typo.h6" Align="Align.Left" Class="step-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.LocationCity" Class="mr-2" Style="vertical-align: middle;" />
                                        Paso 1: <b>Ciudad</b>
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="6" Class="pt-0">
                                    <MudAutocomplete T="string" 
                                        @bind-Value="dtoGeneralesCotizacion.Ciudad"
                                        SearchFunc="SearchCiudad"
                                        Label="Ciudad"
                                        Clearable="true"
                                        Variant="Variant.Outlined"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Outlined.LocationCity"
                                        Class="city-autocomplete" />

                                    @if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                                    {
                                        SelectedCiudad(dtoGeneralesCotizacion.Ciudad);
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="12" md="12" Class="pt-0">
                                    @if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                                    {
                                            <MudDataGrid @ref="mudTable" T="DtoSucursal" MultiSelection="true" Items="@_oSucursalForCity" RowClick="@RowClicked" SelectedItemsChanged="@SelectedItemsChanged" FixedHeader="true" FixedFooter="false" Height="52vh" Class="sucursales-table" Loading="@(_oSucursalForCity == null)" Elevation="0" Hover="true" Striped="true">
                                                <ToolBarContent>
                                                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="mr-2" Style="vertical-align: middle;" />
                                                        Sucursales (Opcional)
                                                    </MudText>
                                                    <MudSpacer />
                                                    @if (_oSucursalForCity != null && _oSucursalForCity.Any())
                                                    {
                                                        <MudChip T="string"
                                                            Color="Color.Info" 
                                                            Variant="Variant.Text"
                                                            Size="Size.Small">
                                                            @_oSucursalForCity.Count @(_oSucursalForCity.Count == 1 ? "sucursal disponible" : "sucursales disponibles")
                                                        </MudChip>
                                                    }
                                                </ToolBarContent>
                                                <Columns>
                                                    <SelectColumn T="DtoSucursal" />
                                                    <PropertyColumn Property="x => x.Clave" HeaderStyle="color: #0d37a8; font-weight: 600;" Title="Clave" />
                                                    <PropertyColumn Property="x => x.Nombre" HeaderStyle="color: #0d37a8; font-weight: 600;" Title="Nombre" />
                                                    <PropertyColumn Property="x => x.Ubicacion" HeaderStyle="color: #0d37a8; font-weight: 600;" Title="Ubicación" />
                                                    <PropertyColumn Property="x => x.Telefono" HeaderStyle="color: #0d37a8; font-weight: 600;" Title="Teléfono" />
                                                    <PropertyColumn Property="x => x.Correo" HeaderStyle="color: #0d37a8; font-weight: 600;" Title="Correo" />
                                                </Columns>
                                                <LoadingContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudProgressCircular 
                                                            Indeterminate="true" 
                                                            Size="Size.Large" 
                                                            Color="Color.Primary"
                                                            Class="mb-4" />
                                                        <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
                                                            Cargando sucursales...
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #64748b;">
                                                            Por favor espere mientras se obtienen las sucursales
                                                        </MudText>
                                                    </MudContainer>
                                                </LoadingContent>
                                                <NoRecordsContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudIcon 
                                                            Icon="@Icons.Material.Filled.LocationOff" 
                                                            Size="Size.Large" 
                                                            Class="mb-4" 
                                                            Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                                                        <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                                                            No hay sucursales disponibles
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4" Align="Align.Center">
                                                            Seleccione una ciudad para ver las sucursales disponibles.
                                                        </MudText>
                                                    </MudContainer>
                                                </NoRecordsContent>
                                                <PagerContent>
                                                    <MudDataGridPager T="DtoSucursal" />
                                                </PagerContent>
                                            </MudDataGrid>

                                    }

                                </MudItem>
                            </MudGrid>
                        </MudStep>
                        <MudStep>
                            <MudDivider />
                            <MudGrid>
                                <MudItem xs="12" sm="12" md="12">
                                    <MudText Typo="Typo.h6" Align="Align.Left" Class="step-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Person" Class="mr-2" Style="vertical-align: middle;" />
                                        Paso 2: <b>Datos Generales</b>
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="12" md="12" Class="pt-0">
                                    <MudTextField @bind-Value="dtoGeneralesCotizacion.Observaciones" 
                                        T="string" 
                                        Label="Observaciones (Opcional)" 
                                        Lines="10" 
                                        Variant="Variant.Outlined"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Outlined.Notes"
                                        Class="observations-field" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="6">
                                    <MudTextField T="string" 
                                        Label="Nombre paciente (opcional)" 
                                        @bind-Value="dtoGeneralesCotizacion.Paciente"
                                        Variant="Variant.Outlined"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Outlined.Person"
                                        Class="patient-field" />
                                </MudItem>
                                @if (visibleInfoPaciente)
                                {
                                    <MudItem xs="12" sm="12" md="12">
                                            <MudTable T="DtoPaciente" Items="@dtoPaciente" Hover="true" Breakpoint="Breakpoint.Sm" @ref="mudTablePaciente" Class="patients-table"
                                            RowClass="cursor-pointer" RowClassFunc="@SelectedRowPaciente" OnRowClick="RowClickEventPaciente" Context="Pacient" Dense="false" Striped="true" Bordered="true" FixedHeader="true" Loading="@(dtoPaciente == null)" Elevation="0">
                                                <ToolBarContent>
                                                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" Style="vertical-align: middle;" />
                                                        Pacientes (Opcional)
                                                    </MudText>
                                                    <MudSpacer />
                                                    @if (dtoPaciente != null && dtoPaciente.Any())
                                                    {
                                                        <MudChip T="string"
                                                            Color="Color.Info" 
                                                            Variant="Variant.Text"
                                                            Size="Size.Small">
                                                            @dtoPaciente.Count @(dtoPaciente.Count == 1 ? "paciente encontrado" : "pacientes encontrados")
                                                        </MudChip>
                                                    }
                                                </ToolBarContent>
                                            <HeaderContent>
                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="table-header-icon mr-1" Size="Size.Small" />
                                                    Expediente
                                                </MudTh>
                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="table-header-icon mr-1" Size="Size.Small" />
                                                    Nombre
                                                </MudTh>
                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Wc" Class="table-header-icon mr-1" Size="Size.Small" />
                                                    Sexo
                                                </MudTh>
                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Cake" Class="table-header-icon mr-1" Size="Size.Small" />
                                                    Edad
                                                </MudTh>
                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon mr-1" Size="Size.Small" />
                                                    Fecha Nacimiento
                                                </MudTh>
                                            </HeaderContent>
                                            <ColGroup>
                                                <col style="width: 20%;" />
                                                <col style="width: 40%;" />
                                                <col style="width: 10%;" />
                                                <col style="width: 10%;" />
                                                <col style="width: 20%;" />
                                            </ColGroup>
                                            <RowTemplate>
                                                <MudTd DataLabel="Expediente">
                                                    <MudChip T="string"
                                                        Color="Color.Primary" 
                                                        Variant="Variant.Text"
                                                        Size="Size.Small"
                                                        Style="font-weight: 600;">
                                                        @Pacient.Expediente
                                                    </MudChip>
                                                </MudTd>
                                                <MudTd DataLabel="Nombre" Style="font-weight: 500;">
                                                    @Pacient.NombrePaciente
                                                </MudTd>
                                                <MudTd DataLabel="Sexo">
                                                    <MudText Typo="Typo.body2">@Pacient.Genero</MudText>
                                                </MudTd>
                                                <MudTd DataLabel="Edad">
                                                    <MudText Typo="Typo.body2">@Pacient.Edad años</MudText>
                                                </MudTd>
                                                <MudTd DataLabel="FechaNacimiento">
                                                    <MudText Typo="Typo.body2">@Pacient.FechaNacimiento</MudText>
                                                </MudTd>
                                            </RowTemplate>
                                                <LoadingContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudProgressCircular 
                                                            Indeterminate="true" 
                                                            Size="Size.Large" 
                                                            Color="Color.Primary"
                                                            Class="mb-4" />
                                                        <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
                                                            Cargando pacientes...
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #64748b;">
                                                            Por favor espere mientras se obtienen los resultados
                                                        </MudText>
                                                    </MudContainer>
                                                </LoadingContent>
                                                <NoRecordsContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudIcon 
                                                            Icon="@Icons.Material.Filled.PersonOff" 
                                                            Size="Size.Large" 
                                                            Class="mb-4" 
                                                            Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                                                        <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                                                            No se encontraron pacientes
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4" Align="Align.Center">
                                                            Ingrese el nombre del paciente en el campo de búsqueda para encontrar resultados.
                                                        </MudText>
                                                    </MudContainer>
                                                </NoRecordsContent>
                                                <PagerContent>
                                                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                                                </PagerContent>
                                            </MudTable>
                                        </MudItem>
                                    }

                            </MudGrid>
                        </MudStep>
                        <MudStep HasError="@(selectedEstudios.Count()==0)">
                            <MudDivider />
                            <MudGrid>
                                <MudItem xs="12" sm="12" md="12">
                                    <MudText Typo="Typo.h6" Align="Align.Left" Class="step-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Science" Class="mr-2" Style="vertical-align: middle;" />
                                        Paso 3: <b>Estudios</b>
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="12" md="12" Class="d-flex justify-center pt-0">
                                    <MudTooltip Text="Agregar estudios a la orden" Placement="Placement.Top">
                                        <MudButton Variant="Variant.Filled" 
                                            OnClick="@AbrirModalEstudios" 
                                            StartIcon="@Icons.Material.Filled.Add" 
                                            aria-label="Abrir modal de estudios" 
                                            Color="@Color.Info" 
                                            Class="add-item-btn rounded-0 animated-button add-studies-btn">
                                            Agregar Estudios
                                        </MudButton>
                                    </MudTooltip>
                                </MudItem>                                            
                                @if (visibleInfoEstudio)
                                {
                                    <MudItem xs="12" sm="12" md="12" Class="studies-table-container pt-1">
                                        <MudForm Spacing="2">
                                            <MudTable T="DtoEstudioResponsePrice" Items="@selectedEstudiosOriginal" Elevation="0" Hover="true" Dense="false" Striped="true" Bordered="true" Breakpoint="Breakpoint.Sm"
                                            RowClass="cursor-pointer" OnRowClick="@OnRowClickEstudio" SelectOnRowClick="true" Context="GridEstudioSele" Class="studies-table step3-studies-table" FixedHeader="true" FixedFooter="false" Height="45vh" Loading="@(selectedEstudiosOriginal == null)">
                                                <ToolBarContent>
                                                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Style="vertical-align: middle;" />
                                                        Estudios Seleccionados
                                                    </MudText>
                                                    <MudSpacer />
                                                    @if (selectedEstudiosOriginal != null && selectedEstudiosOriginal.Any())
                                                    {
                                                        <MudChip T="string"
                                                            Color="Color.Info" 
                                                            Variant="Variant.Text"
                                                            Size="Size.Small">
                                                            @selectedEstudiosOriginal.Count @(selectedEstudiosOriginal.Count == 1 ? "estudio seleccionado" : "estudios seleccionados")
                                                        </MudChip>
                                                    }
                                                </ToolBarContent>
                                                <ColGroup>
                                                    <col style="width: 8%;" />
                                                    <col style="width: 8%;" />
                                                    <col style="width: 15%;" />
                                                    <col style="width: 55%;" />
                                                    <col style="width: 14%;" />
                                                </ColGroup>
                                                <HeaderContent>
                                                    <MudTh Style="color: #0d37a8; font-weight: 600;"></MudTh>
                                                    <MudTh Style="color: #0d37a8; font-weight: 600;"></MudTh>
                                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Tag" Class="table-header-icon mr-1" Size="Size.Small" />
                                                        Clave
                                                    </MudTh>
                                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Science" Class="table-header-icon mr-1" Size="Size.Small" />
                                                        Nombre
                                                    </MudTh>
                                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="table-header-icon mr-1" Size="Size.Small" />
                                                        Días
                                                    </MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd>
                                                        <MudTooltip Text="Eliminar estudio" Placement="Placement.Top">
                                                            <MudIconButton Size="@Size.Small" 
                                                                Icon="@Icons.Material.Outlined.Delete" 
                                                                aria-label="Eliminar estudio" 
                                                                OnClick="(()=> DeleteOrderItem(GridEstudioSele))" 
                                                                Color="Color.Error"
                                                                Class="animated-icon delete-icon" />
                                                        </MudTooltip>
                                                    </MudTd>
                                                    <MudTd>
                                                        @if (GridEstudioSele.Estudios != null)
                                                        {
                                                            <MudButton Variant="Variant.Outlined" 
                                                                Size="Size.Small" 
                                                                OnClick="@(() => ShowBtnPressEstudioSelect(GridEstudioSele.Clave))"
                                                                Color="Color.Info"
                                                                Class="animated-button expand-btn">
                                                                <MudIcon Icon="@((GridEstudioSele.ShowDetails == true) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" 
                                                                    Size="Size.Small" 
                                                                    Class="animated-icon" />
                                                            </MudButton>
                                                        }
                                                    </MudTd>
                                                    <MudTd DataLabel="Clave">
                                                        <MudChip T="string"
                                                            Color="Color.Primary" 
                                                            Variant="Variant.Text"
                                                            Size="Size.Small"
                                                            Style="font-weight: 600;">
                                                            @GridEstudioSele.Clave
                                                        </MudChip>
                                                    </MudTd>
                                                    <MudTd DataLabel="Nombre" Style="font-weight: 500;">
                                                        @GridEstudioSele.Nombre
                                                    </MudTd>
                                                    <MudTd DataLabel="Días">
                                                        <MudText Typo="Typo.body2">@GridEstudioSele.Dias</MudText>
                                                    </MudTd>
                                                </RowTemplate>

                                                <ChildRowContent>
                                                    @if (GridEstudioSele.ShowDetails)
                                                    {
                                                        <MudTr>
                                                            <td colspan="1">
                                                                &nbsp;
                                                            </td>
                                                            <td colspan="3">
                                                                <MudCard Elevation="0">
                                                                    <MudCardContent Class="pa-0">
                                                                        <MudTable Items="@GridEstudioSele.Estudios" Context="StudiContext" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="true" Striped="true" Class="nested-studies-table">
                                                                            <HeaderContent>
                                                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                                                    <MudIcon Icon="@Icons.Material.Filled.Tag" Class="table-header-icon mr-1" Size="Size.Small" />
                                                                                    Clave
                                                                                </MudTh>
                                                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                                                    <MudIcon Icon="@Icons.Material.Filled.Science" Class="table-header-icon mr-1" Size="Size.Small" />
                                                                                    Nombre
                                                                                </MudTh>
                                                                                <MudTh Style="color: #0d37a8; font-weight: 600;">
                                                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="table-header-icon mr-1" Size="Size.Small" />
                                                                                    Días
                                                                                </MudTh>
                                                                            </HeaderContent>
                                                                            <RowTemplate>
                                                                                <MudTd DataLabel="Clave">@StudiContext.Clave</MudTd>
                                                                                <MudTd DataLabel="Nombre">@StudiContext.Nombre</MudTd>
                                                                                <MudTd DataLabel="Días">@StudiContext.Dias</MudTd>
                                                                            </RowTemplate>
                                                                        </MudTable>
                                                                    </MudCardContent>
                                                                </MudCard>
                                                            </td>
                                                        </MudTr>
                                                    }
                                                </ChildRowContent>
                                                <LoadingContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudProgressCircular 
                                                            Indeterminate="true" 
                                                            Size="Size.Large" 
                                                            Color="Color.Primary"
                                                            Class="mb-4" />
                                                        <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
                                                            Cargando estudios...
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #64748b;">
                                                            Por favor espere mientras se cargan los estudios
                                                        </MudText>
                                                    </MudContainer>
                                                </LoadingContent>
                                                <NoRecordsContent>
                                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                                        <MudIcon 
                                                            Icon="@Icons.Material.Filled.Science" 
                                                            Size="Size.Large" 
                                                            Class="mb-4" 
                                                            Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                                                        <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                                                            No hay estudios seleccionados
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4" Align="Align.Center">
                                                            Utilice el botón "Agregar Estudios" para seleccionar estudios de la orden.
                                                        </MudText>
                                                    </MudContainer>
                                                </NoRecordsContent>
                                                <PagerContent>
                                                    <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
                                                </PagerContent>
                                            </MudTable>

                                        </MudForm>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStep>
                        <MudStep>
                            <MudDivider />
                            <MudGrid>
                                <MudItem xs="12" sm="12" md="12">
                                    <MudText Typo="Typo.h6" Align="Align.Left" Class="step-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Info" Class="mr-2" Style="vertical-align: middle;" />
                                        Paso 4: <b>Indicaciones</b>
                                    </MudText>
                                </MudItem>
                                @{
                                    List<string> listindicaciones = new();
                                    foreach (var item in selectedEstudios)
                                    {
                                        if (item.Estudios==null)
                                        {
                                            foreach (var itemIndi in item.Indicaciones)
                                            {
                                                var indiexiste = listindicaciones.FirstOrDefault(e => e.Equals(itemIndi.Descripcion));
                                                if (indiexiste == null)
                                                {
                                                    listindicaciones.Add(itemIndi.Descripcion);
                                                    <MudItem xs="12" sm="12" md="12" Class="justify-start pt-0">@itemIndi.Descripcion</MudItem>
                                                }

                                            }

                                        }else{
                                            foreach (var itemEstudiPack in item.Estudios)
                                            {
                                                foreach (var itemIndipack in itemEstudiPack.Indicaciones)
                                                {
                                                    var indiexiste = listindicaciones.FirstOrDefault(e => e.Equals(itemIndipack.Descripcion));
                                                    if (indiexiste == null)
                                                    {
                                                        listindicaciones.Add(itemIndipack.Descripcion);
                                                        <MudItem xs="12" sm="12" md="12" Class="justify-start">@itemIndipack.Descripcion</MudItem>
                                                    }
                                                }
                                            }
                                        }

                                    }
                                }
                                <MudItem xs="12" sm="12" md="12" Class="justify-start"></MudItem>
                            </MudGrid>
                        </MudStep>
                        <MudStep>
                            <MudGrid>
                                <MudItem xs="12" sm="12" md="12">
                                    <MudText Typo="Typo.h6" Align="Align.Left" Class="step-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Receipt" Class="mr-2" Style="vertical-align: middle;" />
                                        Paso 5: <b>Recibo</b>
                                    </MudText>
                                </MudItem>
                                
                                @if (CotizacionDraft != null && !String.IsNullOrEmpty(CotizacionDraft.clave))
                                {
                                    <MudItem xs="12" sm="12" md="12" Class="pt-2">
                                        <MudPaper Elevation="2" Class="patient-info-card">
                                            <MudGrid Spacing="3">
                                                <MudItem xs="12" sm="6" md="2">
                                                    <div class="info-field">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Solicitud
                                                        </MudText>
                                                        <MudText Typo="Typo.h6" Class="info-value-main">
                                                            @CotizacionDraft.clave
                                                        </MudText>
                                                    </div>
                                                    <div class="info-field mt-3">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Registro
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(GetFechaRegistroFormateada())
                                                        </MudText>
                                                    </div>
                                                </MudItem>
                                                
                                                <MudItem xs="12" sm="6" md="2">
                                                    <div class="info-field">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Edad
                                                        </MudText>
                                                        <MudText Typo="Typo.body1" Class="info-value" Style="font-weight: 600;">
                                                            @(dtoPacienteSelected != null ? $"{dtoPacienteSelected.Edad} años" : "-")
                                                        </MudText>
                                                    </div>
                                                    <div class="info-field mt-3">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Médico
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small" Style="word-wrap: break-word; line-height: 1.4;">
                                                            @(CotizacionDraft.NombreMedico ?? (PostRequiere == "2" && dtoMedico != null ? $"{dtoMedico.Nombre} {dtoMedico.PrimerApellido} {dtoMedico.SegundoApellido}".Trim() : "-"))
                                                        </MudText>
                                                    </div>
                                                </MudItem>
                                                
                                                <MudItem xs="12" sm="6" md="3">
                                                    <div class="info-field">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Paciente
                                                        </MudText>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="patient-name-stack">
                                                            @if (dtoPacienteSelected != null && dtoPacienteSelected.Genero == "F")
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.Wc" Class="gender-icon-female" />
                                                            }
                                                            else if (dtoPacienteSelected != null && dtoPacienteSelected.Genero == "M")
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.Wc" Class="gender-icon-male" />
                                                            }
                                                            <MudText Typo="Typo.body1" Class="info-value patient-name">
                                                                @(dtoPacienteSelected != null ? dtoPacienteSelected.NombrePaciente : (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Paciente) ? dtoGeneralesCotizacion.Paciente : "-"))
                                                            </MudText>
                                                        </MudStack>
                                                    </div>
                                                    <div class="info-field mt-3">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Expediente
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(dtoPacienteSelected != null ? dtoPacienteSelected.Expediente : "-")
                                                        </MudText>
                                                    </div>
                                                </MudItem>
                                                
                                                <MudItem xs="12" sm="6" md="2">
                                                    <div class="info-field">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Fecha Nac.
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(dtoPacienteSelected != null && !String.IsNullOrEmpty(dtoPacienteSelected.FechaNacimiento) ? dtoPacienteSelected.FechaNacimiento : "-")
                                                        </MudText>
                                                    </div>
                                                    <div class="info-field mt-3">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Compañía
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(CotizacionDraft.nombreCompania ?? (PostRequiere == "3" && dtoEmpresa != null && !String.IsNullOrEmpty(dtoEmpresa.NombreComercial) ? dtoEmpresa.NombreComercial : "PARTICULARES"))
                                                        </MudText>
                                                    </div>
                                                </MudItem>
                                                
                                                <MudItem xs="12" sm="6" md="2">
                                                    <div class="info-field">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Teléfono
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(dtoPacienteSelected != null && !String.IsNullOrEmpty(dtoPacienteSelected.Telefono) ? dtoPacienteSelected.Telefono : "-")
                                                        </MudText>
                                                    </div>
                                                    <div class="info-field mt-3">
                                                        <MudText Typo="Typo.caption" Class="info-label">
                                                            Celular
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="info-value-small">
                                                            @(dtoPacienteSelected != null && !String.IsNullOrEmpty(dtoPacienteSelected.Telefono) ? dtoPacienteSelected.Telefono : (PostRequiere == "2" && dtoMedico != null && !String.IsNullOrEmpty(dtoMedico.Telefono) ? dtoMedico.Telefono : "-"))
                                                        </MudText>
                                                    </div>
                                                </MudItem>
                                                
                                                <MudItem xs="12" sm="12" md="1" Class="d-flex align-end justify-end patient-actions-column">
                                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="patient-action-buttons">
                                                        <MudTooltip Text="Descargar PDF" Placement="Placement.Left">
                                                            <MudIconButton 
                                                                Icon="@Icons.Material.Filled.Download" 
                                                                Color="Color.Success" 
                                                                Variant="Variant.Filled"
                                                                OnClick="() => DownloadPDF()"
                                                                Class="action-button-square action-button-download"
                                                                aria-label="Descargar PDF" />
                                                        </MudTooltip>
                                                        
                                                        <MudTooltip Text="Imprimir PDF" Placement="Placement.Left">
                                                            <MudIconButton 
                                                                Icon="@Icons.Material.Filled.Print" 
                                                                Color="Color.Error" 
                                                                Variant="Variant.Filled"
                                                                OnClick="() => PrintPDF()"
                                                                Class="action-button-square action-button-print"
                                                                aria-label="Imprimir PDF" />
                                                        </MudTooltip>
                                                        
                                                        <MudTooltip Text="Ver Reporte" Placement="Placement.Left">
                                                            <MudIconButton 
                                                                Icon="@Icons.Material.Filled.BarChart" 
                                                                Color="Color.Info" 
                                                                Variant="Variant.Filled"
                                                                OnClick="() => ViewReport()"
                                                                Class="action-button-square action-button-report"
                                                                aria-label="Ver reporte" />
                                                        </MudTooltip>
                                                    </MudStack>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                }
                                
                                <MudItem xs="12" sm="12" md="12" id="iFrameId" Class="h-55vh d-flex justify-center">
                                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" aria-label="Generando recibo" />
                                </MudItem>
                            </MudGrid>
                        </MudStep>
                    </ChildContent>
                    <ActionContent Context="stepper">
                        <MudButton Variant="Variant.Outlined"
                            StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                            Color="Color.Primary"
                            Style="text-transform:none" 
                            OnClick="@(() => stepper.PreviousStepAsync())" 
                            Disabled="@(_index <= 0)"
                            Class="animated-button stepper-prev-btn">
                            Anterior
                        </MudButton>
                        <MudSpacer />
                        @if (@CreandoPDF)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="stepper-progress" />
                        }else{
                            <MudButton Variant="Variant.Filled"
                                EndIcon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                Color="Color.Primary"
                                Style="text-transform:none" 
                                OnClick="@(() => stepper.NextStepAsync())" 
                                Disabled="@(_index > 3)"
                                Class="animated-button stepper-next-btn">
                                Siguiente
                            </MudButton>
                        }
                    </ActionContent>
                </MudStepper>
                </MudPaper>
            }
        }
    </MudContainer>

}


<MudDialog @bind-Visible="visibleInfoCotizacion" Options="diaOptionsCotizados" Class="dialog-studies">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="d-flex align-center dialog-title">
            <MudIcon Icon="@Icons.Material.Filled.MedicalInformation" 
                Color="Color.Success" 
                Class="mr-2" 
                Size="Size.Medium" />
            Estudios Cotizados
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_oCotizacionEstudios == null || !_oCotizacionEstudios.Any())
        {
            <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                <MudIcon 
                    Icon="@Icons.Material.Filled.Science" 
                    Size="Size.Large" 
                    Class="mb-4" 
                    Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                    No hay estudios cotizados
                </MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;" Align="Align.Center">
                    No se encontraron estudios para esta orden.
                </MudText>
            </MudContainer>
        }
        else
        {
            <MudDataGrid Items="@_oCotizacionEstudios" Hover="true" Dense="false" Striped="true" Bordered="true" Class="dialog-studies-table" Height="Auto" FixedHeader="true" Elevation="0" @bind-SelectedItems="_selectedEstudiosPrint">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 600;">
                        <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Style="vertical-align: middle;" />
                        Estudios de la Orden
                    </MudText>
                    <MudSpacer />
                    @if (_oCotizacionEstudios != null && _oCotizacionEstudios.Any())
                    {
                        <MudChip T="string"
                            Color="Color.Info" 
                            Variant="Variant.Text"
                            Size="Size.Small"
                            Style="background-color: #e3f2fd; color: #1976d2; font-weight: 500;">
                            @_oCotizacionEstudios.Count @(_oCotizacionEstudios.Count == 1 ? "estudio" : "estudios")
                        </MudChip>
                    }
                </ToolBarContent>
                <Columns>
                    <TemplateColumn Title="ID" HeaderStyle="color: #0d37a8; font-weight: 600;" CellClass="justify-center">
                        <HeaderTemplate>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Style="color: #0d37a8;" />
                                <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">ID</MudText>
                            </MudStack>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="int"
                                Color="Color.Default"
                                Variant="Variant.Filled"
                                Size="Size.Small"
                                Style="background-color: #e1bee7; color: #4a148c; font-weight: 600; border-radius: 16px; padding: 4px 12px;">
                                @context.Item.Id
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Clave" HeaderStyle="color: #0d37a8; font-weight: 600;" CellClass="justify-center">
                        <HeaderTemplate>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Style="color: #0d37a8;" />
                                <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">Clave</MudText>
                            </MudStack>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                                @context.Item.Clave
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Nombre" HeaderStyle="color: #0d37a8; font-weight: 600;" CellClass="justify-start">
                        <HeaderTemplate>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Style="color: #0d37a8;" />
                                <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">Nombre</MudText>
                            </MudStack>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                                @context.Item.Nombre
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 150px; padding: 2rem;">
                        <MudIcon 
                            Icon="@Icons.Material.Filled.Inbox" 
                            Size="Size.Large" 
                            Class="mb-3" 
                            Style="font-size: 4rem; color: #94a3b8; opacity: 0.7;" />
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">No hay estudios disponibles</MudText>
                    </MudContainer>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="DtoCotizacionEstudios" />
                </PagerContent>
            </MudDataGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton 
            Variant="Variant.Filled"
            Color="@Color.Error" 
            Class="dialog-action-button dialog-button-cancel" 
            OnClick="CancelPrint" 
            aria-label="Cerrar">
            <MudIcon Icon="@Icons.Material.Filled.Close" Class="cancel-icon-custom mr-2" />
            CANCELAR
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="visibleEditCotizacion" Options="diaOptionsEdit" Class="dialog-edit">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Warning" Class="d-flex align-center dialog-title">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" 
                Color="Color.Warning" 
                Class="mr-2" 
                Size="Size.Medium" />
            Atención Usuario
        </MudText>
    </TitleContent>
    <DialogContent>
        <div tabindex="0" @onkeydown="HandleEditDialogKeyDown" class="dialog-content-wrapper">
            <MudContainer Class="d-flex flex-column align-center justify-center" Style="padding: 2rem;">
                <MudIcon 
                    Icon="@Icons.Material.Filled.Edit" 
                    Size="Size.Large" 
                    Class="mb-4" 
                    Style="font-size: 4rem; color: #ff9800; opacity: 0.8;" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Align="Align.Center" Class="dialog-message mb-3">
