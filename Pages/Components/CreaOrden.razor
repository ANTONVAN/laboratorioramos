    private string GetFechaRegistroFormateada()
    {
        try
        {
            if (CotizacionDraft != null && !String.IsNullOrEmpty(CotizacionDraft.registro))
            {
                if (DateTime.TryParse(CotizacionDraft.registro, out DateTime fecha))
                {
                    return fecha.ToString("dd/MM/yyyy");
                }
            }
            return DateTime.Now.ToString("dd/MM/yyyy");
        }
        catch
        {
            return DateTime.Now.ToString("dd/MM/yyyy");
        }
    }

    void OnDateChange(DateTime? newDate)
    {
        if (newDate < _busquedaCotizacion.dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!", 4);
        }
        _busquedaCotizacion.dateFinal = newDate;

