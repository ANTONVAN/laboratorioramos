            selectedRowNumberPaciente = -1;
            dtoPacienteSelected = new();
            return string.Empty;
        }
        else if (mudTablePaciente.SelectedItem != null && mudTablePaciente.SelectedItem.Equals(element))
        {
            selectedRowNumberPaciente = rowNumber;
            dtoPacienteSelected = element;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }


