        </MudButton>
        <MudButton 
            @ref="acceptEditBtn" 
            Variant="Variant.Filled"
            OnClick="@EditQuotation" 
            Class="dialog-action-button dialog-button-accept" 
            aria-label="Aceptar edición">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
            ACEPTAR
        </MudButton>
    </DialogActions>
</MudDialog>

