            ContinuarCotizacion = false;
        }
        else
        {
            if (!String.IsNullOrEmpty(dtoGeneralesCotizacion.Paciente))
            {
                dtoRequestPaciente = new()
                    {
                        Expediente = dtoGeneralesCotizacion.Paciente
                    };

                var sesPaciente = await Http.PostAsJsonAsync<DtoRequestPaciente>(UrlUsuario, dtoRequestPaciente);
                switch (sesPaciente.StatusCode)
                {
                    case System.Net.HttpStatusCode.OK:
                        try
                        {
                            dtoPacienteTemp = await sesPaciente.Content.ReadFromJsonAsync<List<DtoPaciente>>();
                            if (dtoPacienteTemp.Count > 0)
                            {
                                foreach (var itemPAc in dtoPacienteTemp)
                                {
                                    var existepac = dtoPaciente.Where(e => e.Expediente.Equals(itemPAc.Expediente)).ToList();
                                    if (existepac.Count <= 0)
                                    {
                                        dtoPaciente.Add(itemPAc);
                                    }
                                }
                                visibleInfoPaciente = true;
                            }
                            else
                            {
                                ShowSnack("¡El Paciente no existe, favor de verificar!", 3);
                                visibleInfoPaciente = false;
                            }

                        }
                        catch (Exception ex)
                        {
                            visibleInfoPaciente = false;
                        }


                        break;
                }

                SucursalID = String.IsNullOrEmpty(SucursalID) ? _oSucursalForCity.FirstOrDefault().IdSucursal : SucursalID;
                DtoDraftCotizacion drafCotiza = new()
                    {
                        SucursalId = SucursalID,
                        EstatusId = 1
                    };
                string json1 = JsonConvert.SerializeObject(drafCotiza);
                var responseDraft = await Http.PostAsJsonAsync<DtoDraftCotizacion>(UrlOrdenesDraft, drafCotiza);
                if (responseDraft.IsSuccessStatusCode)
                {
                    IDCotizacionDraft = await responseDraft.Content.ReadAsStringAsync() ?? "";
                    CotizacionDraft = await Http.GetFromJsonAsync<DtoCotizacion>($"{UrlOrdenesDraftNo}{IDCotizacionDraft}");
                }
                else
                {
                    ShowSnack("¡No se puede crear la Cotización,Por favor contacte con su laboratorio!", 3);
                    ShowSnack("¡Error en el Servicio,Por favor contacte con su laboratorio!", 4);
                }

                ContinuarCotizacion = true;
            }
            else
            {
                dataLoaded = false;
                ShowSnack("¡Por favor ingrese un criterio de busqueda!", 3);
            }

        }
        dataLoaded = false;
    }

