    private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
    {
        if (arg.Action == StepAction.Complete)
        {
            // occurrs when clicking next
            await ControlStepCompletion(arg);
        }
        else if (arg.Action == StepAction.Activate)
        {
            // occurrs when clicking a step header with the mouse
            await ControlStepNavigation(arg);
        }
    }

    private async Task ControlStepCompletion(StepperInteractionEventArgs arg)
    {
        switch (arg.StepIndex)
        {
            case 0:
                if (String.IsNullOrEmpty(dtoGeneralesCotizacion.Ciudad))
                {
                    ShowSnack("¡Por favor selecciona una \"CIUDAD\"!", 4);
                    //ContinuarCotizacion = false;
                    arg.Cancel = true;
                }
                else
                {
                    await AsignaOrdenMedica();
                }
                break;
            case 1:
                await AsignaOrdenMedica();
                break;
            case 2:
                if (selectedEstudiosOriginal.Count == 0)
                {
                    await DialogService.ShowMessageBox("Error", "Por favor seleccione algún estudio para continuar");
                    arg.Cancel = true;
                }
                break;
            case 3:
                if (selectedEstudiosOriginal.Count == 0)
                {
                    await DialogService.ShowMessageBox("Error", "Por favor seleccione algún estudio para continuar");
                    arg.Cancel = true;
                }
                else
                {
                    CreandoPDF = true;
                    var serv = CreatePdfOrder(dtoGeneralesCotizacion, dtoPacienteSelected, selectedEstudiosOriginal, CotizacionDraft);
                    //_index = 4;
                    await serv;
                    CreandoPDF = false;
                }
                break;
            case 4:
                //CreandoPDF = true;
                // var serv = CreatePdfOrder(dtoGeneralesCotizacion, dtoPacienteSelected, selectedEstudiosOriginal, CotizacionDraft);
                // _index = 4;
                // await serv;
                //CreandoPDF = false;
                break;
        }
    }

