    private async Task DownloadPDF()
    {
        try
        {
            MemoryStream pdfStream = null;
            
            if (_currentPdfStream == null)
            {
                _currentPdfStream = await _PdfGenerator.CreatePDFOrder(dtoGeneralesCotizacion, dtoPacienteSelected, selectedEstudiosOriginal, CotizacionDraft);
            }
            
            if (_currentPdfStream != null && _currentPdfStream.Length > 0)
            {
                // Crear una copia del stream para no consumirlo
                if (_currentPdfStream.CanSeek)
                {
                    _currentPdfStream.Position = 0;
                }
                var pdfBytes = _currentPdfStream.ToArray();
                pdfStream = new MemoryStream(pdfBytes);
                
                _PdfGenerator.DownloadPDF(IJSRuntime, pdfStream);
            }
            else
            {
                ShowSnack("No hay PDF disponible para descargar", 3);
            }
        }
        catch (Exception ex)
        {
            ShowSnack($"Error al descargar el PDF: {ex.Message}", 4);
        }
    }

