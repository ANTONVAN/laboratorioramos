    private async void NavigationResultado(DtoResponseMedicoPaciente args, DtoResponseMedicoPacienteStudios _estudio)
    {

        var nopag = _tableO.CurrentPage;
        var obFilters = filorig.LstFiltro.FirstOrDefault(op => op.OriginPage.Trim().Equals("ConsultaSolicitudes"));
        if (obFilters != null)
        {
            obFilters.PageNo = nopag.ToString();
            obFilters.ExpedienteNombreSol = dtoFiltro.Solicitud;
            obFilters.DateInicial = dtoFiltro.DateInicial;
            obFilters.DateFinal = dtoFiltro.DateFinal;
            obFilters.ExistReg = true;
        }
        else
        {
            DtoFiltroLst newFilter = new()
                {
                    OriginPage = "ConsultaSolicitudes",
                    PageNo = nopag.ToString(),
                    ExpedienteNombreSol = dtoFiltro.Solicitud,
                    DateInicial = dtoFiltro.DateInicial,
                    DateFinal = dtoFiltro.DateFinal,
                    ExistReg = true
                };
            filorig.LstFiltro.Add(newFilter);
        }

        string json = JsonConvert.SerializeObject(PostRequiere == "2"?dtoMedico: dtoEmpresa);
        string filtro = JsonConvert.SerializeObject(filorig);
        var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
        await cusAuthStateProvider.UpdAuthenticationState(new DtoUserProvider
            {
                filtros = Cryp.Encripta(filtro),
                testsuncretr = Cryp.Encripta(json),
                Type = 2,
            });

        string json0 = JsonConvert.SerializeObject(_estudio);
        string jsonSoli = JsonConvert.SerializeObject(args.Solicitud);
        
        //string json1 = JsonConvert.SerializeObject(_estudio == null ? $"{args}" : $"{args}!{_estudio}");
        NavigationManager.NavigateTo($"ResultadoEstudios/{PostRequiere}/{Cryp.Encripta(_estudio == null ? $"{jsonSoli}!{null}!{null}!ConsultaSolicitudes" : $"{jsonSoli}!{json0}!{null}!ConsultaSolicitudes")}", false);
    }
    
