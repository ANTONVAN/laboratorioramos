@page "/ConsultaSolicitudes/{PostRequiere}"

@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoFiltro
@using LaboratorioRamos.Data.DtoExpediente
@using LaboratorioRamos.Data.DtoEmpresa
@using LaboratorioRamos.Data.DtoExpediente.DtoRequestExpedientes
@using LaboratorioRamos.Data.DtoMedico.DtoRequestMedicoPacientes
@using LaboratorioRamos.Data.DtoMedico.DtoResponseMedicoPaciente
@using LaboratorioRamos.Data.DtoImpresionResultados
@using LaboratorioRamos.Data.DtoStateProvider
@using LaboratorioRamos.PDF;
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.StaticFiles
@inject HttpClient Http;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler
@inject IJSRuntime IJSRuntime
@inject IConfiguration _config
@inject LoginReturnUrlStore LoginReturnStore

<PageTitle>Consulta de Solicitudes</PageTitle>

<MudBreadcrumbs Items="_items" Class="mb-2"></MudBreadcrumbs>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <MudPaper Elevation="2" Class="pa-4 search-container mb-4">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: #0d37a8; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" Style="vertical-align: middle;" />
            Búsqueda de Solicitudes
        </MudText>
        
        <EditForm Model="@dtoFiltro" OnValidSubmit="BuscaFecha">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="5">
                    <MudTextField 
                        @bind-Value="dtoFiltro.Solicitud" 
                        Disabled="@ValidateData" 
                        Label="Número de Solicitud o Nombre del Paciente" 
                        Variant="Variant.Outlined"
                        Clearable="true" 
                        HelperText="Ingrese el número de solicitud o nombre del paciente" 
                        For="@(() => dtoFiltro.Solicitud)" 
                        UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" } })"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Assignment"
                        Class="search-field">
                    </MudTextField>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker 
                        Clearable="true" 
                        Label="Fecha Inicio" 
                        Disabled="@ValidateData" 
                        Mask="@(new DateMask("dd/MM/yyyy"))" 
                        DateFormat="dd/MM/yyyy" 
                        @bind-Date="dtoFiltro.DateInicial" 
                        PickerVariant="PickerVariant.Dialog" 
                        Color="Color.Primary" 
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense" 
                        DisableToolbar="true" 
                        AutoClose="true" 
                        Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                        Class="date-field">
                    </MudDatePicker>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker 
                        Clearable="true" 
                        Label="Fecha Final" 
                        Disabled="@ValidateData" 
                        DateFormat="dd/MM/yyyy" 
                        @bind-Date="dtoFiltro.DateFinal" 
                        PickerVariant="PickerVariant.Dialog" 
                        Color="Color.Primary" 
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense" 
                        DisableToolbar="true" 
                        AutoClose="true" 
                        Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                        Class="date-field">
                    </MudDatePicker>
                </MudItem>
                
                <MudItem xs="12" sm="12" md="1" Class="d-flex align-center" Style="padding-bottom:24px;">
                    @if (ValidateData)
                    {
                        <MudButton 
                            Disabled 
                            ButtonType="ButtonType.Button" 
                            Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            FullWidth="true"
                            Class="search-button"
                            Style="min-height: 56px;">
                            <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                        </MudButton>
                    }
                    else
                    {
                        <MudButton 
                            ButtonType="ButtonType.Submit" 
                            StartIcon="@Icons.Material.Filled.Search" 
                            Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            FullWidth="true"
                            aria-label="Buscar solicitudes"
                            Class="search-button"
                            Style="min-height: 56px;">
                            Buscar
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
    <MudPaper Elevation="2" Class="results-container">
        <!-- Header Section with Badge -->
        <div class="results-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="results-header-content">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Class="results-header-icon" Size="Size.Medium" />
                    <MudText Typo="Typo.h6" Class="results-header-title">
                        Resultados de Búsqueda
                    </MudText>
                </MudStack>
                @if (!ValidateData && LstExpedientes != null && LstExpedientes.Any())
                {
                    <MudChip 
                        T="string"
                        Size="Size.Small" 
                        Variant="Variant.Filled"
                        Class="results-count-badge">
                        @LstExpedientes.Count @(LstExpedientes.Count == 1 ? "expediente encontrado" : "expedientes encontrados")
                    </MudChip>
                }
            </MudStack>
        </div>
        
        <MudTable 
            @ref="_tableO" 
            Items="@LstExpedientes.OrderByDescending(op=>op.Solicitud)" 
            Breakpoint="Breakpoint.Sm" 
            Dense="false" 
            Hover="true" 
            Striped="true" 
            Elevation="0" 
            Loading="@(ValidateData || _isDownloading)"
            FixedHeader="true" 
            FixedFooter="false"
            Class="solicitudes-table results-table">
            <ColGroup>
                <col style="width: 3%;" />
                <col style="width: 15%;" />
                <col style="width: 12%;" />
                <col style="width: 25%;" />
                <col style="width: 8%;" />
                <col style="width: 8%;" />
                <col style="width: 12%;" />
                <col style="width: 10%;" />
            </ColGroup>
            
            <HeaderContent>
                <MudTh Style="color: #0d37a8; font-weight: 600;"></MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Work" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Número de Solicitud</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Fecha de Ingreso</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Nombre</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Wc" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Sexo</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Cake" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Edad</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Sucursal</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700; text-align: center;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Acciones</MudText>
                    </MudStack>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTooltip Text="@(context.ShowEstudios ? "Ocultar estudios" : "Ver estudios")">
                        <MudIconButton 
                            Icon="@(context.ShowEstudios ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)" 
                            Size="Size.Small" 
                            Color="Color.Primary" 
                            Variant="Variant.Text"
                            OnClick="@(() => ShowBtnPress(context.Solicitud))"
                            Class="expand-button"
                            aria-label="@(context.ShowEstudios ? "Ocultar estudios" : "Ver estudios")" />
                    </MudTooltip>
                </MudTd>

                @{
                    int countStudi = EstudioDisplayHelper.FiltrarListado(context.Estudios).Count;
                }

                <MudTd DataLabel="Número de Solicitud">
                    <MudTooltip Text="@($"Ver detalles de la solicitud {context.Solicitud}")">
                        <MudChip 
                            T="string"
                            Color="Color.Default"
                            Variant="Variant.Filled"
                            Size="Size.Small"
                            Class="solicitud-chip"
                            OnClick="@(() => NavigationResultado(context, null))">
                            @context.Solicitud
                        </MudChip>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Fecha de Ingreso">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Registro
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Nombre">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Nombre
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Sexo">
                    <MudChip T="string"
                        Color="Color.Default" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                        @context.Sexo
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Edad">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Edad años
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Sucursal">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Sucursal
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: center;">
                    @if (countStudi > 0)
                    {
                        <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                            <MudTooltip Text="@($"Ver detalles de la solicitud {context.Solicitud}")">
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Visibility" 
                                    Color="Color.Primary" 
                                    Size="Size.Small" 
                                    Variant="Variant.Filled"
                                    OnClick="@(() => NavigationResultado(context, null))"
                                    Disabled="ValidateData || _isDownloading"
                                    Class="action-button action-button-view" />
                            </MudTooltip>
                            
                            @if (ValidateData)
                            {
                                <MudTooltip Text="Descargar PDF Completo">
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Download" 
                                        Color="Color.Success" 
                                        Size="Size.Small" 
                                        Variant="Variant.Filled"
                                        Disabled="true" 
                                        aria-label="Descargar estudios"
                                        Class="action-button" />
                                </MudTooltip>
                                <MudTooltip Text="Seleccionar Estudios para Imprimir">
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Print" 
                                        Color="Color.Error" 
                                        Size="Size.Small" 
                                        Variant="Variant.Filled"
                                        Disabled="true" 
                                        aria-label="Imprimir estudios"
                                        Class="action-button" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Descargar PDF Completo">
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Download" 
                                        Color="Color.Success" 
                                        Size="Size.Small" 
                                        Variant="Variant.Filled"
                                        OnClick="() => ImprimirExpGral(context)"
                                        Disabled="ValidateData || _isDownloading"
                                        Class="action-button" />
                                </MudTooltip>
                                
                                <MudTooltip Text="Seleccionar Estudios para Imprimir">
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Print" 
                                        Color="Color.Error" 
                                        Size="Size.Small" 
                                        Variant="Variant.Filled"
                                        OnClick="() => OpenDialog(context)"
                                        Disabled="ValidateData || _isDownloading"
                                        Class="action-button" />
                                </MudTooltip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color: #9e9e9e;">
                            Sin resultados disponibles
                        </MudText>
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.ShowEstudios)
                {
                    <td colspan="8" style="padding: 20px; background-color: #f8f9fa;">
                        <MudPaper Elevation="1" Class="pa-3" Style="border-radius: 8px;">
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: #0d37a8; font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Size="Size.Small" />
                                Estudios de la Solicitud
                            </MudText>
                            <MudTable 
                                Items="@EstudioDisplayHelper.FiltrarListado(context.Estudios)" 
                                Context="EstContext" 
                                @ref="_table" 
                                T="DtoResponseMedicoPacienteStudios" 
                                Hover="true" 
                                Breakpoint="Breakpoint.Sm" 
                                Elevation="0" 
                                Dense="false" 
                                Striped="true" 
                                Style="width:100%;" 
                                Height="Auto" 
                                Filter="new Func<DtoResponseMedicoPacienteStudios,bool>(FilterFuncEstudios)">
                                <HeaderContent>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-1" Size="Size.Small" />
                                        Estudio
                                    </MudTh>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="mr-1" Size="Size.Small" />
                                        Fecha de Entrega
                                    </MudTh>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" Size="Size.Small" />
                                        Estatus
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Estudio" Style="font-weight: 500;">
                                        @EstContext.Estudio
                                    </MudTd>
                                    <MudTd DataLabel="Fecha de Entrega">
                                        <MudText Typo="Typo.body2">@EstContext.FechaEntrega</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Estatus">
                                        @if (EstContext.EstatusId == EstudioDisplayHelper.EstatusEnviado)
                                        {
                                            <MudChip T="string"
                                                Color="Color.Success" 
                                                Variant="Variant.Filled"
                                                Size="Size.Small">
                                                Liberado
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string"
                                                Color="Color.Warning" 
                                                Variant="Variant.Filled"
                                                Size="Size.Small">
                                                En Proceso
                                            </MudChip>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </td>
                }
            </ChildRowContent>
            
            <LoadingContent>
                <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 300px; padding: 3rem;">
                    <MudProgressCircular 
                        Indeterminate="true" 
                        Size="Size.Large" 
                        Color="Color.Primary"
                        Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
                        Cargando solicitudes...
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #64748b;">
                        Por favor espere mientras se obtienen los resultados
                    </MudText>
                </MudContainer>
            </LoadingContent>
            
            <NoRecordsContent>
                <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 300px; padding: 3rem;">
                    <MudIcon 
                        Icon="@Icons.Material.Filled.SearchOff" 
                        Size="Size.Large" 
                        Class="mb-4" 
                        Style="font-size: 5rem; color: #94a3b8; opacity: 0.7;" />
                    <MudText Typo="Typo.h6" Style="color: #64748b; font-weight: 500;" Class="mb-2">
                        No se encontraron solicitudes
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: #94a3b8;" Class="mb-4" Align="Align.Center">
                        @if (String.IsNullOrWhiteSpace(dtoFiltro.Solicitud) && !dtoFiltro.DateInicial.HasValue && !dtoFiltro.DateFinal.HasValue)
                        {
                            <span>Utilice el formulario de búsqueda para encontrar solicitudes. Puede buscar por número de solicitud, nombre del paciente o rango de fechas.</span>
                        }
                        else
                        {
                            <span>No se encontraron resultados con los criterios de búsqueda ingresados. Intente con otros parámetros.</span>
                        }
                    </MudText>
                    @if (!String.IsNullOrWhiteSpace(dtoFiltro.Solicitud) || dtoFiltro.DateInicial.HasValue || dtoFiltro.DateFinal.HasValue)
                    {
                        <MudButton 
                            Variant="Variant.Outlined" 
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Clear"
                            OnClick="LimpiarFiltros">
                            Limpiar filtros
                        </MudButton>
                    }
                </MudContainer>
            </NoRecordsContent>
            
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

<MudDialog @bind-Visible="visiblePrintResult" Options="diaOptions" Class="print-dialog">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" Size="Size.Medium" />
            Impresión de Resultados
        </MudText>
    </TitleContent>
    
    <DialogContent>
        @if (SolicitudMedicaPrint != null)
        {
            @if (SolicitudMedicaPrint.Estudios == null || !SolicitudMedicaPrint.Estudios.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled">
                    <MudText Typo="Typo.body1" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        No hay estudios disponibles para imprimir con el estatus configurado.
                    </MudText>
                </MudAlert>
            }
            else
            {
                <!-- Patient Information Card -->
                <MudPaper Class="dialog-patient-info" Elevation="1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Paciente
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @SolicitudMedicaPrint.Nombre
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Solicitud
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @SolicitudMedicaPrint.Solicitud
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Fecha Ingreso
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @SolicitudMedicaPrint.Registro
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Edad / Sexo
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @SolicitudMedicaPrint.Edad / @SolicitudMedicaPrint.Sexo
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                
                <MudDivider Class="my-4" />
                
                <!-- Studies Selection Info -->
                <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                        Seleccione los estudios que desea imprimir. Total disponible: <strong>@SolicitudMedicaPrint.Estudios.Count</strong>
                    </MudText>
                </MudAlert>
                
                <!-- Studies Table -->
                <div class="dialog-table-container">
                    <MudTable 
                        MultiSelection="true" 
                        @bind-SelectedItems="selectedItems" 
                        Items="@SolicitudMedicaPrint.Estudios" 
                        Context="EstContext" 
                        @ref="_table" 
                        T="DtoResponseMedicoPacienteStudios" 
                        Hover="true" 
                        Breakpoint="Breakpoint.Sm" 
                        Bordered="true" 
                        Elevation="0" 
                        Striped="true" 
                        Class="dialog-table dialog-studies-table"
                        Dense="true"
                        FixedHeader="true"
                        Height="400px"
                        Filter="new Func<DtoResponseMedicoPacienteStudios,bool>(FilterFuncEstudios)">
                        
                        <HeaderContent>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Science" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Estudio</MudText>
                                </MudStack>
                            </MudTh>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Fecha de Entrega</MudText>
                                </MudStack>
                            </MudTh>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Estatus</MudText>
                                </MudStack>
                            </MudTh>
                        </HeaderContent>
                        
                        <RowTemplate>
                            <MudTd Class="study-name-cell-dialog">@EstContext.Estudio</MudTd>
                            <MudTd>@EstContext.FechaEntrega</MudTd>
                            <MudTd>
                                @if (EstContext.EstatusId == EstudioDisplayHelper.EstatusEnviado)
                                {
                                    <span class="status-badge-liberado">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                        Liberado
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge-proceso">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                        En Proceso
                                    </span>
                                }
                            </MudTd>
                        </RowTemplate>
                        
                        <NoRecordsContent>
                            <MudText Align="Align.Center" Class="py-8">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-3" Style="color: #9e9e9e;" />
                                <br />
                                <MudText Typo="Typo.body2" Style="color: #94a3b8;">No hay estudios disponibles</MudText>
                            </MudText>
                        </NoRecordsContent>
                        
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                        </PagerContent>
                    </MudTable>
                </div>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                <MudText Typo="Typo.body1">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-2" />
                    Error al cargar la información de la solicitud.
                </MudText>
            </MudAlert>
        }
    </DialogContent>
    
    <DialogActions>
        <MudButton 
            OnClick="CancelPrint"
                   Variant="Variant.Filled"
                   Color="@Color.Error" 
            Class="dialog-action-button dialog-button-cancel" 
            Disabled="ValidateDataMod">
            <MudIcon Icon="@Icons.Material.Filled.Close" Class="mr-2" />
            Cancelar
        </MudButton>
        
        @if (SolicitudMedicaPrint != null && SolicitudMedicaPrint.Estudios != null && SolicitudMedicaPrint.Estudios.Any())
        {
            <MudButton 
                OnClick="ImprimirExp" 
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="ValidateDataMod || selectedItems.Count == 0"
                Class="dialog-action-button">
                @if (ValidateDataMod)
                {
                    <MudProgressCircular Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                    <span>Imprimiendo...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
                    <span>Imprimir @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")</span>
                }
            </MudButton>
            
            <MudButton 
                OnClick="SelectAllStudies"
                       Variant="Variant.Filled"
                Color="Color.Info"
                Disabled="ValidateDataMod || selectedItems.Count == SolicitudMedicaPrint.Estudios.Count"
                Class="dialog-action-button">
                <MudIcon Icon="@Icons.Material.Filled.DoneAll" Class="mr-2" />
                Seleccionar Todos
            </MudButton>
            
            <MudButton 
                OnClick="DeselectAllStudies"
                       Variant="Variant.Filled"
                Color="Color.Default"
                Disabled="ValidateDataMod || selectedItems.Count == 0"
                Class="dialog-action-button">
                <MudIcon Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Class="mr-2" />
                Deseleccionar Todos
            </MudButton>
        }
    </DialogActions>
</MudDialog>

