        }
        StateHasChanged();
    }

    void ShowSnack(string message)
    {
        Snackbar.Add($"Atención: {message}", Severity.Error);
    }

    async Task BuscaFecha()
    {
        if (String.IsNullOrEmpty(ValEstudio))
        {
            ShowSnack("¡Por favor Seleccione un Estudio!");
            return;
        }
        
        if (dateFinal < dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha inicial!");
            return;
        }

        ValidateData = true;
        oResulEstudios = new();
        StateHasChanged();

        try
        {
            DtoRequestEstudio parametrobusqueda = new()
            {
                Fecha = new() 
                { 
                    DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), 
                    DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") 
                },
                Buscar = PostRequiere == "1" ? dtoPaciente[0].NombrePaciente : dtoMedicoPaciente.Nombre,
            };

            var ValorEstudioBusqueda = "";
            switch (ValEstudio)
            {
                case "ACIDO URICO":
                    parametrobusqueda.Estudio = new() { 897, 173 };
                    ValorEstudioBusqueda = "_ACUR_SU";
                    break;
                case "COLESTEROL HDL":
                    parametrobusqueda.Estudio = new() { 458 };
                    ValorEstudioBusqueda = "_HDL_SU";
                    break;
                case "COLESTEROL LDL":
                    parametrobusqueda.Estudio = new() { 458 };
                    ValorEstudioBusqueda = "_LDL_SU";
                    break;
                case "COLESTEROL TOTAL":
                    parametrobusqueda.Estudio = new() { 458, 677, 173 };
                    ValorEstudioBusqueda = "_COL_SU";
                    break;
                case "CREATININA":
                    parametrobusqueda.Estudio = new() { 644, 173 };
                    ValorEstudioBusqueda = "_CREA_SU";
                    break;
                case "GLUCOSA":
                    parametrobusqueda.Estudio = new() { 479, 480, 483, 516, 631, 932, 1133, 1183, 1830, 173 };
                    ValorEstudioBusqueda = "_GLU_SU";
                    break;
                case "HEMOGLOBINA GLICOSILADA":
                    parametrobusqueda.Estudio = new() { 486 };
                    ValorEstudioBusqueda = "_HGA1C_ST";
                    break;
                case "TRIGLICERIDOS":
                    parametrobusqueda.Estudio = new() { 49, 173, 458 };
                    ValorEstudioBusqueda = "_TAG_SU";
                    break;
                case "UREA":
                    parametrobusqueda.Estudio = new() { 36, 173 };
                    ValorEstudioBusqueda = "_UREA_SU";
                    break;
                case "HEMOGLOBINA":
                    parametrobusqueda.Estudio = new() { 928 };
                    ValorEstudioBusqueda = "_HB_ST";
                    break;
                case "PLAQUETAS":
                    parametrobusqueda.Estudio = new() { 928 };
                    ValorEstudioBusqueda = "_PLAQ_ST";
                    break;
                case "ANTÍGENO PROSTÁTICO ESPECÍFICO":
                    parametrobusqueda.Estudio = new() { 876 };
                    ValorEstudioBusqueda = "_ANTI_SU";
                    break;
                case "CA125":
                    parametrobusqueda.Estudio = new() { 773 };
                    ValorEstudioBusqueda = "_CA125_SU";
                    break;
                case "ALFA FETO PROTEÍNA":
                    parametrobusqueda.Estudio = new() { 509 };
                    ValorEstudioBusqueda = "_AFP_SU2";
                    break;
                case "ANTÍGENO CARCINOEMBRIONARIO":
                    parametrobusqueda.Estudio = new() { 739 };
                    ValorEstudioBusqueda = "_CEA_SU";
                    break;
                case "CA 19-9":
                    parametrobusqueda.Estudio = new() { 774 };
                    ValorEstudioBusqueda = "_CA199_SU";
                    break;
                case "CA 15.3":
                    parametrobusqueda.Estudio = new() { 389 };
                    ValorEstudioBusqueda = "_CA153_SU";
                    break;
                case "ACIDO VALPROICO SERICO":
                    parametrobusqueda.Estudio = new() { 22 };
                    ValorEstudioBusqueda = "_ACVA_SU";
                    break;
                case "TOPIRAMATO":
                    parametrobusqueda.Estudio = new() { 62 };
                    ValorEstudioBusqueda = "_TOP_SU";
                    break;
                case "KEPPRA (LEVETIRACETAM)":
                    parametrobusqueda.Estudio = new() { 337 };
                    ValorEstudioBusqueda = "_KEPR";
                    break;
                case "CARBAMAZEPINA":
                    parametrobusqueda.Estudio = new() { 761 };
                    ValorEstudioBusqueda = "_CARBA_SU";
                    break;
                case "DIFENILHIDANTOINA (EPAMIN)":
                    parametrobusqueda.Estudio = new() { 614 };
                    ValorEstudioBusqueda = "_DIFE_SU";
                    break;
            }

            var sesPacientes = await Http.PostAsJsonAsync<DtoRequestEstudio>(UrlGraficas, parametrobusqueda);
            
            if (sesPacientes.IsSuccessStatusCode)
            {
                dtoEstudio = await sesPacientes.Content.ReadFromJsonAsync<DtoEstudio>();

                foreach (var item in dtoEstudio.Results)
                {
                    var rowExiste = oResulEstudios.FirstOrDefault(op => op.Fecha.Equals($"20{item.Clave.Substring(0, 2)}-{item.Clave.Substring(2, 2)}-{item.Clave.Substring(4, 2)}"));
                    if (rowExiste == null)
                    {
                        var EstudioTemp = item.Parameters.Where(op => op.Clave.Equals(ValorEstudioBusqueda)).ToList();
                        if (EstudioTemp.Count > 0 && !String.IsNullOrEmpty(EstudioTemp[0].Valor))
                        {
                            string ObtengoNum = Regex.Replace(EstudioTemp[0].Valor, @"[^0-9.]", "");
                            DtoEstudioGrafica tempRes = new()
                            {
                                Fecha = $"20{item.Clave.Substring(0, 2)}-{item.Clave.Substring(2, 2)}-{item.Clave.Substring(4, 2)}",
                                Estudio = ValEstudio,
                                Valor = ObtengoNum
                            };
                            oResulEstudios.Add(tempRes);
                        }
                    }
                }
                
                oResulEstudios = oResulEstudios.OrderByDescending(op => op.Fecha).ToList();
            }
            else
            {
                ShowSnack("Error al obtener los datos. Por favor intente nuevamente.");
            }
        }
        catch (Exception ex)
        {
            ShowSnack($"Error: {ex.Message}");
        }
        finally
        {
            ValidateData = false;
            StateHasChanged();
        }
    }

    private async Task<IEnumerable<string>> SearchEstudio(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return _estudios;

        return _estudios.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    void OnDateChange(DateTime? newDate)
    {
        if (newDate < dateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!");
        }
        dateFinal = newDate;

    }

    #endregion
    
    
}