    private string[] _estudios =
    {
        "GLUCOSA","UREA","CREATININA","ACIDO URICO","COLESTEROL HDL","COLESTEROL LDL","COLESTEROL TOTAL","TRIGLICERIDOS","HEMOGLOBINA GLICOSILADA",
        "HEMOGLOBINA","PLAQUETAS","ANTÍGENO PROSTATICO ESPECÍFICO","CA125","ALFA FETO PROTEÍNA","ANTÍGENO CARINOEMBRIONARIO","CA 19-9","ACIDO VALPROICO SERICO",
        "TOPIRAMATO","KEPPRA (LEVETIRACETAM)","CARBAMAZEPINA","DIFENILHIDANTOINA (EPAMIN)"
    };

    #endregion

    #region Funsiones Página
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            await LoginReturnStore.SavePendingReturnFromFullUriAsync(NavigationManager.Uri);
            NavigationManager.NavigateTo(LoginRedirectHelper.GetLoginPathFromFullUri(NavigationManager.Uri), forceLoad: true);
        }
        else
        {
            if (PostRequiere == "1") //Paciente
            {
                var idenUser = authState.User.Claims.ToList();
                var resDecrip = Cryp.Desencripta(idenUser[0].Value.ToString());
                dtoPaciente = JsonConvert.DeserializeObject<List<DtoPaciente>>(resDecrip);
            }
            else if (PostRequiere == "2")//Medico
            {
                _items = new List<BreadcrumbItem>
                    {
                        new BreadcrumbItem("Home", href: null, icon: Icons.Material.Filled.Home),
                        new BreadcrumbItem("Consulta de Expedientes", href: "/ConsultaExpedientesMedico", icon: Icons.Material.Filled.Badge),
                        new BreadcrumbItem("Gráficas", href: null, icon: Icons.Material.Filled.VerifiedUser,disabled: true),
                    };
                var resPacDecrip = Cryp.Desencripta(PostPaciente);
                dtoMedicoPaciente = JsonConvert.DeserializeObject<DtoResponseMedicoPaciente>(resPacDecrip);
                Sucursal = Http.DefaultRequestHeaders.GetValues("branchid").ToString();
            }
            else if (PostRequiere == "3")//Compañia
            {
                _items = new List<BreadcrumbItem>
                    {
                        new BreadcrumbItem("Home", href: null, icon: Icons.Material.Filled.Home),
                        new BreadcrumbItem("Consulta de Expedientes", href: "/ConsultaExpedientesEmpresa", icon: Icons.Material.Filled.Badge),
                        new BreadcrumbItem("Gráficas", href: null, icon: Icons.Material.Filled.VerifiedUser,disabled: true),
                    };
                var resPacDecrip = Cryp.Desencripta(PostPaciente);
                dtoMedicoPaciente = JsonConvert.DeserializeObject<DtoResponseMedicoPaciente>(resPacDecrip);
            }

            options.Responsive = new List<Responsive<DtoEstudioGrafica>> {
                new Responsive<DtoEstudioGrafica> {
                    Breakpoint=700, Options = new ApexChartOptions<DtoEstudioGrafica> {
                        Chart = new Chart
                        {
                            Toolbar = new Toolbar
                            {
                                Show = true
                            },
                            DropShadow = new DropShadow
                            {
                                Enabled = true,
                                Color = "",
                                Top = 18,
                                Left = 7,
                                Blur = 10,
                                Opacity = 0.2d
                            }
                        },
                        DataLabels = new ApexCharts.DataLabels
                        {
                            OffsetY = -6d
                        },
                        Grid = new Grid
                        {
                            BorderColor = "#e7e7e7",
                            Row = new GridRow
                            {
                                Colors = new List<string> { "#f3f3f3", "transparent" },
                                Opacity = 0.5d
                            }
                        },

                        Colors = new List<string> { "#77B6EA", "#545454" },
                        Markers = new Markers { Shape = ShapeEnum.Circle, Size = 5, FillOpacity = new Opacity(0.8d) },
                        Stroke = new Stroke { Curve = Curve.Smooth },
                        Legend = new Legend
                        {
                            Position = LegendPosition.Top,
                            HorizontalAlign = ApexCharts.Align.Right,
                            Floating = true,
                            OffsetX = -5,
                            OffsetY = -25
                        },

                        //Title = new Title { Text = "Order Net Value"}
                    }

                },
                new Responsive<DtoEstudioGrafica> {
                    Breakpoint=9001, Options = new ApexChartOptions<DtoEstudioGrafica> {
                        Chart = new Chart
                        {
                            Toolbar = new Toolbar
                            {
                                Show = true
                            },
                            DropShadow = new DropShadow
                            {
                                Enabled = true,
                                Color = "",
                                Top = 18,
                                Left = 7,
                                Blur = 10,
                                Opacity = 0.2d
                            }
                        },
                        DataLabels = new ApexCharts.DataLabels
                        {
                            OffsetY = -6d
                        },
                        Grid = new Grid
                        {
                            BorderColor = "#e7e7e7",
                            Row = new GridRow
                            {
                                Colors = new List<string> { "#f3f3f3", "transparent" },
                                Opacity = 0.5d
                            }
                        },

                        Colors = new List<string> { "#77B6EA", "#545454" },
                        Markers = new Markers { Shape = ShapeEnum.Circle, Size = 5, FillOpacity = new Opacity(0.8d) },
                        Stroke = new Stroke { Curve = Curve.Smooth },
                        Legend = new Legend
                        {
                            Position = LegendPosition.Top,
                            HorizontalAlign = ApexCharts.Align.Right,
                            Floating = true,
                            OffsetX = -5,
                            OffsetY = -25
                        },

                        //Title = new Title { Text = "Hola"}
                    }

                }
            };

            // options = new ApexChartOptions<DtoEstudioGrafica>
            //     {
            //         Chart = new Chart
            //         {
            //             Toolbar = new Toolbar
            //             {
            //                 Show = true
            //             },
            //             DropShadow = new DropShadow
            //             {
            //                 Enabled = true,
            //                 Color = "",
            //                 Top = 18,
            //                 Left = 7,
            //                 Blur = 10,
            //                 Opacity = 0.2d
            //             }
            //         },
            //         DataLabels = new ApexCharts.DataLabels
            //         {
            //             OffsetY = -6d
            //         },
            //         Grid = new Grid
            //         {
            //             BorderColor = "#e7e7e7",
            //             Row = new GridRow
            //             {
            //                 Colors = new List<string> { "#f3f3f3", "transparent" },
            //                 Opacity = 0.5d
            //             }
            //         },

            //         Colors = new List<string> { "#77B6EA", "#545454" },
            //         Markers = new Markers { Shape = ShapeEnum.Circle, Size = 5, FillOpacity = new Opacity(0.8d) },
            //         Stroke = new Stroke { Curve = Curve.Smooth },
            //         Legend = new Legend
            //         {
