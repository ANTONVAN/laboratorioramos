@page "/ConsultaGraficaPaciente/{PostRequiere}/{PostPaciente}"
@page "/ConsultaGraficaPacientes/{PostRequiere}/{PostPaciente}"
@using ApexCharts;
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoEstudio;
@using LaboratorioRamos.Data.DtoEstudio.DtoRequestEstudio;
@using LaboratorioRamos.Data.DtoMedico.DtoResponseMedicoPaciente
@using Newtonsoft.Json.Linq
@using System.Text.RegularExpressions
@inject HttpClient Http;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject IJSRuntime IJSRuntime
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler
@inject LoginReturnUrlStore LoginReturnStore


<MudBreadcrumbs Items="_items" Class="mb-2"></MudBreadcrumbs>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-0">
    <MudPaper Class="mt-4" Elevation="4">
        <MudGrid Spacing="2" Class="pa-3 pa-md-4">
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Align="MudBlazor.Align.Center" Class="mb-4" Style="color: #0d37a8; font-weight: 600;">
                    Consulta Gráfica del Paciente
                </MudText>
            </MudItem>
            
            <MudItem xs="12" sm="12" md="6" Class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-2" Style="color: #0d37a8;" />
                <MudText Typo="Typo.body1" Style="color: #0d37a8; font-weight: 500;">
                    Expediente: <span Style="font-weight: 400;">@dtoMedicoPaciente.Expediente</span>
                </MudText>
            </MudItem>
            
            <MudItem xs="12" sm="12" md="6" Class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" Style="color: #0d37a8;" />
                <MudText Typo="Typo.body1" Style="color: #0d37a8; font-weight: 500;">
                    Paciente: <span Style="font-weight: 400;">@dtoMedicoPaciente.Nombre</span>
                </MudText>
            </MudItem>
            
            <MudItem xs="12">
                <MudDivider Class="my-3" />
            </MudItem>
            
            <MudItem xs="12" sm="12" md="12" lg="3">
                <MudAutocomplete T="string" 
                                 @bind-Value="ValEstudio"
                                 SearchFunc="SearchEstudio"
                                 Label="Estudio"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 Disabled="ValidateData"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Science"
                                 Class="full-width" />
            </MudItem>
            
            <MudItem xs="12" sm="6" md="12" lg="3">
                <MudDatePicker Clearable="true" 
                               Label="Fecha Inicio" 
                               Disabled="ValidateData" 
                               Mask="@(new DateMask("dd/MM/yyyy"))" 
                               Elevation="12" 
                               DateFormat="dd/MM/yyyy" 
                               @bind-Date="dateInicial" 
                               PickerVariant="PickerVariant.Dialog" 
                               Color="MudBlazor.Color.Primary" 
                               Margin="Margin.Dense" 
                               DisableToolbar="true" 
                               AutoClose="true" 
                               Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Event"
                               Class="full-width" />
            </MudItem>
            
            <MudItem xs="12" sm="6" md="12" lg="3">
                <MudDatePicker Clearable="true" 
                               Label="Fecha Final" 
                               Disabled="ValidateData" 
                               Mask="@(new DateMask("dd/MM/yyyy"))" 
                               Elevation="12" 
                               DateFormat="dd/MM/yyyy" 
                               @bind-Date="dateFinal" 
                               PickerVariant="PickerVariant.Dialog" 
                               Color="MudBlazor.Color.Primary" 
                               Margin="Margin.Dense" 
                               DisableToolbar="true" 
                               AutoClose="true" 
                               Culture="@CultureInfo.GetCultureInfo("es-MEX")"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Event"
                               Class="full-width" />
            </MudItem>
            
            <MudItem xs="12" sm="12" md="12" lg="3" Class="d-flex align-center" Style="padding-bottom:24px;">
                @if (ValidateData)
                {
                    <MudButton Disabled 
                               ButtonType="ButtonType.Button" 
                               Variant="Variant.Filled" 
                               Color="MudBlazor.Color.Primary" 
                               Class="full-width"
                               Size="MudBlazor.Size.Large">
                        <MudProgressCircular Color="MudBlazor.Color.Default" 
                                            Size="MudBlazor.Size.Small" 
                                            Indeterminate="true" 
                                            Class="mr-2" />
                        Buscando...
                    </MudButton>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" 
                               StartIcon="@Icons.Material.Outlined.Search" 
                               Variant="Variant.Filled" 
                               Color="MudBlazor.Color.Primary" 
                               aria-label="Buscar" 
                               Class="full-width"
                               Size="MudBlazor.Size.Large"
                               OnClick="() => BuscaFecha()">
                        Buscar
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
    
    @if (oResulEstudios.Count > 0)
    {
        <MudPaper Class="pa-3 pa-md-4 mt-4" Elevation="4">
            <MudGrid>
                <MudItem xs="12">
                    @{
                        var titleGrafica = $"Gráfica de Resultados ({ValEstudio})";
                    }
                    <MudText Typo="Typo.h6" Class="mb-3" Style="color: #0d37a8; font-weight: 600;">
                        @titleGrafica
                    </MudText>
                    <ApexChart TItem="DtoEstudioGrafica"
                               Title="@titleGrafica" 
                               Width="@("100%")" 
                               Height="400"
                               Options="@options">
                        <ApexPointSeries TItem="DtoEstudioGrafica"
                                         Items="oResulEstudios"
                                         Name="@ValEstudio"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(e => e.Fecha)"
                                         YAggregate="@(e => e.Sum(e => decimal.Parse(e.Valor)))"
                                         OrderBy="e=>e.X"
                                         ShowDataLabels />
                    </ApexChart>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
    else if (!ValidateData && !string.IsNullOrEmpty(ValEstudio))
    {
        <MudPaper Class="pa-4 mt-4" Elevation="2">
            <MudGrid Justify="Justify.Center" AlignItems="MudBlazor.AlignItems.Center" Style="min-height: 200px;">
                <MudItem xs="12" Class="text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="MudBlazor.Size.Large" Style="color: #757575; font-size: 64px;" />
                    <MudText Typo="Typo.h6" Class="mt-3" Style="color: #757575;">
                        No se encontraron resultados para el estudio seleccionado
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2" Style="color: #9e9e9e;">
                        Intente ajustar el rango de fechas o seleccione otro estudio
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

    
@code {
