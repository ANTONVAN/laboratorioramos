    #region Data Loading Methods
    private async Task LoadExpedientesAsync()
    {
        try
        {
            var parametrobusqueda = BuildSearchParameters();
            string json1 = JsonConvert.SerializeObject(parametrobusqueda);

            var sesExpediente = await Http.PostAsJsonAsync<DtoRequestMedicoPacientes>(URL_PACIENTE, parametrobusqueda);
            var expedienteSuccess = await ApiHandler.HandleResponseAsync<DtoRequestMedicoPacientes>(sesExpediente, "consulta de expedientes", false);

            if (expedienteSuccess && sesExpediente.StatusCode == System.Net.HttpStatusCode.OK)
            {
                var LstExpedientestmp = await sesExpediente.Content.ReadFromJsonAsync<List<DtoResponseMedicoPaciente>>() ?? new List<DtoResponseMedicoPaciente>();

                foreach (var item in LstExpedientestmp)
                {
                    item.RegistroTmp = DateTime.ParseExact(item.Registro, "dd/MM/yyyy", CultureInfo.InvariantCulture);
                    LstExpedientesActuales.Add(item);
                }

                if (PostRequiere == POST_REQUIERE_PACIENTE)
                {
                    await LoadPacienteExpedienteInfo(LstExpedientestmp);
                }

                ApplyFilters(LstExpedientestmp);
                SetSolicitudIds();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando expedientes");
            ApiHandler.ShowErrorMessage($"Error al cargar expedientes: {ex.Message}");
        }
    }

    private DtoRequestMedicoPacientes BuildSearchParameters()
    {
        return new()
        {
            MedicoId = PostRequiere == POST_REQUIERE_MEDICO ? new() { dtoMedico.IdMedico } : new(),
            CompañiaId = PostRequiere == POST_REQUIERE_COMPANIA ? new() { dtoEmpresa.Id } : new(),
            Buscar = PostRequiere == POST_REQUIERE_PACIENTE ? dtoPaciente[0].NombrePaciente.Trim() : $"{dtoMedicoPaciente.Nombre.Trim()} {dtoMedicoPaciente.Apellido.Trim()}",
            TipoFecha = 1,
            Fecha = new(),
            Expediente = null
        };
    }

    private async Task LoadPacienteExpedienteInfo(List<DtoResponseMedicoPaciente> expedientes)
    {
        if (expedientes.Any())
        {
            var infoPacienteResponse = await Http.GetAsync($"{URL_INFO_EXPEDIENTE}{expedientes[0].ExpedienteId}");
            var infoPacienteSuccess = await ApiHandler.HandleResponseAsync<DtoInfoExpediente>(infoPacienteResponse, "consulta de información del expediente del paciente", false);
            if (infoPacienteSuccess)
            {
                dtoInfoExpedientePaciente = await infoPacienteResponse.Content.ReadFromJsonAsync<DtoInfoExpediente>() ?? new DtoInfoExpediente();
                _expedienteMostrar = dtoInfoExpedientePaciente.Expediente;

                _breadcrumbItems = new()
                {
                    new BreadcrumbItem("Home", href: null, icon: Icons.Material.Filled.Home),
                    new BreadcrumbItem($"Consulta de Resultados (Exp: {_expedienteMostrar})", href: null, disabled: true, icon: Icons.Material.Filled.Badge),
                };
            }
        }
    }

    private void ApplyFilters(List<DtoResponseMedicoPaciente> expedientes)
    {
        if (filorig.LstFiltro.Any())
        {
            var obFilter = filorig.LstFiltro.FirstOrDefault(op => op.OriginPage.Trim().Equals("ConsultaResultadosPaciente"));
            if (obFilter?.ExistReg == true)
            {
                dtoFiltro.DateFinal = obFilter.DateFinal;
                dtoFiltro.DateInicial = obFilter.DateInicial;
                dtoFiltro.Solicitud = obFilter.ExpedienteNombreSol;
                _currentPage = int.TryParse(obFilter.PageNo, out var page) ? page : 0;

                UpdateAuthState();
                LstExpedientes = ApplySearchFilters(expedientes);
                filorig.LstFiltro.Where(w => w.OriginPage.Equals("ConsultaResultadosPaciente")).ToList().ForEach(i => i.ExistReg = false);
                return;
            }
        }

        LstExpedientes = expedientes;
    }

    private List<DtoResponseMedicoPaciente> ApplySearchFilters(List<DtoResponseMedicoPaciente> expedientes)
    {
        var isEmptySolicitud = string.IsNullOrEmpty(dtoFiltro.Solicitud);
        var hasInitialDate = dtoFiltro.DateInicial.HasValue;
        var hasFinalDate = dtoFiltro.DateFinal.HasValue;

        if (isEmptySolicitud && !hasInitialDate && !hasFinalDate)
        {
            return expedientes;
        }

        if (!isEmptySolicitud && !hasInitialDate && !hasFinalDate)
        {
            return expedientes.Where(e => e.Solicitud.Contains(dtoFiltro.Solicitud, StringComparison.OrdinalIgnoreCase) || 
                                          e.Nombre.Contains(dtoFiltro.Solicitud, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        if (isEmptySolicitud && hasInitialDate && hasFinalDate)
        {
            return expedientes.Where(e => e.RegistroTmp >= dtoFiltro.DateInicial && e.RegistroTmp <= dtoFiltro.DateFinal).ToList();
        }

        return expedientes;
    }

    private void SetSolicitudIds()
    {
        foreach (var itemExp in LstExpedientes)
        {
            foreach (var itemSol in itemExp.Estudios)
            {
                itemSol.SolicitudId = itemExp.SolicitudId;
            }
        }

        if (_tableO != null)
        {
            _tableO.CurrentPage = _currentPage;
        }
    }

    private async Task UpdateAuthState()
    {
        string json = JsonConvert.SerializeObject(
            PostRequiere == POST_REQUIERE_PACIENTE ? dtoPaciente : 
            PostRequiere == POST_REQUIERE_MEDICO ? dtoMedico : 
            (object)dtoEmpresa
        );
        string filtro = JsonConvert.SerializeObject(filorig);
        
        var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
        await cusAuthStateProvider.UpdAuthenticationState(new DtoUserProvider
        {
            filtros = Cryp.Encripta(filtro),
            testsuncretr = Cryp.Encripta(json),
            Type = PostRequiere == POST_REQUIERE_PACIENTE ? 1 : PostRequiere == POST_REQUIERE_MEDICO ? 2 : 3,
        });
    }
