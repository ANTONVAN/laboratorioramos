@code {
    #region Constants
    private const string URL_USUARIO = "services/gateway/api/ClinicResults/getList";
    private const string URL_PACIENTE = "services/gateway/api/deliveryResults/GetAllCaptureResults";
    private const string URL_INFO_EXPEDIENTE = "services/gateway/api/MedicalRecord/";
    private const string URL_SOLICITUDES_BY_EXPEDIENTE = "services/gateway/api/MedicalRecord/requests/";
    
    private const string CONFIG_ID_IMPRESION_KEY = "IdImpresion";
    private const string POST_REQUIERE_PACIENTE = "1";
    private const string POST_REQUIERE_MEDICO = "2";
    private const string POST_REQUIERE_COMPANIA = "3";
    
    private const int ESTATUS_LIBERADO_7 = 7;
    private const int ESTATUS_LIBERADO_6 = 6;
    private const int ESTATUS_LIBERADO_12 = 12;
    #endregion

    #region Fields
    private readonly DtoFiltro dtoFiltro = new();
    private DtoFiltroNavega filorig = new();
    
    private List<DtoPaciente> dtoPaciente = new();
    private DtoInfoExpediente dtoMedicoPaciente = new();
    private DtoInfoExpediente dtoInfoExpedientePaciente = new();
    private List<DtoSolicitudesForExpediente> dtoSolicitudesForExpediente = new();
    private DtoMedicoPwd dtoMedico = new();
    private DtoEmpresa dtoEmpresa = new();
    
    private List<DtoResponseMedicoPaciente> LstExpedientes = new();
    private List<DtoResponseMedicoPaciente> LstExpedientesActuales = new();
    private List<int> LstEstatusPrint = new();
    private HashSet<DtoResponseMedicoPacienteStudios> selectedItems = new();
    
    private MudTable<DtoResponseMedicoPacienteStudios>? _table;
    private MudTable<DtoResponseMedicoPaciente>? _tableO;
    private readonly PDFGenerator _pdfGenerator = new();
    
    private bool _isLoading = true;
    private bool _isPrinting = false;
    private bool _showPatientInfo = false;
    private bool _visiblePrintResult = false;
    
    private DtoResponseMedicoPaciente? _solicitudMedicaPrint;
    private string _expedienteMostrar = string.Empty;
    private int _currentPage = 0;
    private string _sucursal = string.Empty;
    private string resDecrip = string.Empty;
    
    private List<BreadcrumbItem> _breadcrumbItems = new();
    
    private readonly DialogOptions _dialogOptions = new() 
    { 
        BackgroundClass = "print-dialog-backdrop", 
        BackdropClick = true, 
        MaxWidth = MaxWidth.Large, 
        FullWidth = true,
        CloseButton = true
    };
    #endregion

    #region Properties
    [Parameter] public string PostRequiere { get; set; } = string.Empty;
    [Parameter] public string PostPaciente { get; set; } = string.Empty;
    #endregion

    #region Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
            Logger.LogInformation("Inicializando ConsultaResultadosPaciente - PostRequiere: {PostRequiere}", PostRequiere);

            var authState = await _authStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/", true);
                return;
            }

            await InitializeDataAsync(authState);
            _isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en OnInitializedoften");
            ApiHandler.ShowErrorMessage($"Error al inicializar: {ex.Message}");
            _isLoading = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
    #endregion

    #region Initialization Methods
    private async Task InitializeDataAsync(AuthenticationState authState)
    {
        LoadConfiguration();
        LoadUserClaims(authState);
        
        if (PostRequiere == POST_REQUIERE_PACIENTE)
        {
            await InitializePacienteAsync();
        }
        else if (PostRequiere == POST_REQUIERE_MEDICO)
        {
            await InitializeMedicoAsync();
        }
        else if (PostRequiere == POST_REQUIERE_COMPANIA)
        {
            await InitializeCompaniaAsync();
        }
        
        await LoadExpedientesAsync();
    }

    private void LoadConfiguration()
    {
        var estatusSep = _config.GetSection(CONFIG_ID_IMPRESION_KEY).Value?.Trim().Split(",") ?? Array.Empty<string>();
        foreach (var itemST in estatusSep)
        {
            if (int.TryParse(itemST, out var statusId))
            {
                LstEstatusPrint.Add(statusId);
            }
        }

        _sucursal = ((string[])Http.DefaultRequestHeaders.GetValues("branchid"))[0];
    }

    private void LoadUserClaims(AuthenticationState authState)
    {
        var idenUser = authState.User.Claims.ToList();
        resDecrip = Cryp.Desencripta(idenUser[0].Value.ToString());
    }

    private async Task InitializePacienteAsync()
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var idenUser = authState.User.Claims.ToList();
        var filtros = Cryp.Desencripta(idenUser[1].Value.ToString());

        filorig = JsonConvert.DeserializeObject<DtoFiltroNavega>(filtros) ?? new DtoFiltroNavega();
        dtoPaciente = JsonConvert.DeserializeObject<List<DtoPaciente>>(resDecrip) ?? new List<DtoPaciente>();
        _showPatientInfo = true;
    }

    private async Task InitializeMedicoAsync()
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var idenUser = authState.User.Claims.ToList();
        var filtros = Cryp.Desencripta(idenUser[1].Value.ToString());

        filorig = JsonConvert.DeserializeObject<DtoFiltroNavega>(filtros) ?? new DtoFiltroNavega();
