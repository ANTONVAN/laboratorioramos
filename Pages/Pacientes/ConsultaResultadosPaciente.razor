    async Task BuscaFecha()
    {
        dataLoaded = true;
        DtoRequestMedicoPacientes parametrobusqueda = new();

        try
        {
            if (PostRequiere == "1") //Paciente
            {
                parametrobusqueda = new()
                    {
                        MedicoId = new(),
                        CompañiaId = new(),
                        Buscar = PostRequiere == "1" ? searchString1 == 0 ? dtoPaciente[0].NombrePaciente.Trim() : searchString1.ToString() : dtoMedicoPaciente.Nombre.Trim(),
                        TipoFecha = 1,
                        Fecha = searchString1==0 ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                    };

            }
            else if (PostRequiere == "2")//Medico
            {
                parametrobusqueda = new()
                    {
                        MedicoId = new(),
                        CompañiaId = new(),
                        Buscar = PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim() : searchString1 == 0 ? dtoMedicoPaciente.Nombre.Trim() : searchString1.ToString(),
                        TipoFecha = 1,
                        Fecha = searchString1 == 0 ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                    };
            }
            else if (PostRequiere == "3")//Compañia
            {
                parametrobusqueda = new()
                    {
                        MedicoId = new(),
                        CompañiaId = new(),
                        Buscar = PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim() : searchString1 == 0 ? dtoMedicoPaciente.Nombre.Trim() : searchString1.ToString(),
                        TipoFecha = 1,
                        Fecha = searchString1 == 0 ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                    };
            }


            var sesExpediente = await Http.PostAsJsonAsync<DtoRequestMedicoPacientes>(UrlPaciente, parametrobusqueda);

            switch (sesExpediente.StatusCode)
            {
                case System.Net.HttpStatusCode.OK:
                    try
                    {
                        LstExpedientes = await sesExpediente.Content.ReadFromJsonAsync<List<DtoResponseMedicoPaciente>>();
                        if (LstExpedientes[0].Nombre.Trim().ToUpper().Equals(PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim().ToUpper() : dtoMedicoPaciente.Nombre.Trim().ToUpper()))
                        {
                            foreach (var itemExp in LstExpedientes)
                            {
                                foreach (var itemSol in itemExp.Estudios)
                                {
                                    itemSol.SolicitudId = itemExp.SolicitudId;
                                }
                            }
                        }
                        else
                        {
                            LstExpedientes = new();
                        }

                    }
                    catch (Exception ex)
                    {
                        //ValidateData = false;
                    }


                    break;
            }


            //_picker.Close();
            dataLoaded = false;
        }
        catch (Exception ex)
        {
            var t = "";
        }
        
        StateHasChanged();

    }
    #endregion
    

