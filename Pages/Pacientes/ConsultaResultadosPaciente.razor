    #region Search Methods
    private async Task BuscarExpedientesAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            if (!ValidateSearchInput())
            {
                return;
            }

            LstExpedientes.Clear();
            
            if (string.IsNullOrEmpty(dtoFiltro.Solicitud))
            {
                LstExpedientes = LstExpedientesActuales.ToList();
            }
            else
            {
                LstExpedientes = LstExpedientesActuales
                    .Where(e => e.Solicitud.Contains(dtoFiltro.Solicitud, StringComparison.OrdinalIgnoreCase) || 
                                e.Nombre.Contains(dtoFiltro.Solicitud, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            foreach (var itemExp in LstExpedientes)
            {
                foreach (var itemSol in itemExp.Estudios)
                {
                    itemSol.SolicitudId = itemExp.SolicitudId;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en búsqueda de expedientes");
            ApiHandler.ShowErrorMessage($"Error al buscar: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private bool ValidateSearchInput()
    {
        if (!string.IsNullOrEmpty(dtoFiltro.DateInicial?.ToString()) && string.IsNullOrEmpty(dtoFiltro.DateFinal?.ToString()))
        {
            ApiHandler.ShowWarningMessage("Por favor ingrese la fecha final");
            return false;
        }

        if (string.IsNullOrEmpty(dtoFiltro.DateInicial?.ToString()) && !string.IsNullOrEmpty(dtoFiltro.DateFinal?.ToString()))
        {
            ApiHandler.ShowWarningMessage("Por favor ingrese la fecha inicial");
            return false;
        }

        if (dtoFiltro.DateFinal < dtoFiltro.DateInicial)
        {
            ApiHandler.ShowErrorMessage("La fecha final no puede ser menor a la fecha inicial");
            return false;
        }

        return true;
    }
