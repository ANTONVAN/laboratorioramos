            Registro=itemSolicitud.Registro,
            Saldo=itemSolicitud.Saldo,
            SaldoPendiente=itemSolicitud.SaldoPendiente,
            Sexo=itemSolicitud.Sexo,
            ShowEstudios=itemSolicitud.ShowEstudios,
            Solicitud=itemSolicitud.Solicitud,
