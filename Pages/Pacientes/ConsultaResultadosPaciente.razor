    async Task BuscaFecha()
    {
        //dataLoaded = true;
        ValidateData = true;
        LstExpedientes.Clear();
        DtoRequestMedicoPacientes parametrobusqueda = new();

        try
        {
            if (dtoFiltro.DateFinal < dtoFiltro.DateInicial)
            {
                ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!", 4);
            }
            else if (String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.Solicitud))
            {
                ShowSnack("¡Por favor Ingresa Fecha Inicial, Fecha Final y/o Expediente o Nombre del Paciente!", 4);
            }
            else if (!String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.Solicitud))
            {
                ShowSnack("¡Por favor Ingresa Fecha Final!", 4);
            }
            else if (String.IsNullOrEmpty(dtoFiltro.DateInicial.ToString()) && !String.IsNullOrEmpty(dtoFiltro.DateFinal.ToString()) && String.IsNullOrEmpty(dtoFiltro.Solicitud))
            {
                ShowSnack("¡Por favor Ingresa Fecha Inicial", 4);
            }
            else
            {
                if (PostRequiere == "1") //Paciente
                {
                    parametrobusqueda = new()
                        {
                            MedicoId = new(),
                            CompañiaId = new(),
                            Buscar = PostRequiere == "1" ? String.IsNullOrEmpty(dtoFiltro.Solicitud) ? dtoPaciente[0].NombrePaciente.Trim() : dtoFiltro.Solicitud.ToString() : dtoMedicoPaciente.Nombre.Trim(),
                            TipoFecha = 1,
                            Fecha = String.IsNullOrEmpty(dtoFiltro.Solicitud) ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                        };

                }
                else if (PostRequiere == "2")//Medico
                {
                    parametrobusqueda = new()
                        {
                            MedicoId = new(),
                            CompañiaId = new(),
                            Buscar = PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim() : String.IsNullOrEmpty(dtoFiltro.Solicitud.ToString()) ? dtoMedicoPaciente.Nombre.Trim() : dtoFiltro.Solicitud.ToString(),
                            TipoFecha = 1,
                            Fecha = String.IsNullOrEmpty(dtoFiltro.Solicitud.ToString()) ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                        };
                }
                else if (PostRequiere == "3")//Compañia
                {
                    parametrobusqueda = new()
                        {
                            MedicoId = new(),
                            CompañiaId = new(),
                            Buscar = PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim() : String.IsNullOrEmpty(dtoFiltro.Solicitud.ToString()) ? dtoMedicoPaciente.Nombre.Trim() : dtoFiltro.Solicitud.ToString().ToString(),
                            TipoFecha = 1,
                            Fecha = String.IsNullOrEmpty(dtoFiltro.Solicitud.ToString()) ? new() { DateTime.Parse(dateInicial.ToString()).ToString("yyyy-MM-dd"), DateTime.Parse(dateFinal.ToString()).ToString("yyyy-MM-dd") } : new() { }
                        };
                }

                Http.DefaultRequestHeaders.Remove("branchid");
                Http.DefaultRequestHeaders.Add("branchid", Sucursal);
                var sesExpediente = await Http.PostAsJsonAsync<DtoRequestMedicoPacientes>(UrlPaciente, parametrobusqueda);

                switch (sesExpediente.StatusCode)
                {
                    case System.Net.HttpStatusCode.OK:
                        try
                        {
                            LstExpedientes = await sesExpediente.Content.ReadFromJsonAsync<List<DtoResponseMedicoPaciente>>();
                            if (LstExpedientes[0].Nombre.Trim().ToUpper().Equals(PostRequiere == "1" ? dtoPaciente[0].NombrePaciente.Trim().ToUpper() : dtoMedicoPaciente.Nombre.Trim().ToUpper()))
                            {
                                foreach (var itemExp in LstExpedientes)
