    #region Navigation Methods
    private async Task NavigationResultado(DtoResponseMedicoPaciente args, DtoResponseMedicoPacienteStudios? estudio)
    {
        try
        {
            var nopag = _tableO?.CurrentPage ?? 0;
            var obFilters = filorig.LstFiltro.FirstOrDefault(op => op.OriginPage.Trim().Equals("ConsultaResultadosPaciente"));

            if (obFilters != null)
            {
                obFilters.PageNo = nopag.ToString();
                obFilters.ExpedienteNombreSol = dtoFiltro.Solicitud;
                obFilters.DateInicial = dtoFiltro.DateInicial;
                obFilters.DateFinal = dtoFiltro.DateFinal;
                obFilters.ExistReg = true;
            }
            else
            {
                DtoFiltroLst newFilter = new()
                {
                    OriginPage = "ConsultaResultadosPaciente",
                    PageNo = nopag.ToString(),
                    ExpedienteNombreSol = dtoFiltro.Solicitud,
                    DateInicial = dtoFiltro.DateInicial,
                    DateFinal = dtoFiltro.DateFinal,
                    ExistReg = true
                };
                filorig.LstFiltro.Add(newFilter);
            }

            await UpdateAuthState();

            string jsonSoli = JsonConvert.SerializeObject(args.Solicitud);
            string jsonEstudio = JsonConvert.SerializeObject(estudio);
            string jsonPaciente = JsonConvert.SerializeObject(dtoMedicoPaciente);

            string encryptedParam = Cryp.Encripta(estudio == null 
                ? $"{jsonSoli}!{null}!{(dtoMedicoPaciente.Nombre != null ? jsonPaciente : null)}!ConsultaResultadosPaciente" 
                : $"{jsonSoli}!{jsonEstudio}!{(dtoMedicoPaciente.Nombre != null ? jsonPaciente : null)}!ConsultaResultadosPaciente");

            NavigationManager.NavigateTo($"ResultadoEstudios/{PostRequiere}/{encryptedParam}", false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en navegación a resultados");
            ApiHandler.ShowErrorMessage($"Error al navegar: {ex.Message}");
        }
    }
    #endregion
