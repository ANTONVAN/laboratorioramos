</style>


@code {

    #region Declaración de variables

    [Inject]
    IDialogService DialogService { get; set; }

    [Parameter]
    public string PostRequiere { get; set; }
    [Parameter]
    public string PostPaciente { get; set; }
    public string resDecrip { get; set; }

    private List<DtoPaciente> dtoPaciente = new();
    private DtoFiltro dtoFiltro = new();
    private DtoResponseMedicoPaciente dtoMedicoPaciente = new();
    private DtoMedicoPwd dtoMedico = new();
    private List<DtoResponseMedicoPaciente> LstExpedientes = new();
    private List<int> LstEstatusPrint = new();
    private DtoResponseMedicoPaciente SolicitudMedicaPrint = new();

    [RegularExpression("^[0-9]*$", ErrorMessage = "Solo se permiten números")]
    private string searchString1;
    private string searchEstudios = "";
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "#", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Consulta de Resultados", href: null, disabled: true, icon: Icons.Material.Filled.Badge),
    };

    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private MudDateRangePicker _picker = new();
    private HashSet<DtoResponseMedicoPacienteStudios> selectedItems = new HashSet<DtoResponseMedicoPacienteStudios>();
    private IEnumerable<DtoEstudioExpediente> Elements = new List<DtoEstudioExpediente>();
    private bool _selectOnRowClick = true;
    private MudTable<DtoResponseMedicoPacienteStudios> _table;
    private PDFGenerator _PdfGenerator = new();
    private bool ValidateData = false;
    private bool ValidateDataMod = false;
    private bool ShowNombre = false;

    private bool dataLoaded = true;

    private string UrlUsuario = "services/records/api/ClinicResults/getList";
    private string UrlPaciente = "services/records/api/MassSearch/GetAllCaptureResults";
    private string UrlImprimeResultados = "services/records/api/ClinicResults/printResultFile";

    DateTime? dateInicial = DateTime.Today;
    DateTime? dateFinal = DateTime.Today;
    private string Sucursal = "";

    private bool visiblePrintResult = false;


    private readonly DialogOptions diaOptions = new() { BackgroundClass = "my-custom-class", BackdropClick = true, MaxWidth = MaxWidth.Large, FullWidth = true };

    #endregion

    #region Funsiones Página
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //AuthenticationState authState = await _authStateProvider.GetAuthenticationStateAsync();
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/", true);
        }
        else
        {

            try
            {

                var estatusSep = _config.GetSection("IdImpresion").Value.Trim().Split(",");
                Sucursal = ((string[])Http.DefaultRequestHeaders.GetValues("branchid"))[0];
                foreach (var itemST in estatusSep)
                {
                    LstEstatusPrint.Add(int.Parse(itemST));
                }
                if (PostRequiere == "1") //Paciente
                {
                    var idenUser = authState.User.Claims.ToList();
                    var resDecrip = Cryp.Desencripta(idenUser[0].Value.ToString());
                    dtoPaciente = JsonConvert.DeserializeObject<List<DtoPaciente>>(resDecrip);
                }
                else if (PostRequiere == "2")//Medico
                {
                    var idenUser = authState.User.Claims.ToList();
                    var resDecrip = Cryp.Desencripta(idenUser[0].Value.ToString());
                    dtoMedico = JsonConvert.DeserializeObject<DtoMedicoPwd>(resDecrip);
                    _items = new List<BreadcrumbItem>
                    {
                        new BreadcrumbItem("Home", href: "ConsultaExpedientesMedico", icon: Icons.Material.Filled.Home),
                        new BreadcrumbItem("Consulta de Expedientes", href: "#ConsultaExpedientesMedico", icon: Icons.Material.Filled.Badge,disabled:false),
                        new BreadcrumbItem("Consulta de Resultados", href: null, icon: Icons.Material.Filled.VerifiedUser,disabled: true),
                    };
                    var resPacDecrip = Cryp.Desencripta(PostPaciente);
                    dtoMedicoPaciente = JsonConvert.DeserializeObject<DtoResponseMedicoPaciente>(resPacDecrip);
                    ShowNombre = true;

