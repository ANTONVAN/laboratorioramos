@page "/ConsultaResultadosPaciente/{PostRequiere}/{PostPaciente}"

@using LaboratorioRamos.Data.DtoEmpresa
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoFiltro
@using LaboratorioRamos.Data.DtoExpediente
@using LaboratorioRamos.Data.DtoExpediente.DtoRequestExpedientes
@using LaboratorioRamos.Data.DtoMedico.DtoRequestMedicoPacientes
@using LaboratorioRamos.Data.DtoMedico.DtoResponseMedicoPaciente
@using LaboratorioRamos.Data.DtoImpresionResultados
@using LaboratorioRamos.Data.DtoStateProvider
@using LaboratorioRamos.PDF
@using Microsoft.AspNetCore.Mvc
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider
@inject Cryp Cryp
@inject ISnackbar Snackbar
@inject IJSRuntime IJSRuntime
@inject IConfiguration _config
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler
@inject IDialogService DialogService
@inject ILogger<ConsultaResultadosPaciente> Logger

<PageTitle>Consulta de Resultados - Laboratorio Ramos</PageTitle>

<div class="results-page-container">
    <!-- Breadcrumbs -->
    <MudBreadcrumbs Items="_breadcrumbItems">
        <MudBreadcrumbsItem>
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
        </MudBreadcrumbsItem>
    </MudBreadcrumbs>

    <!-- Patient Information Card -->
    @if (_showPatientInfo)
    {
        <MudPaper Class="patient-info-card" Elevation="3">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Nombre del Paciente
                    </MudText>
                    <MudText Typo="Typo.h6" Class="info-value">
                        @GetPatientName()
                    </MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Género
                    </MudText>
                    <MudText Typo="Typo.h6" Class="info-value">
                        @GetPatientGender()
                    </MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Fecha de Nacimiento
                    </MudText>
                    <MudText Typo="Typo.h6" Class="info-value">
                        @GetPatientBirthDate()
                    </MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Edad
                    </MudText>
                    <MudText Typo="Typo.h6" Class="info-value">
                        @GetPatientAge()
                    </MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Correo Electrónico
                    </MudText>
                    <MudText Typo="Typo.body1" Class="info-secondary">
                        @GetPatientEmail()
                    </MudText>
                </MudItem>
                
                <MudItem xs="12" sm="6" md="3" class="py-2">
                    <MudText Typo="Typo.caption" Class="info-label mb-1">
                        Teléfono
                    </MudText>
                    <MudText Typo="Typo.body1" Class="info-secondary">
                        @GetPatientPhone()
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <!-- Search Container -->
    <MudPaper Class="search-container" Elevation="3">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: #0d37a8; font-weight: 700;">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
            Buscar Resultados
        </MudText>
        
        <EditForm Model="@dtoFiltro" OnValidSubmit="BuscarExpedientesAsync">
            <MudGrid>
                <MudItem xs="12" sm="12" md="10" lg="11">
                    <MudTextField 
                        @bind-Value="dtoFiltro.Solicitud" 
                        Label="Número de Solicitud"
                        HelperText="Ingrese el número de solicitud (máximo 12 dígitos)"
                        Disabled="_isLoading"
                        Clearable="true"
                        Variant="Variant.Outlined"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search"
                        MaxLength="12"
                        UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" } })" />
                </MudItem>
                
                <MudItem xs="12" sm="12" md="2" lg="1" class="d-flex align-center" Style="padding-bottom:24px;">
                    <MudButton 
                        ButtonType="ButtonType.Submit"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        FullWidth="true"
                        Disabled="_isLoading"
                        Class="search-button">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudText Typo="Typo.button">Buscar</MudText>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>

    <!-- Results Table Container -->
    <MudPaper Class="table-container" Elevation="3">
        <!-- Header Section with Badge -->
        <div class="results-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="results-header-content">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Class="results-header-icon" Size="Size.Medium" />
                    <MudText Typo="Typo.h6" Class="results-header-title">
                        Resultados de Búsqueda
                    </MudText>
                </MudStack>
                <MudChip 
                    T="string"
                    Size="Size.Small" 
                    Variant="Variant.Filled"
                    Class="results-count-badge">
                    @LstExpedientes.Count @(LstExpedientes.Count == 1 ? "expediente encontrado" : "expedientes encontrados")
                </MudChip>
            </MudStack>
        </div>
        
        <MudTable 
            @ref="_tableO"
            Items="@LstExpedientes.OrderByDescending(x => x.Registro)" 
            Breakpoint="Breakpoint.Sm" 
            Dense="true" 
            Hover="true" 
            Striped="true"
            Loading="_isLoading"
            FixedHeader="true"
            Height="100%"
            Class="results-table">
            
            <ColGroup>
                <col style="width: 50px;" />
                <col style="width: 150px;" />
                <col style="width: 120px;" />
                <col />
                <col style="width: 180px;" />
            </ColGroup>
            
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Work" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Número de Solicitud</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Fecha de Ingreso</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Sucursal</MudText>
                    </MudStack>
                </MudTh>
                <MudTh Style="color: #0d37a8; font-weight: 700; text-align: center;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                        <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Acciones</MudText>
                    </MudStack>
                </MudTh>
            </HeaderContent>
            
            <RowTemplate Context="context">
                <!-- Expansion Button -->
                <MudTd Style="text-align: center;">
                    <MudTooltip Text="@(context.ShowEstudios ? "Ocultar estudios" : "Ver estudios")">
                        @if (context.ShowEstudios)
                        {
                            <MudIconButton 
                                Icon="@Icons.Material.Filled.ExpandMore" 
                                Size="Size.Small" 
                                Color="Color.Primary" 
                                OnClick="@(() => ToggleEstudios(context.Solicitud))"
                                Class="expand-button"
                                aria-label="@(context.ShowEstudios ? "Ocultar estudios" : "Ver estudios")" />
                        }
                        else
                        {
                            <MudIconButton 
                                Icon="@Icons.Material.Filled.ChevronRight" 
                                Size="Size.Small" 
                                Color="Color.Primary" 
                                OnClick="@(() => ToggleEstudios(context.Solicitud))"
                                Class="expand-button"
                                aria-label="@(context.ShowEstudios ? "Ocultar estudios" : "Ver estudios")" />
                        }
                    </MudTooltip>
                </MudTd>
                
                <!-- Solicitud as Chip -->
                <MudTd>
                    <MudTooltip Text="@($"Ver detalles de la solicitud {context.Solicitud}")">
                        <MudChip 
                            T="string"
                            Color="Color.Default"
                            Variant="Variant.Filled"
                            Size="Size.Small"
                            Class="solicitud-chip"
                            OnClick="@(() => NavigationResultado(context, null))">
                            @context.Solicitud
                        </MudChip>
                    </MudTooltip>
                </MudTd>
                
                <MudTd>
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Registro
                    </MudText>
                </MudTd>
                <MudTd Class="sucursal-cell">
                    <MudText Typo="Typo.body2" Style="font-weight: 500; color: #424242;">
                        @context.Sucursal
                    </MudText>
                </MudTd>
                
                <!-- Action Buttons -->
                <MudTd Style="text-align: center;">
                    @{
                        var availableStudies = context.Estudios.Count(e => IsEstatusLiberado(e.EstatusId));
                    }
                    
                    @if (availableStudies > 0)
                    {
                        <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                            <MudTooltip Text="@($"Ver detalles de la solicitud {context.Solicitud}")">
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Visibility" 
                                    Color="Color.Primary" 
                                    Size="Size.Small" 
                                    Variant="Variant.Filled"
                                    OnClick="@(() => NavigationResultado(context, null))"
                                    Disabled="_isLoading"
                                    Class="action-button action-button-view" />
                            </MudTooltip>
                            
                            <MudTooltip Text="Descargar PDF Completo">
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Download" 
                                    Color="Color.Success" 
                                    Size="Size.Small" 
                                    Variant="Variant.Filled"
                                    OnClick="() => DownloadPDF(context)"
                                    Disabled="_isLoading"
                                    Class="action-button" />
                            </MudTooltip>
                            
                            <MudTooltip Text="Seleccionar Estudios para Imprimir">
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Print" 
                                    Color="Color.Error" 
                                    Size="Size.Small" 
                                    Variant="Variant.Filled"
                                    OnClick="() => OpenPrintDialog(context)"
                                    Disabled="_isLoading"
                                    Class="action-button" />
                            </MudTooltip>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color: #9e9e9e;">
                            Sin resultados disponibles
                        </MudText>
                    }
                </MudTd>
            </RowTemplate>
            
            <!-- Child Row (Estudios) -->
            <ChildRowContent>
                @if (context.ShowEstudios)
                {
                    <td colspan="5" class="py-4">
                        <MudPaper Class="studies-nested-table" Elevation="2">
                            <MudTable 
                                Items="@context.Estudios" 
                                Context="estudio"
                                T="DtoResponseMedicoPacienteStudios"
                                Hover="true" 
                                Striped="true"
                                Dense="true"
                                Elevation="0">
                                
                                <HeaderContent>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Science" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                            <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">Estudio</MudText>
                                        </MudStack>
                                    </MudTh>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                            <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">Fecha de Entrega</MudText>
                                        </MudStack>
                                    </MudTh>
                                    <MudTh Style="color: #0d37a8; font-weight: 600;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                            <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 600;">Estatus</MudText>
                                        </MudStack>
                                    </MudTh>
                                </HeaderContent>
                                
                                <RowTemplate>
                                    <MudTd Class="study-name-cell">@estudio.Estudio</MudTd>
                                    <MudTd>@estudio.FechaEntrega</MudTd>
                                    <MudTd>
                                        @if (IsEstatusLiberado(estudio.EstatusId))
                                        {
                                            <span class="status-badge-liberado">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                                Liberado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge-proceso">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                                En Proceso
                                            </span>
                                        }
                                    </MudTd>
                                </RowTemplate>
                                
                                <NoRecordsContent>
                                    <MudText Align="Align.Center" Class="py-4">No hay estudios registrados</MudText>
                                </NoRecordsContent>
                            </MudTable>
                        </MudPaper>
                    </td>
                }
            </ChildRowContent>
            
            <LoadingContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <br />
                    <MudText Typo="Typo.body2" Class="mt-3">Cargando resultados...</MudText>
                </MudText>
            </LoadingContent>
            
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-3" Style="color: #9e9e9e;" />
                    <br />
                    <MudText Typo="Typo.h6" Style="color: #64748b;">Sin registros para mostrar</MudText>
                    <MudText Typo="Typo.body2" Style="color: #94a3b8;">
                        Utilice el formulario de búsqueda para encontrar resultados
                    </MudText>
                </MudText>
            </NoRecordsContent>
            
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</div>

<!-- Print Dialog -->
<MudDialog @bind-Visible="_visiblePrintResult" Options="_dialogOptions" Class="print-dialog">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" Size="Size.Medium" />
            Impresión de Resultados
        </MudText>
    </TitleContent>
    
    <DialogContent>
        @if (_solicitudMedicaPrint != null)
        {
            @if (_solicitudMedicaPrint.Estudios == null || !_solicitudMedicaPrint.Estudios.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled">
                    <MudText Typo="Typo.body1" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        No hay estudios disponibles para imprimir con el estatus configurado.
                    </MudText>
                </MudAlert>
            }
            else
            {
                <!-- Patient Information Card -->
                <MudPaper Class="dialog-patient-info" Elevation="1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Paciente
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @_solicitudMedicaPrint.Nombre
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Solicitud
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @_solicitudMedicaPrint.Solicitud
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Fecha Ingreso
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @_solicitudMedicaPrint.Registro
                            </MudText>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Class="info-label-small mb-1">
                                Edad / Sexo
                            </MudText>
                            <MudText Typo="Typo.body1" Class="info-value-small">
                                @_solicitudMedicaPrint.Edad / @_solicitudMedicaPrint.Sexo
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                
                <MudDivider Class="my-4" />
                
                <!-- Studies Selection Info -->
                <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                        Seleccione los estudios que desea imprimir. Total disponible: <strong>@_solicitudMedicaPrint.Estudios.Count</strong>
                    </MudText>
                </MudAlert>
                
                <!-- Studies Table -->
                <div class="dialog-table-container">
                    <MudTable 
                        MultiSelection="true" 
                        @bind-SelectedItems="selectedItems" 
                        Items="@_solicitudMedicaPrint.Estudios" 
                        Context="EstContext" 
                        @ref="_table" 
                        T="DtoResponseMedicoPacienteStudios" 
                        Hover="true" 
                        Breakpoint="Breakpoint.Sm" 
                        Bordered="true" 
                        Elevation="0" 
                        Striped="true" 
                        Class="dialog-table dialog-studies-table"
                        Dense="true"
                        FixedHeader="true"
                        Height="400px">
                        
                        <HeaderContent>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Science" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Estudio</MudText>
                                </MudStack>
                            </MudTh>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Fecha de Entrega</MudText>
                                </MudStack>
                            </MudTh>
                            <MudTh Style="color: #0d37a8; font-weight: 700;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="table-header-icon" Size="Size.Small" Style="color: #0d37a8;" />
                                    <MudText Typo="Typo.body2" Style="color: #0d37a8; font-weight: 700;">Estatus</MudText>
                                </MudStack>
                            </MudTh>
                        </HeaderContent>
                        
                        <RowTemplate>
                            <MudTd Class="study-name-cell-dialog">@EstContext.Estudio</MudTd>
                            <MudTd>@EstContext.FechaEntrega</MudTd>
                            <MudTd>
                                @if (IsEstatusLiberado(EstContext.EstatusId))
                                {
                                    <span class="status-badge-liberado">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                        Liberado
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge-proceso">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                        En Proceso
                                    </span>
                                }
                            </MudTd>
                        </RowTemplate>
                        
                        <NoRecordsContent>
                            <MudText Align="Align.Center" Class="py-8">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-3" Style="color: #9e9e9e;" />
                                <br />
                                <MudText Typo="Typo.body2" Style="color: #94a3b8;">No hay estudios disponibles</MudText>
                            </MudText>
                        </NoRecordsContent>
                        
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                        </PagerContent>
                    </MudTable>
                </div>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                <MudText Typo="Typo.body1">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-2" />
                    Error al cargar la información de la solicitud.
                </MudText>
            </MudAlert>
        }
    </DialogContent>
    
    <DialogActions>
        <MudButton 
            OnClick="CancelPrintDialog" 
             Variant="Variant.Filled"
                   Color="@Color.Error" 
            Class="dialog-action-button dialog-button-cancel" 
            Disabled="_isPrinting">
            <MudIcon Icon="@Icons.Material.Filled.Close" Class="mr-2" />
            Cancelar
        </MudButton>
        
        @if (_solicitudMedicaPrint != null && _solicitudMedicaPrint.Estudios != null && _solicitudMedicaPrint.Estudios.Any())
        {
            <MudButton 
                OnClick="PrintSelectedStudies" 
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="_isPrinting || selectedItems.Count == 0"
                Class="dialog-action-button">
                @if (_isPrinting)
                {
                    <MudProgressCircular Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
                    <span>Imprimiendo...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
                    <span>Imprimir @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")</span>
                }
            </MudButton>
            
            <MudButton 
                OnClick="SelectAllStudies" 
                Variant="Variant.Filled"
