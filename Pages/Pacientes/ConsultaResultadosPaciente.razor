<MudDialog @bind-Visible="visiblePrintResult" Options="diaOptions">
    <TitleContent>
        <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center">
            <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Error" Class="mr-3" Size="Size.Large" />Impresión de Resultados
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="12" md="12">
                <MudText Typo="Typo.h6" Align="Align.Center">Paciente: <k>@SolicitudMedicaPrint.Nombre</k></MudText>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudText Typo="Typo.h6">Solicitud: @SolicitudMedicaPrint.Solicitud</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudText Typo="Typo.h6">Fecha Ingreso: @SolicitudMedicaPrint.Registro</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudText Typo="Typo.h6">Sexo: @SolicitudMedicaPrint.Sexo</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudText Typo="Typo.h6">Edad: @SolicitudMedicaPrint.Edad</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" md="12" Class="d-flex d-sm-none d-none d-sm-flex d-md-none">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" aria-label="Buscar" Class="ml-auto" OnClick="@SelAllRog">Seleccionar Todos</MudButton>
            </MudItem>
            <MudItem xs="12" sm="12" md="12">
                <MudTable MultiSelection="true" @bind-SelectedItems="selectedItems" Items="@SolicitudMedicaPrint.Estudios" Context="EstContext" @ref="_table" T="DtoResponseMedicoPacienteStudios" Hover="true" Breakpoint="Breakpoint.Sm" Bordered="true" Elevation="1" Striped="true" HeaderClass="table-head-bordered" Style="width:100%;" Dense="true" Filter="new Func<DtoResponseMedicoPacienteStudios,bool>(FilterFuncEstudios)">
                    <HeaderContent>
                        <MudTh>Estudio</MudTh>
                        <MudTh>Fecha de Entrega</MudTh>
                        <MudTh>Estatus</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nombre">@EstContext.Estudio</MudTd>
                        <MudTd DataLabel="Fecha de Entrega">@EstContext.FechaEntrega</MudTd>
                        <MudTd DataLabel="Estatus">@EstContext.Estatus</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            </MudItem>

        </MudGrid>

    </DialogContent>
    <DialogActions>
        @if (ValidateDataMod)
        {
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Default" Class="ml-auto"><MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" /></MudButton>
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Print" aria-label="Imprimir" Color="Color.Error" OnClick="ImprimirExp"></MudIconButton>
        }
        <MudIconButton Icon="@Icons.Material.Filled.Cancel" aria-label="Cancelar" Color="Color.Error" OnClick="CancelPrint"></MudIconButton>
    </DialogActions>
</MudDialog>

<style>
    .mud-input-input-control {
        align-items: normal;
