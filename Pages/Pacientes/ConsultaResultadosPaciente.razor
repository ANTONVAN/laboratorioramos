    void ShowSnack(string message, int sev)
    {
        switch (sev)
        {
            case 0:
                Snackbar.Add($"Atención: {message}", Severity.Normal);
                break;
            case 1:
                Snackbar.Add($"Atención: {message}", Severity.Info);
                break;
            case 2:
                Snackbar.Add($"Atención: {message}", Severity.Success);
                break;
            case 3:
                Snackbar.Add($"Atención: {message}", Severity.Warning);
                break;
            case 4:
                Snackbar.Add($"Atención: {message}", Severity.Error);
                break;

        }

    }


    void OnDateChange(DateTime? newDate)
    {
        if (newDate < dtoFiltro.DateInicial)
        {
            ShowSnack("¡La Fecha Final no puede ser menor a la fecha incial!", 4);
        }
        dtoFiltro.DateFinal = newDate;

    }

