@layout LabRamosLayout
@page "/Medico"
@using LaboratorioRamos.Data.DtoFiltro
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoMedico
@using LaboratorioRamos.Data.DtoPaciente.DtoRequestPaciente
@using LaboratorioRamos.Data.DtoStateProvider
@inject HttpClient Http;
@inject IConfiguration _config;
@inject AuthenticationStateProvider _authStateProvider
@inject NavigationManager NavigationManager
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler

<PageTitle>Login</PageTitle>


<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="7" md="12" Class="d-flex absolute justify-center" style="top:15%;">
        <EditForm Model="@dtoLoginMedico" OnValidSubmit="OnValidSubmitAsync" style="width: 500px;">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" md="12" sm="12">
                    <MudCard>
                        <MudCardMedia Image="Images/LogotipoWeb.png" Height="175" />
                        <MudCardContent>
                            <MudTextField Label="Usuario" HelperText="Max. 16 dígitos"
                                          @bind-Value="dtoLoginMedico.Usuario" For="@(() => dtoLoginMedico.Usuario)" MaxLength="16" />
                            <MudTextField Label="Contraseña" HelperText="Máx. 8 dígitos" Class="mt-3"
                                          @bind-Value="dtoLoginMedico.Contraseña" For="@(() => dtoLoginMedico.Contraseña)" InputType="InputType.Password" MaxLength="32" />
                        </MudCardContent>
                        <MudCardActions>
                            @if (ValidateData)
                            {
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Default" Class="rounded-0 ml-auto"><MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" /></MudButton>
                            }
                            else
                            {
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-0 ml-auto">Ingresar</MudButton>
                            }

                        </MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="7" md="12" style="text-align: center;">
                    <MudLink Href="#" Typo="Typo.body2" Align="Align.Center">Manual de Usuario</MudLink>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudItem>
</MudGrid>


@code {
    #region Declaracion de Variables y Objetos
    private DtoLoginMedico dtoLogin = new();
    private DtoLoginMedico dtoLoginMedico = new();
    private List<DtoMedico> dtoMedico = new();
    private DtoMedicoPwd dtoMedicoPWD = new();
    private DtoFiltroNavega filorig = new();

    private bool ValidateData = false;
    private string UrlAuth = "services/identity/api/profile/login";
    private string UrlMedico = "services/catalogo/api/Medic/";
    #endregion

    #region Funcionalidad Página
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    void ShowSnack(string message)
    {
        Snackbar.Add($"Atención: {message}", Severity.Warning);
    }

    private void ClearAuthHeaders()
    {
        Http.DefaultRequestHeaders.Remove("Authorization");
        Http.DefaultRequestHeaders.Remove("branchid");
    }

    #endregion

    #region Operaciones
    private async Task OnValidSubmitAsync(EditContext context)
    {
        if (context is null) return;
        
        ValidateData = true;
        filorig.LstFiltro = new();
        
        var generalUser = _config.GetSection("UsrLoginGral:User").Value;
        var generalPassword = _config.GetSection("UsrLoginGral:Pwd").Value;
        
        if (string.IsNullOrWhiteSpace(generalUser) || string.IsNullOrWhiteSpace(generalPassword))
        {
            ApiHandler.ShowErrorMessage("Configuración de usuario general no encontrada");
            ValidateData = false;
            return;
        }
        
        dtoLogin = new()
        {
            Usuario = generalUser,
            Contraseña = generalPassword,
        };

        try
        {
            // Autenticación inicial
            using var authResponse = await Http.PostAsJsonAsync<DtoLoginMedico>(UrlAuth, dtoLogin);
            
            // Limpiar headers previos
            Http.DefaultRequestHeaders.Remove("Authorization");
            Http.DefaultRequestHeaders.Remove("branchid");

            // Manejar respuesta de autenticación
            var authSuccess = await ApiHandler.HandleResponseAsync<DtoLoginMedico>(authResponse, "autenticación",false);
            
            if (authSuccess && authResponse.IsSuccessStatusCode)
            {
                var result = await authResponse.Content.ReadFromJsonAsync<DtoUserSession>();
                if (result?.Token is null)
                {
                    ApiHandler.ShowErrorMessage("Token de autenticación no recibido");
                    ValidateData = false;
                    return;
                }
                
                Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {result.Token}");

                // Obtener datos del médico
                using var medicoResponse = await Http.GetAsync($"{UrlMedico}all/{dtoLoginMedico.Usuario}");
                var medicoSuccess = await ApiHandler.HandleResponseAsync<List<DtoMedico>>(medicoResponse, "consulta de médico",false);
                
                if (medicoSuccess && medicoResponse.IsSuccessStatusCode)
                {
                    dtoMedico = await medicoResponse.Content.ReadFromJsonAsync<List<DtoMedico>>() ?? new List<DtoMedico>();
                    
                    if (!dtoMedico.Any())
                    {
                        ClearAuthHeaders();
                        ApiHandler.ShowWarningMessage("¡El Médico no existe, favor de verificar!");
                        ValidateData = false;
                        return;
                    }
                    
                    var realMedico = dtoMedico.FirstOrDefault(op => 
                        string.Equals(op.Clave?.Trim(), dtoLoginMedico.Usuario?.Trim(), StringComparison.OrdinalIgnoreCase));
                    
                    if (realMedico is null)
                    {
                        ClearAuthHeaders();
                        ApiHandler.ShowWarningMessage("¡Clave de médico no encontrada!");
                        ValidateData = false;
                        return;
                    }
                    
                    // Verificar contraseña del médico
                    using var pwdResponse = await Http.GetAsync($"{UrlMedico}{realMedico.IdMedico}");
                    var pwdSuccess = await ApiHandler.HandleResponseAsync<DtoMedicoPwd>(pwdResponse, "verificación de contraseña",false);
                    
                    if (pwdSuccess && pwdResponse.IsSuccessStatusCode)
                    {
                        dtoMedicoPWD = await pwdResponse.Content.ReadFromJsonAsync<DtoMedicoPwd>();
                        dtoMedicoPWD.Password ??= "00";

                        if (!string.Equals(dtoMedicoPWD.Password.Trim(), dtoLoginMedico.Contraseña?.Trim(), StringComparison.Ordinal))
                        {
                            ClearAuthHeaders();
                            ApiHandler.ShowWarningMessage("¡La Contraseña es incorrecta, favor de verificar!");
                            ValidateData = false;
                        }
                        else
                        {
                            // Login exitoso
                            dtoMedicoPWD.Token = result.Token;
                            dtoMedicoPWD.Sucursal = result.Sucursal;
                            string json = JsonConvert.SerializeObject(dtoMedicoPWD);
                            string filtro = JsonConvert.SerializeObject(filorig);
                            
                            var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
                            await cusAuthStateProvider.UpdAuthenticationState(new DtoUserProvider
                            {
                                filtros = Cryp.Encripta(filtro),
                                testsuncretr = Cryp.Encripta(json),
                                Type = 2,
                            });
                            
                            Http.DefaultRequestHeaders.Add("branchid", result.Sucursal.ToString());
                            ApiHandler.ShowSuccessMessage("¡Login exitoso! Bienvenido médico.");
                            NavigationManager.NavigateTo("/ConsultaExpedientesMedico/", true);
                            ValidateData = false;
                        }
                    }
                    else
                    {
                        ClearAuthHeaders();
                        ApiHandler.ShowErrorMessage("Error al consultar los datos del médico");
                        ValidateData = false;
                    }
                }
                else
                {
                    ClearAuthHeaders();
                    ApiHandler.ShowErrorMessage("Error en la autenticación");
                    ValidateData = false;
                }
            }
            else
            {
                ClearAuthHeaders();
                ApiHandler.ShowErrorMessage("Error en la autenticación inicial");
                ValidateData = false;
            }
        }
        catch (HttpRequestException ex)
        {
            ClearAuthHeaders();
            ApiHandler.ShowErrorMessage($"Error de conexión: {ex.Message}");
            ValidateData = false;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            ClearAuthHeaders();
            ApiHandler.ShowErrorMessage("Tiempo de espera agotado. Intente nuevamente.");
            ValidateData = false;
        }
        catch (Exception ex)
        {
            ClearAuthHeaders();
            ApiHandler.ShowErrorMessage($"Error inesperado durante el login: {ex.Message}");
            ValidateData = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
    #endregion

}