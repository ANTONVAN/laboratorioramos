@layout LabRamosLayout
@page "/"
@using LaboratorioRamos.Data.DtoDetalleExpedienteSolicitud
@using LaboratorioRamos.Data.DtoFiltro
@using LaboratorioRamos.Data.DtoPaciente
@using LaboratorioRamos.Data.DtoPaciente.DtoRequestPaciente
@using LaboratorioRamos.Data.DtoStateProvider
@inject HttpClient Http;
@inject IConfiguration _config;
@inject AuthenticationStateProvider _authStateProvider
@inject NavigationManager NavigationManager
@inject Cryp Cryp;
@inject ISnackbar Snackbar
@inject LaboratorioRamos.Services.IApiResponseHandler ApiHandler

<PageTitle>Login</PageTitle>


<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="7" md="12" Class="d-flex absolute justify-center" style="top:15%;">
        <EditForm Model="@dtoLoginPaciente" OnValidSubmit="OnValidSubmitAsync" style="width: 500px;">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" md="12" sm="12">
                    <MudCard>
                        <MudCardMedia Image="Images/LogotipoWeb.png" Height="175" />
                        <MudCardContent>
                            <MudTextField Label="Expediente" HelperText="Max. 16 dígitos"
                                          @bind-Value="dtoLoginPaciente.Usuario" For="@(() => dtoLoginPaciente.Usuario)" MaxLength="16" />
                            <MudTextField Label="Código" HelperText="Máx. 8 dígitos" Class="mt-3"
                                          @bind-Value="dtoLoginPaciente.Contraseña" For="@(() => dtoLoginPaciente.Contraseña)" InputType="InputType.Password" MaxLength="16" />
                        </MudCardContent>
                        <MudCardActions>
                            @if (ValidateData)
                            {
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Default" Disabled Class="rounded-0 ml-auto"><MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" /></MudButton>
                            }
                            else
                            {
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-0 ml-auto">Ingresar</MudButton>
                            }
                            
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="7" md="12" style="text-align: center;">
                    <MudLink Href="#" Typo="Typo.body2" Align="Align.Center">Manual de Usuario</MudLink>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudItem>
</MudGrid>


@code{
    #region Declaracion de Variables y Objetos
    private DtoLogin dtoLogin = new();
    private DtoLogin dtoLoginPaciente = new();
    private List<DtoPaciente> dtoPaciente = new();
    private List<DtoDetalleExpedienteSolicitud> dtoDetalleExpedienteSol = new();
    private DtoRequestPaciente dtoEequestPaciente = new();
    private bool ValidateData = false;
    private string UrlAuth = "services/identity/api/profile/login";
    private string UrlUsuario = "services/gateway/api/MedicalRecord/now";
    private DtoFiltroNavega filorig = new();
    #endregion

    #region Funcionalidad Página
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    void ShowSnack(string message)
    {
        Snackbar.Add($"Atención: {message}", Severity.Warning);
    }

    private void ClearAuthHeaders()
    {
        Http.DefaultRequestHeaders.Remove("Authorization");
        Http.DefaultRequestHeaders.Remove("branchid");
    }

    #endregion

    #region Operaciones
    private async Task OnValidSubmitAsync(EditContext context)
    {
        if (context is null) return;
        
        ValidateData = true;
        filorig.LstFiltro = new();
        
        var generalUser = _config.GetSection("UsrLoginGral:User").Value;
        var generalPassword = _config.GetSection("UsrLoginGral:Pwd").Value;
        
        if (string.IsNullOrWhiteSpace(generalUser) || string.IsNullOrWhiteSpace(generalPassword))
        {
            ApiHandler.ShowErrorMessage("Configuración de usuario general no encontrada");
            ValidateData = false;
            return;
        }
        
        dtoLogin = new()
        {
            Usuario = generalUser,
            Contraseña = generalPassword,
        };
        
        try
        {
            // Autenticación inicial
            using var authResponse = await Http.PostAsJsonAsync<DtoLogin>(UrlAuth, dtoLogin);
            
            // Limpiar headers previos
            Http.DefaultRequestHeaders.Remove("Authorization");
            Http.DefaultRequestHeaders.Remove("branchid");

            // Manejar respuesta de autenticación
            var authSuccess = await ApiHandler.HandleResponseAsync<DtoLogin>(authResponse, "autenticación",false);
            
            if (authSuccess && authResponse.IsSuccessStatusCode)
            {
                var result = await authResponse.Content.ReadFromJsonAsync<DtoUserSession>();
                if (result?.Token is null)
                {
                    ApiHandler.ShowErrorMessage("Token de autenticación no recibido");
                    ValidateData = false;
                    return;
                }
                
                dtoEequestPaciente = new()
                {
                    Expediente = dtoLoginPaciente.Usuario
                };
                Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {result.Token}");

                // Consulta de datos del paciente
                var sesPaciente = await Http.PostAsJsonAsync<DtoRequestPaciente>(UrlUsuario, dtoEequestPaciente);
                var pacienteSuccess = await ApiHandler.HandleResponseAsync<DtoRequestPaciente>(sesPaciente, "consulta de paciente",false);
                
                if (pacienteSuccess && sesPaciente.StatusCode == System.Net.HttpStatusCode.OK)
                {
                    dtoPaciente = await sesPaciente.Content.ReadFromJsonAsync<List<DtoPaciente>>();
                    
                    if (dtoPaciente.Count > 0)
                    {
                        var exispas = dtoPaciente.FirstOrDefault(op => op.Expediente.Equals(dtoLoginPaciente.Usuario));
                        if (exispas != null)
                        {
                            Http.DefaultRequestHeaders.Add("branchid", result.Sucursal.ToString());
                            
                            // Consulta de solicitudes del paciente
                            var solicitudesResponse = await Http.GetAsync($"services/gateway/api/MedicalRecord/requests/{exispas.Id}");
                            var solicitudesSuccess = await ApiHandler.HandleResponseAsync<List<DtoDetalleExpedienteSolicitud>>(solicitudesResponse, "consulta de solicitudes",false);
                            
                            if (solicitudesSuccess)
                            {
                                dtoDetalleExpedienteSol = await solicitudesResponse.Content.ReadFromJsonAsync<List<DtoDetalleExpedienteSolicitud>>();
                                var regpas = dtoDetalleExpedienteSol.FirstOrDefault(op => op.Clave.Equals(dtoLoginPaciente.Contraseña));
                                
                                if (regpas != null)
                                {
                                    // Login exitoso
                                    dtoPaciente[0].Token = result.Token;
                                    string json = JsonConvert.SerializeObject(dtoPaciente);
                                    string filtro = JsonConvert.SerializeObject(filorig);
                                    
                                    var cusAuthStateProvider = (AuthStateProvider)_authStateProvider;
                                    await cusAuthStateProvider.UpdAuthenticationState(new DtoUserProvider
                                        {
                                            filtros = Cryp.Encripta(filtro),
                                            testsuncretr = Cryp.Encripta(json),
                                            Type = 1
                                        });

                                    ApiHandler.ShowSuccessMessage("¡Login exitoso! Bienvenido paciente.");
                                    NavigationManager.NavigateTo("/ConsultaResultadosPaciente/1/0", true);
                                }
                                else
                                {
                                    Http.DefaultRequestHeaders.Remove("Authorization");
                                    Http.DefaultRequestHeaders.Remove("branchid");
                                    ApiHandler.ShowWarningMessage("¡El Código es incorrecto, favor de verificar!");
                                }
                            }
                            ValidateData = false;
                        }
                        else
                        {
                            Http.DefaultRequestHeaders.Remove("Authorization");
                            Http.DefaultRequestHeaders.Remove("branchid");
                            ApiHandler.ShowWarningMessage("¡El Expediente no existe, favor de verificar!");
                            ValidateData = false;
                        }
                    }
                    else
                    {
                        Http.DefaultRequestHeaders.Remove("Authorization");
                        Http.DefaultRequestHeaders.Remove("branchid");
                        ApiHandler.ShowWarningMessage("¡El Paciente no existe, favor de verificar!");
                        ValidateData = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            ApiHandler.ShowErrorMessage($"Error inesperado durante el login: {ex.Message}");
            ValidateData = false;
        }
        StateHasChanged();
    }
    #endregion
	
}