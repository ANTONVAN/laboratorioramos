                                <TitleContent>
                                    <div class="d-flex" style="color:#1d2223;">
                                        @{
                                            var nombreCaptura = String.IsNullOrEmpty(item.SucursalCaptura) ? "" : $"(Capturado en: {item.SucursalCaptura})";
                                        }
                                        <MudText Align="Align.Justify" Typo="Typo.subtitle2"><MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" class="mr-3"></MudIcon>&nbsp;@item.Clave-<strong>@item.Nombre</strong> @nombreCaptura</MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
