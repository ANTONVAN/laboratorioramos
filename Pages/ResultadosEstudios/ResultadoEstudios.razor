                                            else
                                            {
                                                //js.InvokeVoidAsync("DownloadPDF", "Estudio.pdf", Convert.ToBase64String(archivo.ToArray()));
                                                <!-- Componente para mostrar PDF con las mejores prácticas de UX/UI -->
                                                <MudContainer Class="pa-4" Style="min-height: 600px;">
                                                    <MudPaper Class="pa-4" Elevation="8" Style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                                                        

                                                        <!-- Contenedor del PDF con diseño responsivo -->
                                                        <MudPaper Class="pa-2" Elevation="4" Style="border-radius: 8px; background: white;">
                                                            <div class="pdf-container"
                                                                 style="width: 100%; height: 500px; border: 1px solid #e0e0e0; border-radius: 4px; position: relative; overflow: hidden;">

                                                                <!-- Indicador de carga -->
                                                                <div id="pdf-loading-@item.Id" class="d-flex align-center justify-center"
                                                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.9); z-index: 10;">
                                                                    <div class="text-center">
                                                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
                                                                        <MudText Typo="Typo.body1" Color="Color.Primary">
                                                                            Cargando documento...
                                                                        </MudText>
                                                                    </div>
                                                                </div>

                                                                <!-- Visor de PDF -->
                                                                @{
                                                                    var nomIfremae = $"pdf-iframe-{item.Id}";
                                                                }
                                                                <MudItem xs="12" sm="7" md="12" id="@nomIfremae" Style="height:100%;">

                                                                </MudItem>

                                                                
                                                                @{
                                                                    // await Task.Delay(1200);
                                                                    _PdfGenerator.ViewPDFResultados(IJSRuntime, nomIfremae, item.PdfBase64);
                                                                }
                                                                
                                                               @*  @if (!string.IsNullOrEmpty(item.PdfBase64) && item.PdfBase64.Length > 0)
                                                                {
                                                                    <iframe id="pdf-iframe-@item.Id"
                                                                            style="width: 100%; height: 100%; border: none; display: none;"
                                                                            title="Resultado del estudio @item.Clave - @item.Nombre"
                                                                            onload="hidePdfLoading('@item.Id')"
                                                                            onerror="showPdfError('@item.Id')"
                                                                            src="data:application/pdf;base64,@item.PdfBase64">
                                                                    </iframe>
                                                                }
                                                                else
                                                                {
                                                                    <!-- Mostrar mensaje cuando no hay PDF -->
                                                                    <div class="d-flex align-center justify-center" style="height: 100%;">
                                                                        <div class="text-center">
                                                                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
                                                                            <MudText Typo="Typo.body1" Color="Color.Secondary">
                                                                                PDF no disponible
                                                                            </MudText>
                                                                        </div>
                                                                    </div>
                                                                } *@
                                                                <!-- Mensaje de error si falla la carga -->
                                                                <div id="pdf-error-@item.Id" class="d-flex align-center justify-center"
                                                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: white; display: none; z-index: 10;">
                                                                    <div class="pa-4 text-center">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Error"
                                                                                 Color="Color.Error"
                                                                                 Size="Size.Large"
                                                                                 Class="mb-3" />
                                                                        <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-2">
                                                                            Error al cargar el documento
                                                                        </MudText>
                                                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                                                            No se pudo mostrar el PDF. Intenta descargarlo.
                                                                        </MudText>
                                                                        <MudButton StartIcon="@Icons.Material.Filled.Download"
                                                                                   Color="Color.Primary"
                                                                                   Variant="Variant.Outlined"
                                                                                   OnClick="@(() => DownloadPdf(item.PdfBase64, $"{item.Clave}_{item.Nombre}"))">
                                                                            Descargar PDF
                                                                        </MudButton>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </MudPaper>

                                                        <!-- Información adicional -->
                                                        <MudGrid Class="mt-3">
                                                            <MudItem xs="12">
                                                                <MudAlert Severity="Severity.Info"
                                                                          StartIcon="@Icons.Material.Filled.Info"
                                                                          Class="mt-2"
                                                                          Style="border-radius: 8px;">
                                                                    <div class="d-flex align-center">
                                                                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-2" Size="Size.Small" />
                                                                        <MudText Typo="Typo.body2">
                                                                            <strong>Consejo:</strong> Puedes usar los controles del visor para hacer zoom, desplazarte por el documento o verlo en pantalla completa.
                                                                        </MudText>
                                                                    </div>
                                                                </MudAlert>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudPaper>
                                                </MudContainer>

                                            }

                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            }
                            else
                            {
                                <!-- Mensaje mejorado cuando no hay estudios -->
                                <MudExpansionPanel Class="mt-2" Dense="false" Gutters="false" Expanded="true" HideIcon="true">
                                    <TitleContent>
                                        <div class="d-flex align-center" style="color:#1d2223;">
                                            <MudText Align="Align.Justify" Typo="Typo.subtitle2">
                                                <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Color="Color.Info" />
