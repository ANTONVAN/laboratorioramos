            Por favor espere mientras se obtienen los resultados
        </MudText>
    </MudContainer>

}
else
{
    <MudPaper Class="pa-4" Elevation="4" Style="width:100%;">
        <MudGrid>
            @* <MudItem xs="12" sm="12" md="4" Style="padding-top: 12px;"> *@
            <MudItem xs="12" sm="12" md="4">
                <MudText Align="Align.Left" Typo="Typo.body1" style="color: #66686c;"><b style="color: #0d37a8;">Solicitud: @LstExpedientes[0].Solicitud</b>&nbsp;&nbsp;<b style="font-size:small;">Registro: @LstExpedientes[0].Registro</b></MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="6" Style="padding-top: 12px;"> *@
            <MudItem xs="12" sm="6" md="6">
                <MudText Align="Align.Left" Typo="Typo.body1">
                    @{
                        if (LstExpedientes[0].Sexo == "Masculino")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Man2" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Woman2" Color="Color.Secondary" />
                        }
                    }
                    &nbsp;<b>@LstExpedientes[0].Nombre</b>

                </MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="2" Style="padding-top: 12px;"> *@
            <MudItem xs="12" sm="6" md="2">
                <MudText Align="Align.Center" Typo="Typo.body1">
                    Edad: <b>@LstExpedientes[0].Edad&nbsp;años</b>
                </MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="4" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="4">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Primary" />&nbsp;<b>Médico:</b>&nbsp; @dtoMedicoSolicitud.Nombre&nbsp;@dtoMedicoSolicitud.PrimerApellido&nbsp;@dtoMedicoSolicitud.SegundoApellido </MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="3" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="3">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />&nbsp;<b>Compañia:</b> &nbsp; @LstExpedientes[0].Compania</MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="3" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="3">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.FolderShared" Color="Color.Primary" />&nbsp;<b>Expediente:</b> &nbsp; @LstExpedientes[0].Expediente</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                &nbsp;
            </MudItem>
            @* <MudItem xs="12" sm="6" md="2" Style="padding-top: 0px; text-align:right;">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.StackedBarChart" OnClick="OpenDialogGrafica">Ver Gráfica</MudButton>
            </MudItem> *@


            @* <MudItem xs="12" sm="6" md="4" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="4">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />&nbsp;<b>Fecha Nac.:</b> &nbsp; @LstExpedientes[0].FechaNacimiento</MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="3" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="3">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Primary" />&nbsp;<b>Teléfono:</b> &nbsp; @LstExpedientes[0].Telefono</MudText>
            </MudItem>
            @* <MudItem xs="12" sm="6" md="3" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="6" md="3">
                <MudText Align="Align.Justify" Typo="Typo.body1"><MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Color="Color.Primary" />&nbsp;<b>Celular:</b> &nbsp; @LstExpedientes[0].EnvioWhatsapp</MudText>
            </MudItem>
            @* <MudItem xs="12" sm="3" md="2" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="3" md="2">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="patient-action-buttons">
                    @{
                        if (dtoResultadosEstudios.Estudios.Count > 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Download" Color="Color.Primary" Size="Size.Medium" aria-label="Imprimir Estudios" OnClick="() => ImprimirExpGral(LstExpedientes[0])"></MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Outlined.Print" Color="Color.Error" Size="Size.Medium" aria-label="Imprimir Estudios" OnClick="() => OpenDialog(LstExpedientes[0])"></MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.BarChart" Size="Size.Medium" Color="Color.Info" OnClick="OpenDialogGrafica"></MudIconButton>
                        }
                        else
                        {
                            <MudTooltip Text="Ver Reporte" Placement="Placement.Left">
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.BarChart" 
                                    Color="Color.Info" 
                                    Variant="Variant.Filled"
                                    OnClick="OpenDialogGrafica"
                                               Size="Size.Small"
                                               Class="action-button-square action-button-report"
                                    aria-label="Ver reporte" />
                            </MudTooltip>
                        }
                    }
                </MudStack>
            </MudItem>
            @* <MudItem xs="12" sm="3" md="1" Style="padding-top: 0px;"> *@
            <MudItem xs="12" sm="3" md="1">

            </MudItem>
        </MudGrid>
    </MudPaper>
    <!-- Contenedor de resultados con altura fija y scroll -->
    <MudPaper Class="pa-1 mt-1" Elevation="4" Style="width:100%; height: calc(110vh - 280px); min-height: 400px; max-height: 800px;">
        <MudGrid Style="height: 100%;">
            <MudItem xs="12" sm="12" md="12" Style="height: 100%;">
                <div class="results-container">
                    <MudExpansionPanels MultiExpansion="true" Class="results-expansion-panels">
                        @if (edenDataLoaded)
                        {
                            <MudExpansionPanel Class="mt-2" Dense="false" Gutters="false" Expanded="true" HideIcon="true">
                                <TitleContent>
                                    <div class="d-flex" style="color:#1d2223;">
                                        <MudText Align="Align.Justify" Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Class="mr-2" Color="Color.Primary" />
                                            <strong>Resultados Imagenología</strong>
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Class="d-flex d-sm-flex mt-2" Style="padding-left: 35px;">
                                        <MudItem xs="12" sm="12" md="12" Style="text-align:center; padding: 40px;">
                                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                                            <MudText Typo="Typo.body1" Class="mt-3" Align="Align.Center">
                                                Cargando resultados de imagenología...
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                        else if (_dtoEdenImagenologia?.Count > 0)
                        {
                            <MudExpansionPanel Class="mt-2" Dense="false" Gutters="false" Expanded="true" HideIcon="true">
                                <TitleContent>
                                    <div class="d-flex" style="color:#1d2223;">
                                        <MudText Align="Align.Justify" Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Class="mr-2" Color="Color.Primary" />
                                            <strong>Resultados Imagenología</strong>
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Class="d-flex d-sm-flex mt-2" Style="padding-left: 35px;">
                                        <MudTable Class="rounded-0 pt-1" Items="@_dtoEdenImagenologia" Breakpoint="Breakpoint.Sm" Dense="true" Hover="true" Striped="true" Elevation="4" Style="width:98%;" FixedHeader="true" FixedFooter="false">
                                            <ColGroup>
                                                @* <col />
                                                <col /> *@
                                                <col />
                                            </ColGroup>
                                            <HeaderContent>
                                                @* <MudTh Style="color:#921313">Estudio</MudTh> *@
                                                @* <MudTh Style="color:#921313">Ver PDF</MudTh> *@
                                                <MudTh Style="color:#921313">Ver y Imagen e Interpretación</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                @* <MudTd DataLabel="Estudio">@context.management_study.modality.identifier - @context.management_study.name</MudTd> 
                                                @if (!String.IsNullOrEmpty(context.pdf_url))
                                                {
                                                    <MudTd DataLabel="Ver PDF">
                                                        <a target="_blank" href="@context.pdf_url"><MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Color="Color.Warning"></MudIconButton></a>
                                                    </MudTd>
                                                }
                                                else
                                                {
                                                    <MudTd DataLabel="Ver PDF">
                                                    </MudTd>
                                                }*@

                                                @if (!String.IsNullOrEmpty(context.url))
                                                {
                                                    <MudTd DataLabel="Gráfica">
                                                        <a target="_blank" href="@context.url">@context.TypeImage<MudIconButton Icon="@Icons.Material.Filled.PictureInPicture" Size="Size.Small" Color="Color.Info"></MudIconButton></a>
                                                    </MudTd>
                                                }
                                                else
                                                {
                                                    <MudTd DataLabel="Ver Imagen">
                                                    </MudTd>
                                                }
                                            </RowTemplate>
                                            <LoadingContent>
                                                <MudText>Cargando....</MudText>
                                            </LoadingContent>
                                            <NoRecordsContent>
                                                <MudText>Sin Registros para mostrar</MudText>
                                            </NoRecordsContent>
                                            <PagerContent>
                                                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
                                            </PagerContent>
                                        </MudTable>

                                    </MudGrid>
                                </ChildContent>
                            </MudExpansionPanel>
                        }

                        @if (dtoResultadosEstudios?.Estudios != null)
                        {
                            if (dtoResultadosEstudios.Estudios.Count > 0)
                            {
                                foreach (var item in dtoResultadosEstudios.Estudios)
                                {
                                    <MudExpansionPanel Class="mt-2" Dense="false" Gutters="false" Expanded="true" HideIcon="true">
                                        <TitleContent>
                                            @if (String.IsNullOrEmpty(item.PdfBase64))
                                            {
                                                <div class="d-flex" style="color:#1d2223;">
                                                    @{
                                                        var nombreCaptura = String.IsNullOrEmpty(item.SucursalCaptura) ? "" : $"(Capturado en: {item.SucursalCaptura})";
                                                        var statusColor = GetStatusColor(item.EstatusId);
                                                        var statusIcon = GetStatusIcon(item.EstatusId);
                                                    }
                                                    <MudIcon Icon="@statusIcon"
                                                             Color="@statusColor"
                                                             Size="Size.Medium"
                                                             Class="mr-3" />
                                                    <div>
                                                        <MudText Typo="Typo.subtitle2">
                                                            @item.Clave-<strong>@item.Nombre</strong> @nombreCaptura
                                                        </MudText>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                var nombreCaptura = String.IsNullOrEmpty(item.SucursalCaptura) ? "" : $"(Capturado en: {item.SucursalCaptura})";
                                                <MudGrid>
                                                    <MudItem xs="12">
                                                        <div class="d-flex align-center justify-space-between">
                                                            <div class="d-flex align-center" style="color:#1d2223;">
                                                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                                                         Color="Color.Error"
                                                                         Size="Size.Medium"
                                                                         Class="mr-3" />
                                                                <div>
                                                                    <MudText Typo="Typo.subtitle2">
                                                                        @item.Clave-<strong>@item.Nombre</strong> @nombreCaptura
                                                                    </MudText>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-center">
                                                                <MudChip T="string"
                                                                         StartIcon="@Icons.Material.Filled.CheckCircle"
                                                                         Color="Color.Success"
                                                                         Variant="Variant.Outlined"
                                                                         Size="Size.Small"
                                                                         Class="mr-2">
                                                                    Disponible
                                                                </MudChip>

                                                                <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                                                               Color="Color.Primary"
                                                                               Size="Size.Medium"
                                                                               OnClick="@(() => OpenPdfViewer(item.PdfBase64, $"{item.Clave} - {item.Nombre}"))"
                                                                               Title="Ver en pantalla completa" />

                                                                <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                                               Color="Color.Info"
                                                                               Size="Size.Medium"
                                                                               OnClick="@(() => DownloadPdf(item.PdfBase64, $"{item.Clave}_{item.Nombre}"))"
                                                                               Title="Descargar PDF" />
                                                            </div>
                                                        </div>
                                                    </MudItem>
                                                </MudGrid>
                                            }
                                            
                                        </TitleContent>
                                        <ChildContent>
                                            @if (String.IsNullOrEmpty(item.PdfBase64))
                                            {
                                                <MudGrid Class="d-flex d-sm-none d-none d-sm-flex d-md-none mt-2">
                                                    @foreach (var itemParam in item.Parametros)
                                                    {
                                                        <MudItem xs="3" sm="3" md="3">
                                                            <MudText Align="Align.Start" Typo="Typo.subtitle1">Examen: </MudText>
                                                        </MudItem>
                                                        <MudItem xs="9" sm="9" md="3">
                                                            <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Nombre</MudText>
                                                        </MudItem>
                                                        @if (itemParam.TipoValor == "1")
                                                        {
                                                            var valini = itemParam.ValorInicial == null ? "0" : itemParam.ValorInicial;
                                                            var valFinal = itemParam.ValorFinal == null ? "0" : itemParam.ValorFinal;
                                                            if (!String.IsNullOrEmpty(itemParam.Resultado))
                                                            {
                                                                string ObtengoNum = Regex.Replace(itemParam.Resultado, @"[^0-9.]", "");
                                                                if (double.Parse(ObtengoNum) < double.Parse(valini) || double.Parse(ObtengoNum) > double.Parse(valFinal))
                                                                {
                                                                    <MudItem xs="3" sm="3" md="3">
                                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="9" sm="9" md="3">
                                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1" style="color:red;">@itemParam.Resultado</MudText>
                                                                    </MudItem>
                                                                }
                                                                else
                                                                {
                                                                    <MudItem xs="3" sm="3" md="3">
                                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="9" sm="9" md="3">
                                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                    </MudItem>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <MudItem xs="3" sm="3" md="3">
                                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                </MudItem>
                                                                <MudItem xs="9" sm="9" md="3">
                                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                </MudItem>
                                                            }

                                                        }
                                                        else if (itemParam.TipoValor == "2")
                                                        {
                                                            //var regcoincide = itemParam.TipoValores.FirstOrDefault(e => e.Nombre.Equals((SexoPaciente == "Femenino" ? "mujer" : "hombre")));
                                                            var regcoincide = itemParam.TipoValores[0];
                                                            var valini = SexoPaciente == "Femenino" ? regcoincide.MujerValorInicial != null ? regcoincide.MujerValorInicial : "" : regcoincide.HombreValorInicial != null ? regcoincide.HombreValorInicial : "";
                                                            var valFinal = SexoPaciente == "Femenino" ? regcoincide.MujerValorFinal != null ? regcoincide.MujerValorFinal : "" : regcoincide.HombreValorFinal != null ? regcoincide.HombreValorFinal : "";
                                                            if (!String.IsNullOrEmpty(itemParam.Resultado))
                                                            {
                                                                if (String.IsNullOrEmpty(valini) || String.IsNullOrEmpty(valFinal))
                                                                {
                                                                    <MudItem xs="3" sm="3" md="3">
                                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="9" sm="9" md="3">
                                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                    </MudItem>
                                                                }
                                                                else
                                                                {
                                                                    if (double.Parse(itemParam.Resultado) < double.Parse(valini) || double.Parse(itemParam.Resultado) > double.Parse(valFinal))
                                                                    {
                                                                        <MudItem xs="3" sm="3" md="3">
                                                                            <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                        </MudItem>
                                                                        <MudItem xs="9" sm="9" md="3">
                                                                            <MudText Align="Align.Center" Typo="Typo.subtitle1" style="color:red;">@itemParam.Resultado</MudText>
                                                                        </MudItem>
                                                                    }
                                                                    else
                                                                    {
                                                                        <MudItem xs="3" sm="3" md="3">
                                                                            <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                        </MudItem>
                                                                        <MudItem xs="9" sm="9" md="3">
                                                                            <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                        </MudItem>
                                                                    }
                                                                }

                                                            }
                                                            else
                                                            {
                                                                <MudItem xs="3" sm="3" md="3">
                                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                </MudItem>
                                                                <MudItem xs="9" sm="9" md="3">
                                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                </MudItem>
                                                            }

                                                        }
                                                        else if (itemParam.TipoValor == "3")
                                                        {
                                                            var regcoincideEdad = itemParam.TipoValores.FirstOrDefault(e => EdadPaciente >= e.RangoEdadInicial && EdadPaciente <= e.RangoEdadFinal);
                                                            var valini = regcoincideEdad.ValorInicialNumerico == null ? "0" : regcoincideEdad.ValorInicialNumerico;
                                                            var valFinal = regcoincideEdad.ValorFinalNumerico == null ? "0" : regcoincideEdad.ValorFinalNumerico;
                                                            if (!String.IsNullOrEmpty(itemParam.Resultado))
                                                            {
                                                                if (double.Parse(itemParam.Resultado) < double.Parse(valini) || double.Parse(itemParam.Resultado) > double.Parse(valFinal))
                                                                {
                                                                    <MudItem xs="3" sm="3" md="3">
                                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="9" sm="9" md="3">
                                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1" style="color:red;">@itemParam.Resultado</MudText>
                                                                    </MudItem>
                                                                }
                                                                else
                                                                {
                                                                    <MudItem xs="3" sm="3" md="3">
                                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="9" sm="9" md="3">
                                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                    </MudItem>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <MudItem xs="3" sm="3" md="3">
                                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Resultado:</MudText>
                                                                </MudItem>
                                                                <MudItem xs="9" sm="9" md="3">
                                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                                </MudItem>
                                                            }

                                                        }
                                                        else if (itemParam.TipoValor == "4")
                                                        {
                                                            var regcoincideSexoEdad = itemParam.TipoValores.FirstOrDefault(e => (EdadPaciente >= e.RangoEdadInicial && EdadPaciente <= e.RangoEdadFinal) && e.Nombre.Equals((SexoPaciente == "Femenino" ? "mujer" : "hombre")));
                                                            var valini = regcoincideSexoEdad.ValorInicialNumerico == null ? "0" : regcoincideSexoEdad.ValorInicialNumerico;
                                                            var valFinal = regcoincideSexoEdad.ValorFinalNumerico == null ? "0" : regcoincideSexoEdad.ValorFinalNumerico;
