                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.Resultado</MudText>
                                                </MudItem>
                                            }

                                            <MudItem xs="3" sm="3" md="3">
                                                <MudText Align="Align.Start" Typo="Typo.subtitle1">Unidades: </MudText>
                                            </MudItem>
                                            <MudItem xs="9" sm="9" md="3">
                                                <MudText Align="Align.Center" Typo="Typo.subtitle1">@itemParam.UnidadNombre</MudText>
                                            </MudItem>
                                            @if (itemParam.TipoValor == "1")
                                            {
                                                var valini = itemParam.ValorInicial == null ? "" : itemParam.ValorInicial;
                                                var valFinal = itemParam.ValorFinal == null ? "" : itemParam.ValorFinal;
                                                <MudItem xs="3" sm="3" md="3">
                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
