                                                                            }
                                                                            @if (context.SegundaColumna != null)
                                                                            {
                                                                                <MudTd DataLabel="" Style="font-weight:bolder">@context.SegundaColumna</MudTd>
                                                                            }
                                                                            @if (context.TerceraColumna != null)
                                                                            {
                                                                                <MudTd DataLabel="" Style="font-weight:bolder">@context.TerceraColumna</MudTd>
                                                                            }
                                                                            @if (context.CuartaColumna != null)
                                                                            {
                                                                                <MudTd DataLabel="" Style="font-weight:bolder">@context.CuartaColumna</MudTd>
                                                                            }
                                                                            @if (context.QuintaColumna != null)
                                                                            {
