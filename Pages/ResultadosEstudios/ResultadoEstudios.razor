    async Task ImprimirExp()
    {
        ValidateDataMod = true;
        if (selectedItems.Count == 0)
        {
            ShowSnack("¡Por favor selecciona estudios!", 3);
            ValidateDataMod = false;
        }
        else
        {

            var archivopdf = await _PdfGenerator.CreatePDF(_config, IJSRuntime, Http, selectedItems.ToList());
            _PdfGenerator.DownloadPDF(IJSRuntime, archivopdf);
            
            Http.DefaultRequestHeaders.Remove("branchid");
            Http.DefaultRequestHeaders.Add("branchid", Sucursal);
            //StateHasChanged();
        }
        ValidateDataMod = false;
    }

    async Task ImprimirExpGral(DtoResponseMedicoPaciente itemSolicitud)
    {
        try
        {
            var archivopdf = await _PdfGenerator.CreatePDF(_config, IJSRuntime, Http, itemSolicitud.Estudios);
            _PdfGenerator.ViewPDFInNewTab(IJSRuntime, archivopdf);

