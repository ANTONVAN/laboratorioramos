    /// <summary>
    /// Abre el visor de PDF en pantalla completa
    /// </summary>
    private void OpenPdfViewer(string pdfBase64, string title)
    {
        var parameters = new DialogParameters
        {
            { "PdfBase64", pdfBase64 },
            { "Title", title }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true,
            FullScreen = true,
            CloseButton = true
        };

        DialogService.Show<PdfViewerDialog>("Visor de PDF", parameters, options);
    }

    /// <summary>
    /// Descarga el PDF como archivo
    /// </summary>
    private async Task DownloadPdf(string pdfBase64, string fileName)
    {
        try
        {
            var bytes = Convert.FromBase64String(pdfBase64);
            var fileNameWithExtension = $"{fileName}.pdf";

            await IJSRuntime.InvokeVoidAsync("downloadFileFromStream",
                fileNameWithExtension,
                Convert.ToBase64String(bytes));

            ShowSnack($"Descarga iniciada: {fileNameWithExtension}", Severity.Success);
        }
        catch (Exception ex)
        {
            ShowSnack($"Error al descargar el archivo: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Muestra notificación al usuario
    /// </summary>
    private void ShowSnack(string message, Severity severity)
    {
        Snackbar.Add(message, severity);
    }

