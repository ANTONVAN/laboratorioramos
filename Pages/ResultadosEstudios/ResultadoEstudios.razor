                                            {
                                                if (itemParam.TipoValores.Count > 0)
                                                {
                                                    var regcoincidePrimero = itemParam.TipoValores[0];
                                                    var ValOpcion = regcoincidePrimero.Opcion == null ? "" : regcoincidePrimero.Opcion;
                                                    <MudItem xs="3" sm="3" md="3">
                                                        <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
                                                    </MudItem>
                                                    <MudItem xs="9" sm="9" md="3">
