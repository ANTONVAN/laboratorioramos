                                                        if (!String.IsNullOrEmpty(itemParam.Resultado))
                                                        {
                                                            string ObtengoNum = Regex.Replace(itemParam.Resultado, @"[^0-9.]", "");
                                                            if (double.Parse(ObtengoNum) < double.Parse(valini) || double.Parse(ObtengoNum) > double.Parse(valFinal))
                                                            {
                                                                <MudItem xs="3" sm="3" md="3">
