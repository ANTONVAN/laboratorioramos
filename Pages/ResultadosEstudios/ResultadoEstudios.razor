            <MudLink OnClick="NavigationInicio" Underline="Underline.Always"><MudIconButton Icon="@Icons.Material.Filled.ArrowCircleLeft" aria-label="Atras" Color="Color.Dark"></MudIconButton> </MudLink>
        </MudItem> *@
    <MudItem xs="12" sm="12" md="12">
        <MudText Align="Align.Center" Typo="Typo.h4" style="color: #0d37a8;">Resultados</MudText>
    </MudItem>
</MudGrid>

@if (dataLoaded)
{
    <MudGrid>
        <MudItem xs="12" sm="12" md="12" Style="text-align:center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        </MudItem>
    </MudGrid>

}
else
{
    <MudPaper Class="pa-4" Elevation="4" Style="width:100%;">
        <MudGrid>
            <MudItem xs="12" sm="12" md="12" Style="padding-top: 12px;">
                <MudText Align="Align.Left" Typo="Typo.h6" style="color: #66686c;"><b style="color: #0d37a8;">Solicitud: @LstExpedientes[0].Solicitud</b>&nbsp;&nbsp;<b style="font-size:small;">Registro: @LstExpedientes[0].Registro</b></MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Style="padding-top: 0px;">
                <MudText Align="Align.Left" Typo="Typo.subtitle1">
                    @{
                        if (LstExpedientes[0].Sexo == "Masculino")
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Man2" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Woman2" Color="Color.Secondary" />
                        }
                    }
                    &nbsp;<b>@LstExpedientes[0].Nombre</b>

                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="1" Style="padding-top: 0px;">
                <MudText Align="Align.Center" Typo="Typo.subtitle2">
                    <b>@LstExpedientes[0].Edad&nbsp;años</b>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Style="padding-top: 0px;">
