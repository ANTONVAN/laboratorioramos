                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
                                                </MudItem>
                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@valini - @valFinal</MudText>
                                                </MudItem>
                                            }
                                            else if (itemParam.TipoValor == "3")
                                            {
                                                var regcoincideEdad = itemParam.TipoValores.FirstOrDefault(e => EdadPaciente >= e.RangoEdadInicial && EdadPaciente <= e.RangoEdadFinal);
                                                var valini = regcoincideEdad.ValorInicialNumerico == null ? "" : regcoincideEdad.ValorInicialNumerico;
                                                var valFinal = regcoincideEdad.ValorFinalNumerico == null ? "" : regcoincideEdad.ValorFinalNumerico;
                                                <MudItem xs="3" sm="3" md="3">
                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
                                                </MudItem>
                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@valini - @valFinal</MudText>
                                                </MudItem>
                                            }
                                            else if (itemParam.TipoValor == "4")
                                            {
                                                var regcoincideSexoEdad = itemParam.TipoValores.FirstOrDefault(e => (EdadPaciente >= e.RangoEdadInicial && EdadPaciente <= e.RangoEdadFinal) && e.Nombre.Equals((SexoPaciente == "Femenino" ? "mujer" : "hombre")));
                                                var valini = regcoincideSexoEdad.ValorInicialNumerico == null ? "" : regcoincideSexoEdad.ValorInicialNumerico;
                                                var valFinal = regcoincideSexoEdad.ValorFinalNumerico == null ? "" : regcoincideSexoEdad.ValorFinalNumerico;
                                                <MudItem xs="3" sm="3" md="3">
                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
                                                </MudItem>
                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@valini - @valFinal</MudText>
