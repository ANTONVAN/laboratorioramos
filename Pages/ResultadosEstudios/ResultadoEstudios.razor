@if (dataLoaded)
{
    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 300px; padding: 3rem;">
        <MudProgressCircular Indeterminate="true"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-4" />
        <MudText Typo="Typo.h6" Style="color: #0d37a8; font-weight: 500;" Class="mb-2">
            Cargando Resultados...
        </MudText>
