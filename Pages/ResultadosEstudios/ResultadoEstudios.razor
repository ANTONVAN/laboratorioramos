                                                     Size="Size.Large"
                                                     Class="mb-4"
                                                     Style="font-size: 4rem; opacity: 0.7;" />

                                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2" Align="Align.Center">
                                                Los Resultados de sus estudios siguen en proceso
                                            </MudText>

                                            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-3" Align="Align.Center">
