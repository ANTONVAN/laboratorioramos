                                                    </MudItem>
                                                    <MudItem xs="9" sm="9" md="3">
                                                        <MudText Align="Align.Center" Typo="Typo.subtitle1">&nbsp;</MudText>
                                                    </MudItem>
                                                }

                                            }
                                            else if (itemParam.TipoValor == "9")
                                            {
                                                <MudItem xs="3" sm="3" md="3">
                                                    <MudText Align="Align.Start" Typo="Typo.subtitle1">Referencia: </MudText>
                                                </MudItem>
                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">&nbsp;</MudText>
