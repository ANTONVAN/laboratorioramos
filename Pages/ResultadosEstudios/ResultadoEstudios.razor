                                                Recibirá una notificación cuando sus resultados estén listos
                                            </MudText>
                                        </MudContainer>
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        }
                        else
                        {
                            <!-- Mensaje cuando dtoResultadosEstudios.Estudios es null -->
                            <MudExpansionPanel Class="mt-2" Dense="false" Gutters="false" Expanded="true" HideIcon="true">
                                <TitleContent>
                                    <div class="d-flex align-center" style="color:#1d2223;">
                                        <MudText Align="Align.Justify" Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Color="Color.Info" />
                                            <strong>Estado de Estudios</strong>
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px; padding: 2rem;">
                                        <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty"
                                                 Color="Color.Warning"
                                                 Size="Size.Large"
                                                 Class="mb-4"
                                                 Style="font-size: 4rem; opacity: 0.7;" />

                                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2" Align="Align.Center">
                                            Los Resultados de sus estudios siguen en proceso
                                        </MudText>

                                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-3" Align="Align.Center">
                                            Nuestro equipo médico está trabajando en el análisis de sus muestras.
                                            Los resultados estarán disponibles pronto.
                                        </MudText>

                                        <MudChip T="string"
                                                 StartIcon="@Icons.Material.Filled.AccessTime"
                                                 Color="Color.Info"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Medium"
                                                 Class="mt-2">
                                            En Proceso
                                        </MudChip>

                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3" Align="Align.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" Size="Size.Small" />
                                            Recibirá una notificación cuando sus resultados estén listos
                                        </MudText>
                                    </MudContainer>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

}

