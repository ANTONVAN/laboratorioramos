                                                <MudItem xs="9" sm="9" md="3">
                                                    <MudText Align="Align.Center" Typo="Typo.subtitle1">@valini - @valFinal</MudText>
                                                </MudItem>

                                            }
                                            else if (itemParam.TipoValor == "2")
                                            {
                                                //var regcoincide = itemParam.TipoValores.FirstOrDefault(e => e.Nombre.Equals((SexoPaciente == "Femenino" ? "mujer" : "hombre")));
                                                var regcoincide = itemParam.TipoValores[0];
                                                var valini = SexoPaciente == "Femenino" ? regcoincide.MujerValorInicial : regcoincide.HombreValorInicial;
                                                var valFinal = SexoPaciente == "Femenino" ? regcoincide.MujerValorFinal : regcoincide.HombreValorFinal;
