    private bool FilterFuncEstudios(DtoResponseMedicoPacienteStudios element) => FilterFuncExp(element, searchEstudios);
    private bool FilterFuncExp(DtoResponseMedicoPacienteStudios element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Estudio.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.FechaEntrega.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }


    #region Helpers
    /// <summary>
    /// Obtiene el color apropiado según el estatus del estudio
    /// </summary>
    private Color GetStatusColor(int? estatusId)
    {
        return estatusId switch
        {
            6 => Color.Success,    // Completado
            7 => Color.Success,    // Liberado
            12 => Color.Warning,   // En proceso
            _ => Color.Default
        };
    }

    /// <summary>
    /// Obtiene el ícono apropiado según el estatus del estudio
    /// </summary>
    private string GetStatusIcon(int? estatusId)
    {
        return estatusId switch
        {
            6 => Icons.Material.Filled.CheckCircle,      // Completado
            7 => Icons.Material.Filled.Verified,         // Liberado
            12 => Icons.Material.Filled.HourglassEmpty,  // En proceso
            _ => Icons.Material.Filled.PlaylistAdd
        };
    }

